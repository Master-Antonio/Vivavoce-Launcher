import { Theme } from "../theme.slint";
import { ScrollView } from "std-widgets.slint";
import { PrimaryButton, SecondaryButton } from "buttons.slint";

export struct DialogueEntry {
    sound-file: string,
    quest-id: int,
    npc-name: string,
    timestamp: string,
    text: string,
}

export component BugCard inherits Rectangle {
    // Shared properties
    in-out property <[DialogueEntry]> recent-dialogues: [];
    in-out property <int> report-type: 0; // 0 = Audio / Doppiaggio, 1 = AddOn / Tecnico
    in-out property <string> submit-status-text: "";
    in-out property <string> last-created-issue-url: "";
    in-out property <bool> has-github-token: false;

    // Audio properties
    in-out property <int> selected-dialogue-index: -1;
    in-out property <int> selected-audio-category: 0;
    in-out property <string> audio-description: "";
    in-out property <string> manual-sound-file: "";

    // AddOn properties
    in-out property <int> selected-addon-category: 0;
    in-out property <string> addon-title: "";
    in-out property <string> addon-description: "";
    in-out property <string> addon-repro-steps: "";

    // Callbacks
    callback create-github-issue(int /* type: 0=audio, 1=addon */, string /* category */, string /* title */, string /* description */, string /* extra_data */);
    callback export-report-md(int /* type */, string /* category */, string /* title */, string /* description */, string /* extra_data */);
    callback open-issue-url(string /* url */);

    // Categories
    private property <[string]> audio-categories: [
        "Pronuncia ed enfasi",
        "Volume o qualità",
        "Audio tagliato o glitch",
        "Testo non corrispondente",
        "Altro su audio"
    ];

    private property <[string]> addon-categories: [
        "Errore Lua in gioco",
        "Installazione / Moduli",
        "Rilevamento Client WoW",
        "Interfaccia / Opzioni AddOn",
        "Crash o blocco del gioco",
        "Altro problema tecnico"
    ];

    // Current category labels
    private property <string> current-audio-category: root.audio-categories[root.selected-audio-category];
    private property <string> current-addon-category: root.addon-categories[root.selected-addon-category];

    // Selected sound file
    private property <string> current-sound-file:
        (root.selected-dialogue-index >= 0 && root.selected-dialogue-index < root.recent-dialogues.length) ?
            root.recent-dialogues[root.selected-dialogue-index].sound-file :
            root.manual-sound-file;

    // Selected dialogue title
    private property <string> current-dialogue-title:
        (root.selected-dialogue-index >= 0 && root.selected-dialogue-index < root.recent-dialogues.length) ?
            root.recent-dialogues[root.selected-dialogue-index].npc-name :
            "Segnalazione Audio";

    background: Theme.bg-panel;
    border-radius: Theme.radius-lg;
    border-width: 1px;
    border-color: Theme.border-normal;
    clip: true;

    VerticalLayout {
        padding: 18px;
        spacing: 14px;
        alignment: start;

        // =====================================================================
        // HEADER: MODE SELECTOR (Emil Kowalski Segmented Control)
        // =====================================================================
        HorizontalLayout {
            alignment: space-between;

            // Segmented Pill Control for Audio vs AddOn
            Rectangle {
                height: 40px;
                border-radius: Theme.radius-md;
                background: #0d111a;
                border-width: 1px;
                border-color: Theme.border-subtle;

                HorizontalLayout {
                    padding: 3px;
                    spacing: 6px;

                    // Button: Audio
                    Rectangle {
                        width: 220px;
                        height: 32px;
                        border-radius: Theme.radius-sm;
                        background: root.report-type == 0 ? #1c2638 : (audio-tab-touch.has-hover ? #141b28 : transparent);
                        border-width: 1px;
                        border-color: root.report-type == 0 ? Theme.border-gold-normal : transparent;

                        animate background { duration: Theme.transition-fast; easing: ease-out; }
                        animate border-color { duration: Theme.transition-fast; easing: ease-out; }

                        audio-tab-touch := TouchArea {
                            mouse-cursor: pointer;
                            clicked => { root.report-type = 0; }
                        }

                        HorizontalLayout {
                            alignment: center;
                            spacing: 8px;

                            VerticalLayout {
                                alignment: center;
                                Image {
                                    width: 15px;
                                    height: 15px;
                                    source: @image-url("../assets/icons/headphones.svg");
                                    colorize: root.report-type == 0 ? Theme.gold-light : #8a94a6;
                                    image-fit: contain;
                                }
                            }

                            VerticalLayout {
                                alignment: center;
                                Text {
                                    text: "Problema Audio / Voci";
                                    color: root.report-type == 0 ? Theme.text-primary : #949db0;
                                    font-size: 13px;
                                    font-weight: root.report-type == 0 ? 600 : 400;
                                }
                            }
                        }
                    }

                    // Button: AddOn / Tecnico
                    Rectangle {
                        width: 220px;
                        height: 32px;
                        border-radius: Theme.radius-sm;
                        background: root.report-type == 1 ? #1c2638 : (addon-tab-touch.has-hover ? #141b28 : transparent);
                        border-width: 1px;
                        border-color: root.report-type == 1 ? Theme.border-gold-normal : transparent;

                        animate background { duration: Theme.transition-fast; easing: ease-out; }
                        animate border-color { duration: Theme.transition-fast; easing: ease-out; }

                        addon-tab-touch := TouchArea {
                            mouse-cursor: pointer;
                            clicked => { root.report-type = 1; }
                        }

                        HorizontalLayout {
                            alignment: center;
                            spacing: 8px;

                            VerticalLayout {
                                alignment: center;
                                Image {
                                    width: 15px;
                                    height: 15px;
                                    source: @image-url("../assets/icons/wrench.svg");
                                    colorize: root.report-type == 1 ? Theme.gold-light : #8a94a6;
                                    image-fit: contain;
                                }
                            }

                            VerticalLayout {
                                alignment: center;
                                Text {
                                    text: "Problema AddOn / Tecnico";
                                    color: root.report-type == 1 ? Theme.text-primary : #949db0;
                                    font-size: 13px;
                                    font-weight: root.report-type == 1 ? 600 : 400;
                                }
                            }
                        }
                    }
                }
            }
        }

        // Subtitle Description
        Text {
            text: root.report-type == 0 ?
                "Segnala errori di pronuncia, battute tagliate, volume non bilanciato o discrepanze tra audio recitato e sottotitoli." :
                "Segnala errori Lua di gioco, anomalie nei menu o impostazioni, problemi nel download dei pacchetti o crash.";
            color: Theme.text-secondary;
            font-size: 13px;
        }

        // =====================================================================
        // MODE 0: SEGNALAZIONE AUDIO
        // =====================================================================
        if (root.report-type == 0) : VerticalLayout {
            spacing: 12px;
            alignment: start;

            // Section 1: Dialoghi Recenti
            VerticalLayout {
                spacing: 6px;

                Text {
                    text: "Dialoghi recenti registrati in WoW Forever";
                    color: Theme.text-primary;
                    font-size: 13px;
                    font-weight: 600;
                }

                Rectangle {
                    height: root.recent-dialogues.length == 0 ? 84px : 124px;
                    background: Theme.bg-inset;
                    border-radius: Theme.radius-md;
                    border-width: 1px;
                    border-color: Theme.border-subtle;
                    clip: true;

                    // Empty state
                    if (root.recent-dialogues.length == 0) : Rectangle {
                        HorizontalLayout {
                            padding-left: 18px;
                            padding-right: 18px;
                            alignment: start;
                            spacing: 14px;

                            VerticalLayout {
                                alignment: center;
                                Rectangle {
                                    width: 38px;
                                    height: 38px;
                                    border-radius: Theme.radius-sm;
                                    background: #121622;
                                    border-width: 1px;
                                    border-color: Theme.border-subtle;

                                    Image {
                                        width: 18px;
                                        height: 18px;
                                        x: (parent.width - self.width) / 2;
                                        y: (parent.height - self.height) / 2;
                                        source: @image-url("../assets/icons/headphones.svg");
                                        colorize: Theme.gold-primary;
                                        image-fit: contain;
                                    }
                                }
                            }

                            VerticalLayout {
                                alignment: center;
                                spacing: 3px;

                                Text {
                                    text: "Nessun dialogo recente in memoria";
                                    color: Theme.text-primary;
                                    font-size: 13px;
                                    font-weight: 500;
                                }
                                Text {
                                    text: "Avvia WoW Forever con VivaVoce per registrare i dialoghi ascoltati, oppure descrivi l'anomalia sotto.";
                                    color: Theme.text-muted;
                                    font-size: 12px;
                                }
                            }
                        }
                    }

                    // Populated dialogues
                    if (root.recent-dialogues.length > 0) : ScrollView {
                        VerticalLayout {
                            spacing: 4px;
                            padding: 6px;

                            for item[idx] in root.recent-dialogues : Rectangle {
                                height: 54px;
                                background: root.selected-dialogue-index == idx ? Theme.bg-card-selected : (row-touch.has-hover ? Theme.bg-card-hover : Theme.bg-card);
                                border-width: 1px;
                                border-color: root.selected-dialogue-index == idx ? Theme.border-gold-normal : Theme.border-subtle;
                                border-radius: Theme.radius-sm;

                                animate background { duration: Theme.transition-fast; easing: ease-out; }
                                animate border-color { duration: Theme.transition-fast; easing: ease-out; }

                                row-touch := TouchArea {
                                    mouse-cursor: pointer;
                                    clicked => { root.selected-dialogue-index = idx; }
                                }

                                HorizontalLayout {
                                    padding-left: 12px;
                                    padding-right: 12px;
                                    alignment: space-between;

                                    VerticalLayout {
                                        spacing: 2px;
                                        alignment: center;

                                        HorizontalLayout {
                                            spacing: 7px;

                                            Rectangle {
                                                height: 20px;
                                                background: #c89b3c18;
                                                border-radius: Theme.radius-xs;
                                                border-width: 1px;
                                                border-color: #c89b3c33;

                                                HorizontalLayout {
                                                    padding-left: 7px;
                                                    padding-right: 7px;
                                                    alignment: center;
                                                    Text {
                                                        text: item.npc-name != "" ? item.npc-name : "NPC sconosciuto";
                                                        color: Theme.gold-light;
                                                        font-size: 11px;
                                                        font-weight: 500;
                                                        vertical-alignment: center;
                                                    }
                                                }
                                            }

                                            if (item.quest-id > 0) : Rectangle {
                                                height: 20px;
                                                background: #38bdf814;
                                                border-radius: Theme.radius-xs;
                                                border-width: 1px;
                                                border-color: #38bdf833;

                                                HorizontalLayout {
                                                    padding-left: 7px;
                                                    padding-right: 7px;
                                                    alignment: center;
                                                    Text {
                                                        text: "Quest #" + item.quest-id;
                                                        color: Theme.status-info;
                                                        font-size: 11px;
                                                        font-weight: 500;
                                                        vertical-alignment: center;
                                                    }
                                                }
                                            }

                                            Text {
                                                text: item.sound-file;
                                                color: Theme.text-secondary;
                                                font-size: 11px;
                                                vertical-alignment: center;
                                            }
                                        }

                                        Text {
                                            text: "\"" + item.text + "\"";
                                            color: Theme.text-primary;
                                            font-size: 12px;
                                            overflow: elide;
                                            max-width: 580px;
                                        }
                                    }

                                    VerticalLayout {
                                        alignment: center;
                                        spacing: 4px;

                                        Text {
                                            text: item.timestamp;
                                            color: Theme.text-muted;
                                            font-size: 11px;
                                            horizontal-alignment: right;
                                        }

                                        Rectangle {
                                            width: 82px;
                                            height: 22px;
                                            border-radius: Theme.radius-xs;
                                            background: root.selected-dialogue-index == idx ? Theme.btn-primary-bg : transparent;
                                            border-width: 1px;
                                            border-color: root.selected-dialogue-index == idx ? Theme.btn-primary-bg : Theme.border-normal;

                                            Text {
                                                text: root.selected-dialogue-index == idx ? "Selezionato" : "Seleziona";
                                                color: root.selected-dialogue-index == idx ? Theme.btn-primary-text : Theme.text-secondary;
                                                font-size: 11px;
                                                font-weight: 500;
                                                horizontal-alignment: center;
                                                vertical-alignment: center;
                                            }
                                        }
                                    }
                                }
                            }
                        }
                    }
                }
            }

            // Section 2: Audio Category Pills
            VerticalLayout {
                spacing: 6px;

                Text {
                    text: "Categoria problema audio";
                    color: Theme.text-primary;
                    font-size: 13px;
                    font-weight: 600;
                }

                HorizontalLayout {
                    spacing: 8px;

                    for cat-name[c-idx] in root.audio-categories : Rectangle {
                        height: 32px;
                        border-radius: Theme.radius-pill;
                        background: root.selected-audio-category == c-idx ? #c89b3c22 : (pill-touch.has-hover ? #182030 : Theme.bg-card);
                        border-width: 1px;
                        border-color: root.selected-audio-category == c-idx ? Theme.border-gold-normal : Theme.border-normal;

                        animate background { duration: Theme.transition-fast; easing: ease-out; }
                        animate border-color { duration: Theme.transition-fast; easing: ease-out; }

                        pill-touch := TouchArea {
                            mouse-cursor: pointer;
                            clicked => { root.selected-audio-category = c-idx; }
                        }

                        HorizontalLayout {
                            padding-left: 14px;
                            padding-right: 14px;
                            alignment: center;
                            Text {
                                text: cat-name;
                                color: root.selected-audio-category == c-idx ? Theme.gold-light : (pill-touch.has-hover ? Theme.text-primary : Theme.text-secondary);
                                font-size: 12px;
                                font-weight: root.selected-audio-category == c-idx ? 600 : 400;
                                vertical-alignment: center;
                            }
                        }
                    }
                }
            }

            // Section 3: Audio Description
            VerticalLayout {
                spacing: 6px;

                Text {
                    text: "Dettagli anomalia o suggerimento";
                    color: Theme.text-primary;
                    font-size: 13px;
                    font-weight: 600;
                }

                Rectangle {
                    height: 76px;
                    background: Theme.bg-input;
                    border-radius: Theme.radius-md;
                    border-width: 1px;
                    border-color: audio-desc-input.has-focus ? Theme.border-gold-normal : Theme.border-normal;

                    animate border-color { duration: Theme.transition-fast; easing: ease-out; }

                    VerticalLayout {
                        padding: 10px;
                        audio-desc-input := TextInput {
                            text <=> root.audio-description;
                            color: Theme.text-primary;
                            font-size: 13px;
                            single-line: false;
                            wrap: word-wrap;
                        }
                    }

                    if (root.audio-description == "") : Text {
                        x: 12px;
                        y: 11px;
                        text: "Descrivi l'anomalia (es: accento errato sulla parola 'Ironforge', audio interrotto a metà frase...)";
                        color: Theme.text-muted;
                        font-size: 12px;
                    }
                }
            }
        }

        // =====================================================================
        // MODE 1: SEGNALAZIONE ADDON / TECNICO
        // =====================================================================
        if (root.report-type == 1) : VerticalLayout {
            spacing: 12px;
            alignment: start;

            // Section 1: AddOn Category Pills
            VerticalLayout {
                spacing: 6px;

                Text {
                    text: "Categoria del problema tecnico";
                    color: Theme.text-primary;
                    font-size: 13px;
                    font-weight: 600;
                }

                VerticalLayout {
                    spacing: 8px;

                    // Row 1: 3 pills
                    HorizontalLayout {
                        spacing: 8px;
                        alignment: start;

                        Rectangle {
                            height: 32px;
                            border-radius: Theme.radius-pill;
                            background: root.selected-addon-category == 0 ? #c89b3c22 : (ap0.has-hover ? #182030 : Theme.bg-card);
                            border-width: 1px;
                            border-color: root.selected-addon-category == 0 ? Theme.border-gold-normal : Theme.border-normal;
                            animate background { duration: Theme.transition-fast; easing: ease-out; }
                            animate border-color { duration: Theme.transition-fast; easing: ease-out; }
                            ap0 := TouchArea { mouse-cursor: pointer; clicked => { root.selected-addon-category = 0; } }
                            HorizontalLayout {
                                padding-left: 14px; padding-right: 14px; alignment: center;
                                Text { text: "Errore Lua in gioco"; color: root.selected-addon-category == 0 ? Theme.gold-light : (ap0.has-hover ? Theme.text-primary : Theme.text-secondary); font-size: 12px; font-weight: root.selected-addon-category == 0 ? 600 : 400; vertical-alignment: center; }
                            }
                        }

                        Rectangle {
                            height: 32px;
                            border-radius: Theme.radius-pill;
                            background: root.selected-addon-category == 1 ? #c89b3c22 : (ap1.has-hover ? #182030 : Theme.bg-card);
                            border-width: 1px;
                            border-color: root.selected-addon-category == 1 ? Theme.border-gold-normal : Theme.border-normal;
                            animate background { duration: Theme.transition-fast; easing: ease-out; }
                            animate border-color { duration: Theme.transition-fast; easing: ease-out; }
                            ap1 := TouchArea { mouse-cursor: pointer; clicked => { root.selected-addon-category = 1; } }
                            HorizontalLayout {
                                padding-left: 14px; padding-right: 14px; alignment: center;
                                Text { text: "Installazione / Moduli"; color: root.selected-addon-category == 1 ? Theme.gold-light : (ap1.has-hover ? Theme.text-primary : Theme.text-secondary); font-size: 12px; font-weight: root.selected-addon-category == 1 ? 600 : 400; vertical-alignment: center; }
                            }
                        }

                        Rectangle {
                            height: 32px;
                            border-radius: Theme.radius-pill;
                            background: root.selected-addon-category == 2 ? #c89b3c22 : (ap2.has-hover ? #182030 : Theme.bg-card);
                            border-width: 1px;
                            border-color: root.selected-addon-category == 2 ? Theme.border-gold-normal : Theme.border-normal;
                            animate background { duration: Theme.transition-fast; easing: ease-out; }
                            animate border-color { duration: Theme.transition-fast; easing: ease-out; }
                            ap2 := TouchArea { mouse-cursor: pointer; clicked => { root.selected-addon-category = 2; } }
                            HorizontalLayout {
                                padding-left: 14px; padding-right: 14px; alignment: center;
                                Text { text: "Rilevamento Client WoW"; color: root.selected-addon-category == 2 ? Theme.gold-light : (ap2.has-hover ? Theme.text-primary : Theme.text-secondary); font-size: 12px; font-weight: root.selected-addon-category == 2 ? 600 : 400; vertical-alignment: center; }
                            }
                        }
                    }

                    // Row 2: 3 pills
                    HorizontalLayout {
                        spacing: 8px;
                        alignment: start;

                        Rectangle {
                            height: 32px;
                            border-radius: Theme.radius-pill;
                            background: root.selected-addon-category == 3 ? #c89b3c22 : (ap3.has-hover ? #182030 : Theme.bg-card);
                            border-width: 1px;
                            border-color: root.selected-addon-category == 3 ? Theme.border-gold-normal : Theme.border-normal;
                            animate background { duration: Theme.transition-fast; easing: ease-out; }
                            animate border-color { duration: Theme.transition-fast; easing: ease-out; }
                            ap3 := TouchArea { mouse-cursor: pointer; clicked => { root.selected-addon-category = 3; } }
                            HorizontalLayout {
                                padding-left: 14px; padding-right: 14px; alignment: center;
                                Text { text: "Interfaccia / Opzioni AddOn"; color: root.selected-addon-category == 3 ? Theme.gold-light : (ap3.has-hover ? Theme.text-primary : Theme.text-secondary); font-size: 12px; font-weight: root.selected-addon-category == 3 ? 600 : 400; vertical-alignment: center; }
                            }
                        }

                        Rectangle {
                            height: 32px;
                            border-radius: Theme.radius-pill;
                            background: root.selected-addon-category == 4 ? #c89b3c22 : (ap4.has-hover ? #182030 : Theme.bg-card);
                            border-width: 1px;
                            border-color: root.selected-addon-category == 4 ? Theme.border-gold-normal : Theme.border-normal;
                            animate background { duration: Theme.transition-fast; easing: ease-out; }
                            animate border-color { duration: Theme.transition-fast; easing: ease-out; }
                            ap4 := TouchArea { mouse-cursor: pointer; clicked => { root.selected-addon-category = 4; } }
                            HorizontalLayout {
                                padding-left: 14px; padding-right: 14px; alignment: center;
                                Text { text: "Crash o blocco del gioco"; color: root.selected-addon-category == 4 ? Theme.gold-light : (ap4.has-hover ? Theme.text-primary : Theme.text-secondary); font-size: 12px; font-weight: root.selected-addon-category == 4 ? 600 : 400; vertical-alignment: center; }
                            }
                        }

                        Rectangle {
                            height: 32px;
                            border-radius: Theme.radius-pill;
                            background: root.selected-addon-category == 5 ? #c89b3c22 : (ap5.has-hover ? #182030 : Theme.bg-card);
                            border-width: 1px;
                            border-color: root.selected-addon-category == 5 ? Theme.border-gold-normal : Theme.border-normal;
                            animate background { duration: Theme.transition-fast; easing: ease-out; }
                            animate border-color { duration: Theme.transition-fast; easing: ease-out; }
                            ap5 := TouchArea { mouse-cursor: pointer; clicked => { root.selected-addon-category = 5; } }
                            HorizontalLayout {
                                padding-left: 14px; padding-right: 14px; alignment: center;
                                Text { text: "Altro problema"; color: root.selected-addon-category == 5 ? Theme.gold-light : (ap5.has-hover ? Theme.text-primary : Theme.text-secondary); font-size: 12px; font-weight: root.selected-addon-category == 5 ? 600 : 400; vertical-alignment: center; }
                            }
                        }
                    }
                }
            }

            // Section 2: Titolo o Sintesi AddOn
            VerticalLayout {
                spacing: 6px;

                Text {
                    text: "Sintesi o titolo del problema";
                    color: Theme.text-primary;
                    font-size: 13px;
                    font-weight: 600;
                }

                Rectangle {
                    height: 38px;
                    background: Theme.bg-input;
                    border-radius: Theme.radius-sm;
                    border-width: 1px;
                    border-color: addon-title-input.has-focus ? Theme.border-gold-normal : Theme.border-normal;

                    animate border-color { duration: Theme.transition-fast; easing: ease-out; }

                    HorizontalLayout {
                        padding-left: 12px;
                        padding-right: 12px;
                        alignment: center;

                        addon-title-input := TextInput {
                            text <=> root.addon-title;
                            color: Theme.text-primary;
                            font-size: 13px;
                            single-line: true;
                            vertical-alignment: center;
                        }
                    }

                    if (root.addon-title == "") : Text {
                        x: 12px;
                        y: 11px;
                        text: "es: Errore Lua all'apertura del quest log di Ironforge";
                        color: Theme.text-muted;
                        font-size: 12px;
                    }
                }
            }

            // Section 3: Errore Lua / Descrizione
            VerticalLayout {
                spacing: 6px;

                Text {
                    text: "Messaggio di errore Lua o comportamento anomalo";
                    color: Theme.text-primary;
                    font-size: 13px;
                    font-weight: 600;
                }

                Rectangle {
                    height: 80px;
                    background: Theme.bg-input;
                    border-radius: Theme.radius-md;
                    border-width: 1px;
                    border-color: addon-desc-input.has-focus ? Theme.border-gold-normal : Theme.border-normal;

                    animate border-color { duration: Theme.transition-fast; easing: ease-out; }

                    VerticalLayout {
                        padding: 10px;
                        addon-desc-input := TextInput {
                            text <=> root.addon-description;
                            color: Theme.text-primary;
                            font-size: 12px;
                            single-line: false;
                            wrap: word-wrap;
                        }
                    }

                    if (root.addon-description == "") : Text {
                        x: 12px;
                        y: 11px;
                        text: "Incolla qui l'errore Lua (Interface/AddOns/VivaVoce...) oppure descrivi il malfunzionamento";
                        color: Theme.text-muted;
                        font-size: 12px;
                    }
                }
            }

            // Section 4: Passaggi per riprodurre (opzionale)
            VerticalLayout {
                spacing: 6px;

                Text {
                    text: "Passaggi per riprodurre (opzionale)";
                    color: Theme.text-primary;
                    font-size: 13px;
                    font-weight: 600;
                }

                Rectangle {
                    height: 38px;
                    background: Theme.bg-input;
                    border-radius: Theme.radius-sm;
                    border-width: 1px;
                    border-color: repro-input.has-focus ? Theme.border-gold-normal : Theme.border-normal;

                    animate border-color { duration: Theme.transition-fast; easing: ease-out; }

                    HorizontalLayout {
                        padding-left: 12px;
                        padding-right: 12px;
                        alignment: center;

                        repro-input := TextInput {
                            text <=> root.addon-repro-steps;
                            color: Theme.text-primary;
                            font-size: 13px;
                            single-line: true;
                            vertical-alignment: center;
                        }
                    }

                    if (root.addon-repro-steps == "") : Text {
                        x: 12px;
                        y: 11px;
                        text: "es: 1. Parlo con il gossip NPC, 2. Si chiude la finestra, 3. Compare l'errore";
                        color: Theme.text-muted;
                        font-size: 12px;
                    }
                }
            }
        }

        // =====================================================================
        // BOTTOM ACTION ROW (Badge, Feedback & GitHub Automated Creation)
        // =====================================================================
        HorizontalLayout {
            alignment: space-between;

            // Left Meta Badge / Status feedback
            HorizontalLayout {
                spacing: 10px;
                alignment: start;

                // Target badge
                Rectangle {
                    height: 28px;
                    y: (parent.height - self.height) / 2;
                    border-radius: Theme.radius-xs;
                    background: #11151f;
                    border-width: 1px;
                    border-color: Theme.border-subtle;

                    HorizontalLayout {
                        padding-left: 10px;
                        padding-right: 10px;
                        spacing: 6px;
                        alignment: center;

                        Text {
                            text: root.report-type == 0 ? "Target:" : "Ambiente:";
                            color: Theme.text-muted;
                            font-size: 11px;
                            font-weight: 500;
                            vertical-alignment: center;
                        }
                        Text {
                            text: root.report-type == 0 ?
                                (root.current-sound-file != "" ? root.current-sound-file : "Segnalazione generale") :
                                "WoW Forever (1.12.1) · AddOn v1.0.0";
                            color: Theme.gold-light;
                            font-size: 11px;
                            vertical-alignment: center;
                        }
                    }
                }

                // Status Toast / Created Link
                if (root.submit-status-text != "") : Rectangle {
                    height: 28px;
                    y: (parent.height - self.height) / 2;
                    border-radius: Theme.radius-xs;
                    background: #22c55e18;
                    border-width: 1px;
                    border-color: #22c55e33;

                    HorizontalLayout {
                        padding-left: 10px;
                        padding-right: 10px;
                        spacing: 6px;
                        alignment: center;

                        VerticalLayout {
                            alignment: center;
                            Image {
                                width: 13px;
                                height: 13px;
                                source: @image-url("../assets/icons/check.svg");
                                colorize: Theme.status-success;
                                image-fit: contain;
                            }
                        }

                        VerticalLayout {
                            alignment: center;
                            Text {
                                text: root.submit-status-text;
                                color: Theme.status-success;
                                font-size: 11px;
                                font-weight: 500;
                            }
                        }
                    }
                }

                if (root.last-created-issue-url != "") : SecondaryButton {
                    text: "Apri Issue creata ↗";
                    custom-height: 28px;
                    clicked => {
                        root.open-issue-url(root.last-created-issue-url);
                    }
                }
            }

            // Right Action Buttons Pair
            HorizontalLayout {
                spacing: 10px;
                alignment: end;

                SecondaryButton {
                    text: "Esporta Markdown (.md)";
                    icon: @image-url("../assets/icons/file-text.svg");
                    custom-height: 38px;
                    clicked => {
                        if (root.report-type == 0) {
                            root.export-report-md(
                                0,
                                root.current-audio-category,
                                root.current-dialogue-title,
                                root.audio-description,
                                root.current-sound-file
                            );
                        } else {
                            root.export-report-md(
                                1,
                                root.current-addon-category,
                                root.addon-title != "" ? root.addon-title : "Problema AddOn",
                                root.addon-description,
                                root.addon-repro-steps
                            );
                        }
                    }
                }

                PrimaryButton {
                    text: root.has-github-token ? "Crea Issue su GitHub (API)" : "Crea Issue su GitHub";
                    icon: @image-url("../assets/icons/github.svg");
                    custom-height: 38px;
                    clicked => {
                        if (root.report-type == 0) {
                            root.create-github-issue(
                                0,
                                root.current-audio-category,
                                root.current-dialogue-title,
                                root.audio-description,
                                root.current-sound-file
                            );
                        } else {
                            root.create-github-issue(
                                1,
                                root.current-addon-category,
                                root.addon-title != "" ? root.addon-title : "Problema AddOn",
                                root.addon-description,
                                root.addon-repro-steps
                            );
                        }
                    }
                }
            }
        }
    }
}
