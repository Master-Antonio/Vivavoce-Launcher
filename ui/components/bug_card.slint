import { Theme } from "../theme.slint";
import { ScrollView } from "std-widgets.slint";
import { PrimaryButton, SecondaryButton } from "buttons.slint";

export struct DialogueEntry {
    sound-file: string,
    quest-id: int,
    npc-name: string,
    timestamp: string,
    text: string,
}

export component BugCard inherits Rectangle {
    in-out property <[DialogueEntry]> recent-dialogues: [];
    in-out property <int> selected-index: -1;
    in-out property <int> selected-category: 0;
    in-out property <string> user-description: "";
    in-out property <string> manual-sound-file: "";

    callback submit-report(string /* category */, string /* description */, string /* sound_file */);
    callback open-github(string /* category */, string /* description */, string /* sound_file */);

    // Selected sound file helper
    private property <string> current-sound-file:
        (root.selected-index >= 0 && root.selected-index < root.recent-dialogues.length) ?
            root.recent-dialogues[root.selected-index].sound-file :
            root.manual-sound-file;

    // Category names
    private property <[string]> categories: [
        "Pronuncia ed enfasi",
        "Volume o qualità",
        "Audio tagliato o glitch",
        "Testo non corrispondente",
        "Altro o suggerimento"
    ];

    private property <string> current-category-name: root.categories[root.selected-category];

    background: Theme.bg-panel;
    border-radius: Theme.radius-lg;
    border-width: 1px;
    border-color: Theme.border-normal;
    clip: true;

    VerticalLayout {
        padding: 16px;
        spacing: 12px;

        // Card Header
        HorizontalLayout {
            alignment: space-between;

            VerticalLayout {
                spacing: 3px;
                HorizontalLayout {
                    spacing: 8px;
                    alignment: start;

                    Image {
                        width: 16px;
                        height: 16px;
                        source: @image-url("../assets/icons/bug.svg");
                        colorize: Theme.gold-light;
                        image-fit: contain;
                        vertical-alignment: center;
                    }

                    Text {
                        text: "Segnala un problema audio";
                        color: Theme.text-primary;
                        font-size: 15px;
                        font-weight: 600;
                        vertical-alignment: center;
                    }
                }
                Text {
                    text: "Seleziona uno degli ultimi dialoghi riprodotti in gioco o descrivi il problema riscontrato.";
                    color: Theme.text-secondary;
                    font-size: 12px;
                }
            }

            // Status tag
            Rectangle {
                height: 22px;
                y: (parent.height - self.height) / 2;
                border-radius: Theme.radius-pill;
                background: #c89b3c15;
                border-width: 1px;
                border-color: #c89b3c33;

                HorizontalLayout {
                    padding-left: 8px;
                    padding-right: 8px;
                    Text {
                        text: root.recent-dialogues.length > 0 ? (root.recent-dialogues.length + " dialoghi in memoria") : "Cronologia vuota";
                        color: Theme.gold-light;
                        font-size: 10px;
                        font-weight: 500;
                        vertical-alignment: center;
                    }
                }
            }
        }

        // Section 1: Recent Dialogues List (or Quiet Empty State)
        VerticalLayout {
            spacing: 6px;

            Text {
                text: "Dialoghi recenti";
                color: Theme.text-primary;
                font-size: 12px;
                font-weight: 600;
            }

            // Container for Dialogue List or Empty State
            Rectangle {
                height: root.recent-dialogues.length == 0 ? 80px : 124px;
                background: Theme.bg-inset;
                border-radius: Theme.radius-md;
                border-width: 1px;
                border-color: Theme.border-subtle;
                clip: true;

                // Quiet empty state
                if (root.recent-dialogues.length == 0) : Rectangle {
                    HorizontalLayout {
                        padding-left: 16px;
                        padding-right: 16px;
                        alignment: center;
                        spacing: 12px;

                        Rectangle {
                            width: 32px;
                            height: 32px;
                            border-radius: Theme.radius-sm;
                            background: #121622;
                            border-width: 1px;
                            border-color: Theme.border-subtle;

                            Image {
                                width: 16px;
                                height: 16px;
                                source: @image-url("../assets/icons/headphones.svg");
                                colorize: Theme.gold-primary;
                                image-fit: contain;
                                x: (parent.width - self.width) / 2;
                                y: (parent.height - self.height) / 2;
                            }
                        }

                        VerticalLayout {
                            alignment: center;
                            spacing: 2px;

                            Text {
                                text: "Nessun dialogo recente in memoria";
                                color: Theme.text-primary;
                                font-size: 12px;
                                font-weight: 500;
                            }
                            Text {
                                text: "Avvia WoW Forever con VivaVoce per catturare l'audio in-game, oppure scrivi le note sotto.";
                                color: Theme.text-muted;
                                font-size: 11px;
                            }
                        }
                    }
                }

                // Populated Dialogues List
                if (root.recent-dialogues.length > 0) : ScrollView {
                    VerticalLayout {
                        spacing: 4px;
                        padding: 6px;

                        for item[idx] in root.recent-dialogues : Rectangle {
                            height: 52px;
                            background: root.selected-index == idx ? Theme.bg-card-selected : (row-touch.has-hover ? Theme.bg-card-hover : Theme.bg-card);
                            border-width: 1px;
                            border-color: root.selected-index == idx ? Theme.border-gold-normal : Theme.border-subtle;
                            border-radius: Theme.radius-sm;

                            animate background { duration: Theme.transition-fast; easing: ease-out; }
                            animate border-color { duration: Theme.transition-fast; easing: ease-out; }

                            row-touch := TouchArea {
                                mouse-cursor: pointer;
                                clicked => {
                                    root.selected-index = idx;
                                }
                            }

                            HorizontalLayout {
                                padding-left: 10px;
                                padding-right: 10px;
                                alignment: space-between;

                                VerticalLayout {
                                    spacing: 2px;
                                    alignment: center;

                                    HorizontalLayout {
                                        spacing: 6px;

                                        // NPC Name Badge
                                        Rectangle {
                                            height: 18px;
                                            background: #c89b3c18;
                                            border-radius: Theme.radius-xs;
                                            border-width: 1px;
                                            border-color: #c89b3c33;

                                            HorizontalLayout {
                                                padding-left: 6px;
                                                padding-right: 6px;
                                                Text {
                                                    text: item.npc-name != "" ? item.npc-name : "NPC sconosciuto";
                                                    color: Theme.gold-light;
                                                    font-size: 10px;
                                                    font-weight: 500;
                                                    vertical-alignment: center;
                                                }
                                            }
                                        }

                                        // Quest ID Badge
                                        if (item.quest-id > 0) : Rectangle {
                                            height: 18px;
                                            background: #38bdf814;
                                            border-radius: Theme.radius-xs;
                                            border-width: 1px;
                                            border-color: #38bdf833;

                                            HorizontalLayout {
                                                padding-left: 6px;
                                                padding-right: 6px;
                                                Text {
                                                    text: "Quest #" + item.quest-id;
                                                    color: Theme.status-info;
                                                    font-size: 10px;
                                                    font-weight: 500;
                                                    vertical-alignment: center;
                                                }
                                            }
                                        }

                                        Text {
                                            text: item.sound-file;
                                            color: Theme.text-secondary;
                                            font-size: 10px;
                                            vertical-alignment: center;
                                        }
                                    }

                                    // Dialogue text snippet
                                    Text {
                                        text: "\"" + item.text + "\"";
                                        color: Theme.text-primary;
                                        font-size: 11px;
                                        overflow: elide;
                                        max-width: 480px;
                                    }
                                }

                                // Selection indicator & timestamp
                                VerticalLayout {
                                    alignment: center;
                                    spacing: 3px;

                                    Text {
                                        text: item.timestamp;
                                        color: Theme.text-muted;
                                        font-size: 10px;
                                        horizontal-alignment: right;
                                    }

                                    Rectangle {
                                        width: 72px;
                                        height: 20px;
                                        border-radius: Theme.radius-xs;
                                        background: root.selected-index == idx ? Theme.btn-primary-bg : transparent;
                                        border-width: 1px;
                                        border-color: root.selected-index == idx ? Theme.btn-primary-bg : Theme.border-normal;

                                        Text {
                                            text: root.selected-index == idx ? "Selezionato" : "Seleziona";
                                            color: root.selected-index == idx ? Theme.btn-primary-text : Theme.text-secondary;
                                            font-size: 10px;
                                            font-weight: 500;
                                            horizontal-alignment: center;
                                            vertical-alignment: center;
                                        }
                                    }
                                }
                            }
                        }
                    }
                }
            }
        }

        // Section 2: Category Selection Pills
        VerticalLayout {
            spacing: 6px;

            Text {
                text: "Categoria del problema";
                color: Theme.text-primary;
                font-size: 12px;
                font-weight: 600;
            }

            HorizontalLayout {
                spacing: 8px;

                for cat-name[c-idx] in root.categories : Rectangle {
                    height: 28px;
                    border-radius: Theme.radius-pill;
                    background: root.selected-category == c-idx ? #c89b3c22 : (pill-touch.has-hover ? #182030 : Theme.bg-card);
                    border-width: 1px;
                    border-color: root.selected-category == c-idx ? Theme.border-gold-normal : Theme.border-normal;

                    animate background { duration: Theme.transition-fast; easing: ease-out; }
                    animate border-color { duration: Theme.transition-fast; easing: ease-out; }

                    pill-touch := TouchArea {
                        mouse-cursor: pointer;
                        clicked => {
                            root.selected-category = c-idx;
                        }
                    }

                    HorizontalLayout {
                        padding-left: 12px;
                        padding-right: 12px;
                        Text {
                            text: cat-name;
                            color: root.selected-category == c-idx ? Theme.gold-light : (pill-touch.has-hover ? Theme.text-primary : Theme.text-secondary);
                            font-size: 11px;
                            font-weight: root.selected-category == c-idx ? 600 : 400;
                            vertical-alignment: center;
                        }
                    }
                }
            }
        }

        // Section 3: Description Field & Manual Sound File
        VerticalLayout {
            spacing: 6px;

            Text {
                text: "Dettagli della segnalazione";
                color: Theme.text-primary;
                font-size: 12px;
                font-weight: 600;
            }

            Rectangle {
                height: 70px;
                background: Theme.bg-input;
                border-radius: Theme.radius-md;
                border-width: 1px;
                border-color: desc-input.has-focus ? Theme.border-gold-normal : Theme.border-normal;

                animate border-color { duration: Theme.transition-fast; easing: ease-out; }

                VerticalLayout {
                    padding: 8px;
                    desc-input := TextInput {
                        text <=> root.user-description;
                        color: Theme.text-primary;
                        font-size: 12px;
                        single-line: false;
                        wrap: word-wrap;
                    }
                }

                if (root.user-description == "") : Text {
                    x: 10px;
                    y: 9px;
                    text: "Descrivi l'anomalia (es. accento errato o battuta interrotta)";
                    color: Theme.text-muted;
                    font-size: 11px;
                }
            }
        }

        // Action Buttons Row (Using shared SecondaryButton & PrimaryButton)
        HorizontalLayout {
            alignment: space-between;

            // Target audio file badge
            Rectangle {
                height: 24px;
                y: (parent.height - self.height) / 2;
                border-radius: Theme.radius-xs;
                background: #11151f;
                border-width: 1px;
                border-color: Theme.border-subtle;

                HorizontalLayout {
                    padding-left: 8px;
                    padding-right: 8px;
                    spacing: 5px;
                    Text {
                        text: "File target:";
                        color: Theme.text-muted;
                        font-size: 10px;
                        font-weight: 500;
                        vertical-alignment: center;
                    }
                    Text {
                        text: root.current-sound-file != "" ? root.current-sound-file : "Segnalazione generale";
                        color: root.current-sound-file != "" ? Theme.gold-light : Theme.text-secondary;
                        font-size: 10px;
                        vertical-alignment: center;
                    }
                }
            }

            // Right Button Pair
            HorizontalLayout {
                spacing: 8px;
                alignment: end;

                SecondaryButton {
                    text: "Apri issue su GitHub";
                    icon: @image-url("../assets/icons/external-link.svg");
                    custom-height: 36px;
                    clicked => {
                        root.open-github(root.current-category-name, root.user-description, root.current-sound-file);
                    }
                }

                PrimaryButton {
                    text: "Esporta segnalazione";
                    icon: @image-url("../assets/icons/file-text.svg");
                    custom-height: 36px;
                    clicked => {
                        root.submit-report(root.current-category-name, root.user-description, root.current-sound-file);
                    }
                }
            }
        }
    }
}
