import { Theme } from "../theme.slint";
import { ScrollView } from "std-widgets.slint";

export struct DialogueEntry {
    sound-file: string,
    quest-id: int,
    npc-name: string,
    timestamp: string,
    text: string,
}

export component BugCard inherits Rectangle {
    in-out property <[DialogueEntry]> recent-dialogues: [];
    in-out property <int> selected-index: -1;
    in-out property <int> selected-category: 0;
    in-out property <string> user-description: "";
    in-out property <string> manual-sound-file: "";

    callback submit-report(string /* category */, string /* description */, string /* sound_file */);
    callback open-github(string /* category */, string /* description */, string /* sound_file */);

    // Selected sound file helper
    private property <string> current-sound-file:
        (root.selected-index >= 0 && root.selected-index < root.recent-dialogues.length) ?
            root.recent-dialogues[root.selected-index].sound-file :
            root.manual-sound-file;

    // Category names
    private property <[string]> categories: [
        "Pronuncia / Accento",
        "Volume / Qualità",
        "Audio tagliato / Glitch",
        "Testo non corrispondente",
        "Altro / Suggerimento"
    ];

    private property <string> current-category-name: root.categories[root.selected-category];

    background: Theme.bg-panel;
    border-radius: Theme.radius-lg;
    border-width: 1px;
    border-color: Theme.border-normal;
    clip: true;

    VerticalLayout {
        padding: 18px;
        spacing: 14px;

        // Card Header
        HorizontalLayout {
            alignment: space-between;

            VerticalLayout {
                spacing: 3px;
                HorizontalLayout {
                    spacing: 8px;
                    Text {
                        text: "🐛";
                        font-size: 16px;
                        vertical-alignment: center;
                    }
                    Text {
                        text: "Segnala un Problema Audio In-Game";
                        color: Theme.text-primary;
                        font-size: 16px;
                        font-weight: 700;
                        vertical-alignment: center;
                    }
                }
                Text {
                    text: "Seleziona uno degli ultimi dialoghi riprodotti in gioco o descrivi il problema riscontrato.";
                    color: Theme.text-secondary;
                    font-size: 12px;
                }
            }

            // Status tag
            Rectangle {
                height: 24px;
                y: (parent.height - self.height) / 2;
                border-radius: Theme.radius-pill;
                background: #c89b3c1a;
                border-width: 1px;
                border-color: #c89b3c40;

                HorizontalLayout {
                    padding-left: 10px;
                    padding-right: 10px;
                    Text {
                        text: root.recent-dialogues.length > 0 ? (root.recent-dialogues.length + " dialoghi in cronologia") : "Cronologia vuota";
                        color: Theme.gold-light;
                        font-size: 11px;
                        font-weight: 600;
                        vertical-alignment: center;
                    }
                }
            }
        }

        // Section 1: Recent Dialogues List (or Stylized Empty State)
        VerticalLayout {
            spacing: 6px;

            Text {
                text: "1. SELEZIONA DIALOGO DALLA CRONOLOGIA";
                color: Theme.gold-light;
                font-size: 11px;
                font-weight: 700;
                letter-spacing: 0.8px;
            }

            // Container for Dialogue List or Empty State
            Rectangle {
                height: root.recent-dialogues.length == 0 ? 84px : 124px;
                background: Theme.bg-inset;
                border-radius: Theme.radius-md;
                border-width: 1px;
                border-color: Theme.border-subtle;
                clip: true;

                // Craft Empty State: Warm, polished icon badge + helpful prompt
                if (root.recent-dialogues.length == 0) : Rectangle {
                    HorizontalLayout {
                        padding-left: 16px;
                        padding-right: 16px;
                        alignment: center;
                        spacing: 12px;

                        // Mini headphone icon badge
                        Rectangle {
                            width: 36px;
                            height: 36px;
                            border-radius: 18px;
                            background: #141a26;
                            border-width: 1px;
                            border-color: Theme.border-gold-subtle;

                            Text {
                                text: "🎧";
                                font-size: 16px;
                                horizontal-alignment: center;
                                vertical-alignment: center;
                            }
                        }

                        VerticalLayout {
                            alignment: center;
                            spacing: 3px;

                            Text {
                                text: "Nessun dialogo recente in memoria";
                                color: Theme.text-primary;
                                font-size: 12px;
                                font-weight: 600;
                            }
                            Text {
                                text: "Avvia WoW con VivaVoce per catturare l'audio in-game, oppure scrivi le note e il file sotto.";
                                color: Theme.text-muted;
                                font-size: 11px;
                            }
                        }
                    }
                }

                // Populated Dialogues List
                if (root.recent-dialogues.length > 0) : ScrollView {
                    VerticalLayout {
                        spacing: 4px;
                        padding: 6px;

                        for item[idx] in root.recent-dialogues : item-row := Rectangle {
                            height: 56px;
                            x: root.selected-index == idx ? 2px : (row-touch.has-hover ? 1px : 0px);
                            background: root.selected-index == idx ? Theme.bg-card-selected : (row-touch.has-hover ? Theme.bg-card-hover : Theme.bg-card);
                            border-width: 1px;
                            border-color: root.selected-index == idx ? Theme.border-gold-normal : Theme.border-subtle;
                            border-radius: Theme.radius-sm;

                            animate x { duration: Theme.transition-instant; easing: ease-out; }
                            animate background { duration: Theme.transition-fast; easing: ease-out; }
                            animate border-color { duration: Theme.transition-fast; easing: ease-out; }

                            row-touch := TouchArea {
                                mouse-cursor: pointer;
                                clicked => {
                                    root.selected-index = idx;
                                }
                            }

                            HorizontalLayout {
                                padding-left: 10px;
                                padding-right: 10px;
                                alignment: space-between;

                                VerticalLayout {
                                    spacing: 3px;
                                    alignment: center;

                                    HorizontalLayout {
                                        spacing: 8px;

                                        // NPC Name Badge
                                        Rectangle {
                                            height: 18px;
                                            background: #c89b3c20;
                                            border-radius: Theme.radius-xs;
                                            border-width: 1px;
                                            border-color: #c89b3c44;

                                            HorizontalLayout {
                                                padding-left: 6px;
                                                padding-right: 6px;
                                                Text {
                                                    text: item.npc-name != "" ? item.npc-name : "NPC Sconosciuto";
                                                    color: Theme.gold-bright;
                                                    font-size: 10px;
                                                    font-weight: 700;
                                                    vertical-alignment: center;
                                                }
                                            }
                                        }

                                        // Quest ID Badge
                                        if (item.quest-id > 0) : Rectangle {
                                            height: 18px;
                                            background: #38bdf818;
                                            border-radius: Theme.radius-xs;
                                            border-width: 1px;
                                            border-color: #38bdf844;

                                            HorizontalLayout {
                                                padding-left: 6px;
                                                padding-right: 6px;
                                                Text {
                                                    text: "Quest #" + item.quest-id;
                                                    color: Theme.status-info;
                                                    font-size: 10px;
                                                    font-weight: 600;
                                                    vertical-alignment: center;
                                                }
                                            }
                                        }

                                        Text {
                                            text: item.sound-file;
                                            color: Theme.text-secondary;
                                            font-size: 10px;
                                            vertical-alignment: center;
                                        }
                                    }

                                    // Dialogue text snippet
                                    Text {
                                        text: "\"" + item.text + "\"";
                                        color: Theme.text-primary;
                                        font-size: 11px;
                                        overflow: elide;
                                        max-width: 480px;
                                    }
                                }

                                // Selection indicator & timestamp
                                VerticalLayout {
                                    alignment: center;
                                    spacing: 3px;

                                    Text {
                                        text: item.timestamp;
                                        color: Theme.text-muted;
                                        font-size: 10px;
                                        horizontal-alignment: right;
                                    }

                                    Rectangle {
                                        width: 72px;
                                        height: 20px;
                                        border-radius: Theme.radius-xs;
                                        background: root.selected-index == idx ? Theme.gold-gradient : transparent;
                                        border-width: 1px;
                                        border-color: root.selected-index == idx ? Theme.border-gold-bright : Theme.border-normal;

                                        Text {
                                            text: root.selected-index == idx ? "Selezionato" : "Seleziona";
                                            color: root.selected-index == idx ? Theme.text-dark : Theme.text-secondary;
                                            font-size: 10px;
                                            font-weight: 700;
                                            horizontal-alignment: center;
                                            vertical-alignment: center;
                                        }
                                    }
                                }
                            }
                        }
                    }
                }
            }
        }

        // Section 2: Category Selection Pills
        VerticalLayout {
            spacing: 6px;

            Text {
                text: "2. CATEGORIA DEL PROBLEMA";
                color: Theme.gold-light;
                font-size: 11px;
                font-weight: 700;
                letter-spacing: 0.8px;
            }

            HorizontalLayout {
                spacing: 8px;

                for cat-name[c-idx] in root.categories : cat-pill := Rectangle {
                    height: 28px;
                    y: pill-touch.pressed ? 1px : 0px;
                    border-radius: Theme.radius-pill;
                    background: root.selected-category == c-idx ? #c89b3c25 : (pill-touch.has-hover ? #1f2738 : Theme.bg-card);
                    border-width: 1px;
                    border-color: root.selected-category == c-idx ? Theme.border-gold-bright : Theme.border-normal;

                    animate y { duration: Theme.transition-instant; easing: ease-out; }
                    animate background { duration: Theme.transition-fast; easing: ease-out; }
                    animate border-color { duration: Theme.transition-fast; easing: ease-out; }

                    pill-touch := TouchArea {
                        mouse-cursor: pointer;
                        clicked => {
                            root.selected-category = c-idx;
                        }
                    }

                    HorizontalLayout {
                        padding-left: 12px;
                        padding-right: 12px;
                        Text {
                            text: cat-name;
                            color: root.selected-category == c-idx ? Theme.gold-bright : (pill-touch.has-hover ? Theme.text-primary : Theme.text-secondary);
                            font-size: 11px;
                            font-weight: root.selected-category == c-idx ? 700 : 500;
                            vertical-alignment: center;
                        }
                    }
                }
            }
        }

        // Section 3: Description Field & Manual Sound File
        VerticalLayout {
            spacing: 6px;

            Text {
                text: "3. DESCRIZIONE DETTAGLIATA & NOTE";
                color: Theme.gold-light;
                font-size: 11px;
                font-weight: 700;
                letter-spacing: 0.8px;
            }

            Rectangle {
                height: 74px;
                background: Theme.bg-input;
                border-radius: Theme.radius-md;
                border-width: 1px;
                border-color: desc-input.has-focus ? Theme.border-gold-normal : Theme.border-normal;

                animate border-color { duration: Theme.transition-fast; easing: ease-out; }

                VerticalLayout {
                    padding: 8px;
                    desc-input := TextInput {
                        text <=> root.user-description;
                        color: Theme.text-primary;
                        font-size: 12px;
                        single-line: false;
                        wrap: word-wrap;
                    }
                }

                if (root.user-description == "") : Text {
                    x: 10px;
                    y: 9px;
                    text: "Descrivi il problema (es: 'L'accento sulla parola X è errato', 'Audio interrotto a metà')...";
                    color: Theme.text-muted;
                    font-size: 11px;
                }
            }
        }

        // Action Buttons Row (Esporta / GitHub) with Balanced Weights & Aligned Baselines
        HorizontalLayout {
            alignment: space-between;

            // Selected dialogue status summary pill
            HorizontalLayout {
                spacing: 6px;
                alignment: start;

                Rectangle {
                    height: 24px;
                    y: (parent.height - self.height) / 2;
                    border-radius: Theme.radius-xs;
                    background: #141924;
                    border-width: 1px;
                    border-color: Theme.border-subtle;

                    HorizontalLayout {
                        padding-left: 8px;
                        padding-right: 8px;
                        spacing: 5px;
                        Text {
                            text: "Target:";
                            color: Theme.text-muted;
                            font-size: 10px;
                            font-weight: 600;
                            vertical-alignment: center;
                        }
                        Text {
                            text: root.current-sound-file != "" ? root.current-sound-file : "Segnalazione generale / Testo";
                            color: root.current-sound-file != "" ? Theme.gold-light : Theme.text-secondary;
                            font-size: 10px;
                            vertical-alignment: center;
                        }
                    }
                }
            }

            // Right Button Pair
            HorizontalLayout {
                spacing: 10px;
                alignment: end;

                // GitHub Issue Button
                Rectangle {
                    width: 165px;
                    height: 38px;
                    y: gh-touch.pressed ? 1px : 0px;
                    border-radius: Theme.radius-md;
                    background: gh-touch.has-hover ? (gh-touch.pressed ? #252e42 : #182030) : #131824;
                    border-width: 1px;
                    border-color: gh-touch.has-hover ? Theme.border-gold-normal : Theme.border-normal;

                    animate y { duration: Theme.transition-instant; easing: ease-out; }
                    animate background { duration: Theme.transition-fast; }
                    animate border-color { duration: Theme.transition-fast; }

                    gh-touch := TouchArea {
                        mouse-cursor: pointer;
                        clicked => {
                            root.open-github(root.current-category-name, root.user-description, root.current-sound-file);
                        }
                    }

                    HorizontalLayout {
                        alignment: center;
                        spacing: 7px;
                        Text {
                            text: "🌐";
                            font-size: 13px;
                            vertical-alignment: center;
                        }
                        Text {
                            text: "Apri Issue GitHub";
                            color: gh-touch.has-hover ? Theme.gold-light : Theme.text-primary;
                            font-size: 12px;
                            font-weight: 600;
                            vertical-alignment: center;
                        }
                    }
                }

                // Export / Submit Report Button
                Rectangle {
                    width: 210px;
                    height: 38px;
                    y: sub-touch.pressed ? 1.5px : 0px;
                    border-radius: Theme.radius-md;
                    background: sub-touch.has-hover ? (sub-touch.pressed ? Theme.gold-gradient-pressed : Theme.gold-gradient-hover) : Theme.gold-gradient;
                    border-width: 1px;
                    border-color: sub-touch.has-hover ? Theme.border-gold-glow : Theme.border-gold-bright;

                    animate y { duration: Theme.transition-instant; easing: ease-out; }
                    animate background { duration: Theme.transition-fast; }
                    animate border-color { duration: Theme.transition-fast; }

                    // Top specular highlight
                    Rectangle {
                        x: 4px;
                        y: 1px;
                        width: parent.width - 8px;
                        height: 1px;
                        background: #ffffff44;
                    }

                    sub-touch := TouchArea {
                        mouse-cursor: pointer;
                        clicked => {
                            root.submit-report(root.current-category-name, root.user-description, root.current-sound-file);
                        }
                    }

                    HorizontalLayout {
                        alignment: center;
                        spacing: 7px;
                        Text {
                            text: "💾";
                            font-size: 13px;
                            vertical-alignment: center;
                        }
                        Text {
                            text: "Esporta Segnalazione (.md)";
                            color: Theme.text-dark;
                            font-size: 12px;
                            font-weight: 800;
                            letter-spacing: 0.3px;
                            vertical-alignment: center;
                        }
                    }
                }
            }
        }
    }
}
