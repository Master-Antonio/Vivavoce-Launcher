import { Theme } from "../theme.slint";
import { ScrollView } from "std-widgets.slint";
import { PrimaryButton, SecondaryButton } from "buttons.slint";

export struct DialogueEntry {
    sound-file: string,
    quest-id: int,
    npc-name: string,
    timestamp: string,
    text: string,
}

export component BugCard inherits Rectangle {
    // Shared properties
    in-out property <[DialogueEntry]> recent-dialogues: [];
    in-out property <int> report-type: 0; // 0 = Audio / Doppiaggio, 1 = AddOn / Tecnico
    in-out property <string> submit-status-text: "";
    in-out property <string> last-created-issue-url: "";
    in-out property <bool> has-github-token: false;

    // Audio properties
    in-out property <int> selected-dialogue-index: -1;
    in-out property <int> selected-audio-category: 0;
    in-out property <string> audio-description: "";
    in-out property <string> audio-quest-title: "";
    in-out property <string> audio-quest-id: "";
    in-out property <string> audio-dialogue-text: "";
    in-out property <string> manual-sound-file: "";

    // AddOn properties
    in-out property <int> selected-addon-category: 0;
    in-out property <string> addon-title: "";
    in-out property <string> addon-description: "";
    in-out property <string> addon-repro-steps: "";

    // Attachment properties & callbacks
    in-out property <string> attachment-path: "";
    in-out property <string> attachment-filename: "";
    callback select-attachment();
    callback remove-attachment();
    callback reveal-attachment();

    // Callbacks
    callback create-github-issue(int /* type: 0=audio, 1=addon */, string /* category */, string /* title */, string /* description */, string /* extra_data */, string /* attachment_path */);
    callback export-report-md(int /* type */, string /* category */, string /* title */, string /* description */, string /* extra_data */, string /* attachment_path */);
    callback open-issue-url(string /* url */);

    // Categories
    private property <[string]> audio-categories: [
        "Voce mancante",
        "Pronuncia ed enfasi",
        "Volume o qualità",
        "Sesso o voce errata",
        "Audio tagliato o glitch",
        "Testo non corrispondente",
        "Altro su audio"
    ];

    private property <[string]> addon-categories: [
        "Errore Lua in gioco",
        "Installazione / Moduli",
        "Rilevamento Client WoW",
        "Interfaccia / Opzioni AddOn",
        "Crash o blocco del gioco",
        "Altro problema tecnico"
    ];

    // Current category labels
    private property <string> current-audio-category: root.audio-categories[root.selected-audio-category];
    private property <string> current-addon-category: root.addon-categories[root.selected-addon-category];

    // Selected sound file
    private property <string> current-sound-file:
        (root.selected-dialogue-index >= 0 && root.selected-dialogue-index < root.recent-dialogues.length) ?
            root.recent-dialogues[root.selected-dialogue-index].sound-file :
            root.manual-sound-file;

    // Selected dialogue title
    private property <string> current-dialogue-title:
        (root.selected-audio-category == 0 && root.audio-quest-title != "") ?
            root.audio-quest-title :
            ((root.selected-dialogue-index >= 0 && root.selected-dialogue-index < root.recent-dialogues.length) ?
                root.recent-dialogues[root.selected-dialogue-index].npc-name :
                (root.audio-quest-title != "" ? root.audio-quest-title : (root.selected-audio-category == 0 ? "Voce mancante" : "Segnalazione Audio")));

    private property <string> audio-effective-description:
        (root.selected-audio-category == 0) ?
            ((root.audio-quest-id != "" ? "[Quest/NPC ID: " + root.audio-quest-id + "]\n" : "")
             + (root.audio-dialogue-text != "" ? "[Testo a schermo: " + root.audio-dialogue-text + "]\n\n" : "")
             + root.audio-description) :
            root.audio-description;

    width: 100%;
    background: Theme.bg-panel;
    border-radius: Theme.radius-lg;
    border-width: 1px;
    border-color: Theme.border-normal;
    clip: true;

    VerticalLayout {
        width: 100%;
        padding: 18px;
        spacing: 14px;
        alignment: start;

        // =====================================================================
        // HEADER: MODE SELECTOR (Emil Kowalski Segmented Control)
        // =====================================================================
        HorizontalLayout {
            alignment: start;

            // Segmented Pill Control for Audio vs AddOn
            Rectangle {
                height: 40px;
                border-radius: Theme.radius-md;
                background: #0d111a;
                border-width: 1px;
                border-color: Theme.border-subtle;

                HorizontalLayout {
                    padding: 3px;
                    spacing: 6px;

                    // Button: Audio
                    Rectangle {
                        width: 220px;
                        height: 32px;
                        border-radius: Theme.radius-sm;
                        background: root.report-type == 0 ? #1c2638 : (audio-tab-touch.has-hover ? #141b28 : transparent);
                        border-width: 1px;
                        border-color: root.report-type == 0 ? Theme.border-gold-normal : transparent;

                        animate background { duration: Theme.transition-fast; easing: ease-out; }
                        animate border-color { duration: Theme.transition-fast; easing: ease-out; }

                        audio-tab-touch := TouchArea {
                            mouse-cursor: pointer;
                            clicked => { root.report-type = 0; }
                        }

                        HorizontalLayout {
                            alignment: center;
                            spacing: 8px;

                            VerticalLayout {
                                alignment: center;
                                Image {
                                    width: 15px;
                                    height: 15px;
                                    source: @image-url("../assets/icons/headphones.svg");
                                    colorize: root.report-type == 0 ? Theme.gold-light : #8a94a6;
                                    image-fit: contain;
                                }
                            }

                            VerticalLayout {
                                alignment: center;
                                Text {
                                    text: "Problema Audio / Voci";
                                    color: root.report-type == 0 ? Theme.text-primary : #949db0;
                                    font-size: 13px;
                                    font-weight: root.report-type == 0 ? 600 : 400;
                                }
                            }
                        }
                    }

                    // Button: AddOn / Tecnico
                    Rectangle {
                        width: 220px;
                        height: 32px;
                        border-radius: Theme.radius-sm;
                        background: root.report-type == 1 ? #1c2638 : (addon-tab-touch.has-hover ? #141b28 : transparent);
                        border-width: 1px;
                        border-color: root.report-type == 1 ? Theme.border-gold-normal : transparent;

                        animate background { duration: Theme.transition-fast; easing: ease-out; }
                        animate border-color { duration: Theme.transition-fast; easing: ease-out; }

                        addon-tab-touch := TouchArea {
                            mouse-cursor: pointer;
                            clicked => { root.report-type = 1; }
                        }

                        HorizontalLayout {
                            alignment: center;
                            spacing: 8px;

                            VerticalLayout {
                                alignment: center;
                                Image {
                                    width: 15px;
                                    height: 15px;
                                    source: @image-url("../assets/icons/wrench.svg");
                                    colorize: root.report-type == 1 ? Theme.gold-light : #8a94a6;
                                    image-fit: contain;
                                }
                            }

                            VerticalLayout {
                                alignment: center;
                                Text {
                                    text: "Problema AddOn / Tecnico";
                                    color: root.report-type == 1 ? Theme.text-primary : #949db0;
                                    font-size: 13px;
                                    font-weight: root.report-type == 1 ? 600 : 400;
                                }
                            }
                        }
                    }
                }
            }
        }

        // Subtitle Description
        Text {
            text: root.report-type == 0 ?
                "Segnala errori di pronuncia, battute tagliate, volume non bilanciato o discrepanze tra audio recitato e sottotitoli." :
                "Segnala errori Lua di gioco, anomalie nei menu o impostazioni, problemi nel download dei pacchetti o crash.";
            color: Theme.text-secondary;
            font-size: 13px;
        }

        // =====================================================================
        // MODE 0: SEGNALAZIONE AUDIO
        // =====================================================================
        if (root.report-type == 0) : VerticalLayout {
            spacing: 12px;
            alignment: start;

            // Section 1: Dialoghi Recenti
            VerticalLayout {
                spacing: 6px;

                Text {
                    text: "Dialoghi recenti registrati in WoW Forever";
                    color: Theme.text-primary;
                    font-size: 13px;
                    font-weight: 600;
                }

                Rectangle {
                    height: root.recent-dialogues.length == 0 ? 84px : 124px;
                    background: Theme.bg-inset;
                    border-radius: Theme.radius-md;
                    border-width: 1px;
                    border-color: Theme.border-subtle;
                    clip: true;

                    // Empty state
                    if (root.recent-dialogues.length == 0) : Rectangle {
                        HorizontalLayout {
                            padding-left: 18px;
                            padding-right: 18px;
                            alignment: start;
                            spacing: 14px;

                            VerticalLayout {
                                alignment: center;
                                Rectangle {
                                    width: 38px;
                                    height: 38px;
                                    border-radius: Theme.radius-sm;
                                    background: #121622;
                                    border-width: 1px;
                                    border-color: Theme.border-subtle;

                                    Image {
                                        width: 18px;
                                        height: 18px;
                                        x: (parent.width - self.width) / 2;
                                        y: (parent.height - self.height) / 2;
                                        source: @image-url("../assets/icons/headphones.svg");
                                        colorize: Theme.gold-primary;
                                        image-fit: contain;
                                    }
                                }
                            }

                            VerticalLayout {
                                alignment: center;
                                spacing: 3px;

                                Text {
                                    text: "Nessun dialogo recente in memoria";
                                    color: Theme.text-primary;
                                    font-size: 13px;
                                    font-weight: 500;
                                }
                                Text {
                                    text: "Avvia WoW Forever con VivaVoce per registrare i dialoghi ascoltati, oppure descrivi l'anomalia sotto.";
                                    color: Theme.text-muted;
                                    font-size: 12px;
                                }
                            }
                        }
                    }

                    // Populated dialogues
                    if (root.recent-dialogues.length > 0) : ScrollView {
                        VerticalLayout {
                            spacing: 4px;
                            padding: 6px;

                            for item[idx] in root.recent-dialogues : Rectangle {
                                height: 54px;
                                background: root.selected-dialogue-index == idx ? Theme.bg-card-selected : (row-touch.has-hover ? Theme.bg-card-hover : Theme.bg-card);
                                border-width: 1px;
                                border-color: root.selected-dialogue-index == idx ? Theme.border-gold-normal : Theme.border-subtle;
                                border-radius: Theme.radius-sm;

                                animate background { duration: Theme.transition-fast; easing: ease-out; }
                                animate border-color { duration: Theme.transition-fast; easing: ease-out; }

                                row-touch := TouchArea {
                                    mouse-cursor: pointer;
                                    clicked => { root.selected-dialogue-index = idx; }
                                }

                                HorizontalLayout {
                                    padding-left: 12px;
                                    padding-right: 12px;
                                    alignment: space-between;

                                    VerticalLayout {
                                        horizontal-stretch: 1;
                                        spacing: 2px;
                                        alignment: center;

                                        HorizontalLayout {
                                            spacing: 7px;

                                            Rectangle {
                                                height: 20px;
                                                background: #c89b3c18;
                                                border-radius: Theme.radius-xs;
                                                border-width: 1px;
                                                border-color: #c89b3c33;

                                                HorizontalLayout {
                                                    padding-left: 7px;
                                                    padding-right: 7px;
                                                    alignment: center;
                                                    Text {
                                                        text: item.npc-name != "" ? item.npc-name : "NPC sconosciuto";
                                                        color: Theme.gold-light;
                                                        font-size: 11px;
                                                        font-weight: 500;
                                                        vertical-alignment: center;
                                                    }
                                                }
                                            }

                                            if (item.quest-id > 0) : Rectangle {
                                                height: 20px;
                                                background: #38bdf814;
                                                border-radius: Theme.radius-xs;
                                                border-width: 1px;
                                                border-color: #38bdf833;

                                                HorizontalLayout {
                                                    padding-left: 7px;
                                                    padding-right: 7px;
                                                    alignment: center;
                                                    Text {
                                                        text: "Quest #" + item.quest-id;
                                                        color: Theme.status-info;
                                                        font-size: 11px;
                                                        font-weight: 500;
                                                        vertical-alignment: center;
                                                    }
                                                }
                                            }

                                            Text {
                                                text: item.sound-file;
                                                color: Theme.text-secondary;
                                                font-size: 11px;
                                                vertical-alignment: center;
                                            }
                                        }

                                        Text {
                                            text: "\"" + item.text + "\"";
                                            color: Theme.text-primary;
                                            font-size: 12px;
                                            overflow: elide;
                                        }
                                    }

                                    VerticalLayout {
                                        alignment: center;
                                        spacing: 4px;

                                        Text {
                                            text: item.timestamp;
                                            color: Theme.text-muted;
                                            font-size: 11px;
                                            horizontal-alignment: right;
                                        }

                                        Rectangle {
                                            width: 82px;
                                            height: 22px;
                                            border-radius: Theme.radius-xs;
                                            background: root.selected-dialogue-index == idx ? Theme.btn-primary-bg : transparent;
                                            border-width: 1px;
                                            border-color: root.selected-dialogue-index == idx ? Theme.btn-primary-bg : Theme.border-normal;

                                            Text {
                                                text: root.selected-dialogue-index == idx ? "Selezionato" : "Seleziona";
                                                color: root.selected-dialogue-index == idx ? Theme.btn-primary-text : Theme.text-secondary;
                                                font-size: 11px;
                                                font-weight: 500;
                                                horizontal-alignment: center;
                                                vertical-alignment: center;
                                            }
                                        }
                                    }
                                }
                            }
                        }
                    }
                }
            }

            // Section 2: Audio Category Pills (2 rows of 3 pills)
            VerticalLayout {
                spacing: 8px;

                Text {
                    text: "Categoria problema audio";
                    color: Theme.text-primary;
                    font-size: 13px;
                    font-weight: 600;
                }

                // Row 1 (Categories 0, 1, 2, 3)
                HorizontalLayout {
                    spacing: 8px;
                    alignment: start;

                    // 0: Voce mancante
                    Rectangle {
                        height: 32px;
                        border-radius: Theme.radius-pill;
                        background: root.selected-audio-category == 0 ? #c89b3c22 : (au0.has-hover ? #182030 : Theme.bg-card);
                        border-width: 1px;
                        border-color: root.selected-audio-category == 0 ? Theme.border-gold-normal : Theme.border-normal;
                        animate background { duration: Theme.transition-fast; easing: ease-out; }
                        animate border-color { duration: Theme.transition-fast; easing: ease-out; }
                        au0 := TouchArea { mouse-cursor: pointer; clicked => { root.selected-audio-category = 0; } }
                        HorizontalLayout {
                            padding-left: 14px; padding-right: 14px; alignment: center;
                            Text { text: "Voce mancante"; color: root.selected-audio-category == 0 ? Theme.gold-light : (au0.has-hover ? Theme.text-primary : Theme.text-secondary); font-size: 12px; font-weight: root.selected-audio-category == 0 ? 600 : 400; vertical-alignment: center; }
                        }
                    }

                    // 1: Pronuncia ed enfasi
                    Rectangle {
                        height: 32px;
                        border-radius: Theme.radius-pill;
                        background: root.selected-audio-category == 1 ? #c89b3c22 : (au1.has-hover ? #182030 : Theme.bg-card);
                        border-width: 1px;
                        border-color: root.selected-audio-category == 1 ? Theme.border-gold-normal : Theme.border-normal;
                        animate background { duration: Theme.transition-fast; easing: ease-out; }
                        animate border-color { duration: Theme.transition-fast; easing: ease-out; }
                        au1 := TouchArea { mouse-cursor: pointer; clicked => { root.selected-audio-category = 1; } }
                        HorizontalLayout {
                            padding-left: 14px; padding-right: 14px; alignment: center;
                            Text { text: "Pronuncia ed enfasi"; color: root.selected-audio-category == 1 ? Theme.gold-light : (au1.has-hover ? Theme.text-primary : Theme.text-secondary); font-size: 12px; font-weight: root.selected-audio-category == 1 ? 600 : 400; vertical-alignment: center; }
                        }
                    }

                    // 2: Volume o qualità
                    Rectangle {
                        height: 32px;
                        border-radius: Theme.radius-pill;
                        background: root.selected-audio-category == 2 ? #c89b3c22 : (au2.has-hover ? #182030 : Theme.bg-card);
                        border-width: 1px;
                        border-color: root.selected-audio-category == 2 ? Theme.border-gold-normal : Theme.border-normal;
                        animate background { duration: Theme.transition-fast; easing: ease-out; }
                        animate border-color { duration: Theme.transition-fast; easing: ease-out; }
                        au2 := TouchArea { mouse-cursor: pointer; clicked => { root.selected-audio-category = 2; } }
                        HorizontalLayout {
                            padding-left: 14px; padding-right: 14px; alignment: center;
                            Text { text: "Volume o qualità"; color: root.selected-audio-category == 2 ? Theme.gold-light : (au2.has-hover ? Theme.text-primary : Theme.text-secondary); font-size: 12px; font-weight: root.selected-audio-category == 2 ? 600 : 400; vertical-alignment: center; }
                        }
                    }

                    // 3: Sesso o voce errata (NPC femmina che parla maschio o viceversa)
                    Rectangle {
                        height: 32px;
                        border-radius: Theme.radius-pill;
                        background: root.selected-audio-category == 3 ? #c89b3c22 : (au3.has-hover ? #182030 : Theme.bg-card);
                        border-width: 1px;
                        border-color: root.selected-audio-category == 3 ? Theme.border-gold-normal : Theme.border-normal;
                        animate background { duration: Theme.transition-fast; easing: ease-out; }
                        animate border-color { duration: Theme.transition-fast; easing: ease-out; }
                        au3 := TouchArea { mouse-cursor: pointer; clicked => { root.selected-audio-category = 3; } }
                        HorizontalLayout {
                            padding-left: 14px; padding-right: 14px; alignment: center;
                            Text { text: "Sesso o voce errata"; color: root.selected-audio-category == 3 ? Theme.gold-light : (au3.has-hover ? Theme.text-primary : Theme.text-secondary); font-size: 12px; font-weight: root.selected-audio-category == 3 ? 600 : 400; vertical-alignment: center; }
                        }
                    }
                }

                // Row 2 (Categories 4, 5, 6)
                HorizontalLayout {
                    spacing: 8px;
                    alignment: start;

                    // 4: Audio tagliato o glitch
                    Rectangle {
                        height: 32px;
                        border-radius: Theme.radius-pill;
                        background: root.selected-audio-category == 4 ? #c89b3c22 : (au4.has-hover ? #182030 : Theme.bg-card);
                        border-width: 1px;
                        border-color: root.selected-audio-category == 4 ? Theme.border-gold-normal : Theme.border-normal;
                        animate background { duration: Theme.transition-fast; easing: ease-out; }
                        animate border-color { duration: Theme.transition-fast; easing: ease-out; }
                        au4 := TouchArea { mouse-cursor: pointer; clicked => { root.selected-audio-category = 4; } }
                        HorizontalLayout {
                            padding-left: 14px; padding-right: 14px; alignment: center;
                            Text { text: "Audio tagliato o glitch"; color: root.selected-audio-category == 4 ? Theme.gold-light : (au4.has-hover ? Theme.text-primary : Theme.text-secondary); font-size: 12px; font-weight: root.selected-audio-category == 4 ? 600 : 400; vertical-alignment: center; }
                        }
                    }

                    // 5: Testo non corrispondente
                    Rectangle {
                        height: 32px;
                        border-radius: Theme.radius-pill;
                        background: root.selected-audio-category == 5 ? #c89b3c22 : (au5.has-hover ? #182030 : Theme.bg-card);
                        border-width: 1px;
                        border-color: root.selected-audio-category == 5 ? Theme.border-gold-normal : Theme.border-normal;
                        animate background { duration: Theme.transition-fast; easing: ease-out; }
                        animate border-color { duration: Theme.transition-fast; easing: ease-out; }
                        au5 := TouchArea { mouse-cursor: pointer; clicked => { root.selected-audio-category = 5; } }
                        HorizontalLayout {
                            padding-left: 14px; padding-right: 14px; alignment: center;
                            Text { text: "Testo non corrispondente"; color: root.selected-audio-category == 5 ? Theme.gold-light : (au5.has-hover ? Theme.text-primary : Theme.text-secondary); font-size: 12px; font-weight: root.selected-audio-category == 5 ? 600 : 400; vertical-alignment: center; }
                        }
                    }

                    // 6: Altro su audio
                    Rectangle {
                        height: 32px;
                        border-radius: Theme.radius-pill;
                        background: root.selected-audio-category == 6 ? #c89b3c22 : (au6.has-hover ? #182030 : Theme.bg-card);
                        border-width: 1px;
                        border-color: root.selected-audio-category == 6 ? Theme.border-gold-normal : Theme.border-normal;
                        animate background { duration: Theme.transition-fast; easing: ease-out; }
                        animate border-color { duration: Theme.transition-fast; easing: ease-out; }
                        au6 := TouchArea { mouse-cursor: pointer; clicked => { root.selected-audio-category = 6; } }
                        HorizontalLayout {
                            padding-left: 14px; padding-right: 14px; alignment: center;
                            Text { text: "Altro su audio"; color: root.selected-audio-category == 6 ? Theme.gold-light : (au6.has-hover ? Theme.text-primary : Theme.text-secondary); font-size: 12px; font-weight: root.selected-audio-category == 6 ? 600 : 400; vertical-alignment: center; }
                        }
                    }
                }
            }

            // Sezione specifica per "Voce mancante" (ID, Quest e Testo a schermo)
            if (root.selected-audio-category == 0) : VerticalLayout {
                spacing: 10px;

                // Hint banner su come ottenere ID e dati in-game
                Rectangle {
                    border-radius: Theme.radius-sm;
                    background: #c89b3c10;
                    border-width: 1px;
                    border-color: #c89b3c33;

                    HorizontalLayout {
                        padding: 10px;
                        spacing: 10px;

                        VerticalLayout {
                            alignment: center;
                            Image {
                                width: 16px;
                                height: 16px;
                                source: @image-url("../assets/icons/shield-check.svg");
                                colorize: Theme.gold-light;
                                image-fit: contain;
                            }
                        }

                        Text {
                            text: "Come trovare i dati: nel gioco puoi digitare /vvq in chat con la finestra aperta per copiare ID e testo. Altrimenti, inserisci qui sotto il nome della quest e dell'NPC.";
                            color: Theme.gold-light;
                            font-size: 11px;
                            wrap: word-wrap;
                            horizontal-stretch: 1;
                        }
                    }
                }

                // Grid: Titolo Quest / NPC + ID
                HorizontalLayout {
                    spacing: 10px;

                    // Titolo Quest o NPC
                    VerticalLayout {
                        spacing: 4px;
                        horizontal-stretch: 2;

                        Text {
                            text: "Titolo Quest o Nome NPC *";
                            color: Theme.text-primary;
                            font-size: 12px;
                            font-weight: 600;
                        }

                        Rectangle {
                            height: 38px;
                            background: Theme.bg-input;
                            border-radius: Theme.radius-sm;
                            border-width: 1px;
                            border-color: quest-title-input.has-focus ? Theme.border-gold-normal : Theme.border-normal;
                            animate border-color { duration: Theme.transition-fast; easing: ease-out; }

                            TouchArea {
                                mouse-cursor: text;
                                clicked => { quest-title-input.focus(); }
                            }

                            if (root.audio-quest-title == "" && !quest-title-input.has-focus) : Text {
                                x: 12px;
                                y: 11px;
                                text: "es: La miniera di Fargodeep, o Maresciallo Dughan...";
                                color: Theme.text-muted;
                                font-size: 12px;
                            }

                            HorizontalLayout {
                                padding-left: 12px;
                                padding-right: 12px;
                                quest-title-input := TextInput {
                                    text <=> root.audio-quest-title;
                                    color: Theme.text-primary;
                                    font-size: 13px;
                                    single-line: true;
                                    vertical-alignment: center;
                                }
                            }
                        }
                    }

                    // ID Quest o NPC (opzionale)
                    VerticalLayout {
                        spacing: 4px;
                        horizontal-stretch: 1;

                        Text {
                            text: "ID Quest / NPC (opzionale)";
                            color: Theme.text-primary;
                            font-size: 12px;
                            font-weight: 600;
                        }

                        Rectangle {
                            height: 38px;
                            background: Theme.bg-input;
                            border-radius: Theme.radius-sm;
                            border-width: 1px;
                            border-color: quest-id-input.has-focus ? Theme.border-gold-normal : Theme.border-normal;
                            animate border-color { duration: Theme.transition-fast; easing: ease-out; }

                            TouchArea {
                                mouse-cursor: text;
                                clicked => { quest-id-input.focus(); }
                            }

                            if (root.audio-quest-id == "" && !quest-id-input.has-focus) : Text {
                                x: 12px;
                                y: 11px;
                                text: "es: 40 (o link db)";
                                color: Theme.text-muted;
                                font-size: 12px;
                            }

                            HorizontalLayout {
                                padding-left: 12px;
                                padding-right: 12px;
                                quest-id-input := TextInput {
                                    text <=> root.audio-quest-id;
                                    color: Theme.text-primary;
                                    font-size: 13px;
                                    single-line: true;
                                    vertical-alignment: center;
                                }
                            }
                        }
                    }
                }

                // Testo a schermo non doppiato (opzionale)
                VerticalLayout {
                    spacing: 4px;

                    Text {
                        text: "Testo a schermo non doppiato (opzionale)";
                        color: Theme.text-primary;
                        font-size: 12px;
                        font-weight: 600;
                    }

                    Rectangle {
                        height: 60px;
                        background: Theme.bg-input;
                        border-radius: Theme.radius-sm;
                        border-width: 1px;
                        border-color: dialogue-text-input.has-focus ? Theme.border-gold-normal : Theme.border-normal;
                        animate border-color { duration: Theme.transition-fast; easing: ease-out; }

                        TouchArea {
                            mouse-cursor: text;
                            clicked => { dialogue-text-input.focus(); }
                        }

                        if (root.audio-dialogue-text == "" && !dialogue-text-input.has-focus) : Text {
                            x: 12px;
                            y: 11px;
                            text: "Incolla qui il testo in gioco, oppure la busta copiata con /vvq...";
                            color: Theme.text-muted;
                            font-size: 12px;
                        }

                        VerticalLayout {
                            padding: 10px;
                            dialogue-text-input := TextInput {
                                text <=> root.audio-dialogue-text;
                                color: Theme.text-primary;
                                font-size: 12px;
                                single-line: false;
                                wrap: word-wrap;
                            }
                        }
                    }
                }
            }

            // Section 3: Audio Description
            VerticalLayout {
                spacing: 6px;

                Text {
                    text: root.selected-audio-category == 0 ? "Note aggiuntive o contesto" : "Dettagli anomalia o suggerimento";
                    color: Theme.text-primary;
                    font-size: 13px;
                    font-weight: 600;
                }

                Rectangle {
                    height: root.selected-audio-category == 0 ? 56px : 76px;
                    background: Theme.bg-input;
                    border-radius: Theme.radius-md;
                    border-width: 1px;
                    border-color: audio-desc-input.has-focus ? Theme.border-gold-normal : Theme.border-normal;

                    animate border-color { duration: Theme.transition-fast; easing: ease-out; }

                    audio-touch := TouchArea {
                        mouse-cursor: text;
                        clicked => { audio-desc-input.focus(); }
                    }

                    if (root.audio-description == "" && !audio-desc-input.has-focus) : Text {
                        x: 12px;
                        y: 11px;
                        text: root.selected-audio-category == 0 ?
                            "es: NPC non parla quando accetto la quest, nessun audio viene riprodotto..." :
                            (root.selected-audio-category == 3 ?
                                "es: NPC femminile con voce maschile (o viceversa), pitch non coerente..." :
                                "Descrivi l'anomalia (es: accento errato sulla parola 'Ironforge', audio interrotto a metà frase...)");
                        color: Theme.text-muted;
                        font-size: 12px;
                    }

                    VerticalLayout {
                        padding: 10px;
                        audio-desc-input := TextInput {
                            text <=> root.audio-description;
                            color: Theme.text-primary;
                            font-size: 13px;
                            single-line: false;
                            wrap: word-wrap;
                            horizontal-alignment: left;
                        }
                    }
                }
            }
        }

        // =====================================================================
        // MODE 1: SEGNALAZIONE ADDON / TECNICO
        // =====================================================================
        if (root.report-type == 1) : VerticalLayout {
            spacing: 12px;
            alignment: start;

            // Section 1: AddOn Category Pills
            VerticalLayout {
                spacing: 6px;

                Text {
                    text: "Categoria del problema tecnico";
                    color: Theme.text-primary;
                    font-size: 13px;
                    font-weight: 600;
                }

                VerticalLayout {
                    spacing: 8px;

                    // Row 1: 3 pills
                    HorizontalLayout {
                        spacing: 8px;
                        alignment: start;

                        Rectangle {
                            height: 32px;
                            border-radius: Theme.radius-pill;
                            background: root.selected-addon-category == 0 ? #c89b3c22 : (ap0.has-hover ? #182030 : Theme.bg-card);
                            border-width: 1px;
                            border-color: root.selected-addon-category == 0 ? Theme.border-gold-normal : Theme.border-normal;
                            animate background { duration: Theme.transition-fast; easing: ease-out; }
                            animate border-color { duration: Theme.transition-fast; easing: ease-out; }
                            ap0 := TouchArea { mouse-cursor: pointer; clicked => { root.selected-addon-category = 0; } }
                            HorizontalLayout {
                                padding-left: 14px; padding-right: 14px; alignment: center;
                                Text { text: "Errore Lua in gioco"; color: root.selected-addon-category == 0 ? Theme.gold-light : (ap0.has-hover ? Theme.text-primary : Theme.text-secondary); font-size: 12px; font-weight: root.selected-addon-category == 0 ? 600 : 400; vertical-alignment: center; }
                            }
                        }

                        Rectangle {
                            height: 32px;
                            border-radius: Theme.radius-pill;
                            background: root.selected-addon-category == 1 ? #c89b3c22 : (ap1.has-hover ? #182030 : Theme.bg-card);
                            border-width: 1px;
                            border-color: root.selected-addon-category == 1 ? Theme.border-gold-normal : Theme.border-normal;
                            animate background { duration: Theme.transition-fast; easing: ease-out; }
                            animate border-color { duration: Theme.transition-fast; easing: ease-out; }
                            ap1 := TouchArea { mouse-cursor: pointer; clicked => { root.selected-addon-category = 1; } }
                            HorizontalLayout {
                                padding-left: 14px; padding-right: 14px; alignment: center;
                                Text { text: "Installazione / Moduli"; color: root.selected-addon-category == 1 ? Theme.gold-light : (ap1.has-hover ? Theme.text-primary : Theme.text-secondary); font-size: 12px; font-weight: root.selected-addon-category == 1 ? 600 : 400; vertical-alignment: center; }
                            }
                        }

                        Rectangle {
                            height: 32px;
                            border-radius: Theme.radius-pill;
                            background: root.selected-addon-category == 2 ? #c89b3c22 : (ap2.has-hover ? #182030 : Theme.bg-card);
                            border-width: 1px;
                            border-color: root.selected-addon-category == 2 ? Theme.border-gold-normal : Theme.border-normal;
                            animate background { duration: Theme.transition-fast; easing: ease-out; }
                            animate border-color { duration: Theme.transition-fast; easing: ease-out; }
                            ap2 := TouchArea { mouse-cursor: pointer; clicked => { root.selected-addon-category = 2; } }
                            HorizontalLayout {
                                padding-left: 14px; padding-right: 14px; alignment: center;
                                Text { text: "Rilevamento Client WoW"; color: root.selected-addon-category == 2 ? Theme.gold-light : (ap2.has-hover ? Theme.text-primary : Theme.text-secondary); font-size: 12px; font-weight: root.selected-addon-category == 2 ? 600 : 400; vertical-alignment: center; }
                            }
                        }
                    }

                    // Row 2: 3 pills
                    HorizontalLayout {
                        spacing: 8px;
                        alignment: start;

                        Rectangle {
                            height: 32px;
                            border-radius: Theme.radius-pill;
                            background: root.selected-addon-category == 3 ? #c89b3c22 : (ap3.has-hover ? #182030 : Theme.bg-card);
                            border-width: 1px;
                            border-color: root.selected-addon-category == 3 ? Theme.border-gold-normal : Theme.border-normal;
                            animate background { duration: Theme.transition-fast; easing: ease-out; }
                            animate border-color { duration: Theme.transition-fast; easing: ease-out; }
                            ap3 := TouchArea { mouse-cursor: pointer; clicked => { root.selected-addon-category = 3; } }
                            HorizontalLayout {
                                padding-left: 14px; padding-right: 14px; alignment: center;
                                Text { text: "Interfaccia / Opzioni AddOn"; color: root.selected-addon-category == 3 ? Theme.gold-light : (ap3.has-hover ? Theme.text-primary : Theme.text-secondary); font-size: 12px; font-weight: root.selected-addon-category == 3 ? 600 : 400; vertical-alignment: center; }
                            }
                        }

                        Rectangle {
                            height: 32px;
                            border-radius: Theme.radius-pill;
                            background: root.selected-addon-category == 4 ? #c89b3c22 : (ap4.has-hover ? #182030 : Theme.bg-card);
                            border-width: 1px;
                            border-color: root.selected-addon-category == 4 ? Theme.border-gold-normal : Theme.border-normal;
                            animate background { duration: Theme.transition-fast; easing: ease-out; }
                            animate border-color { duration: Theme.transition-fast; easing: ease-out; }
                            ap4 := TouchArea { mouse-cursor: pointer; clicked => { root.selected-addon-category = 4; } }
                            HorizontalLayout {
                                padding-left: 14px; padding-right: 14px; alignment: center;
                                Text { text: "Crash o blocco del gioco"; color: root.selected-addon-category == 4 ? Theme.gold-light : (ap4.has-hover ? Theme.text-primary : Theme.text-secondary); font-size: 12px; font-weight: root.selected-addon-category == 4 ? 600 : 400; vertical-alignment: center; }
                            }
                        }

                        Rectangle {
                            height: 32px;
                            border-radius: Theme.radius-pill;
                            background: root.selected-addon-category == 5 ? #c89b3c22 : (ap5.has-hover ? #182030 : Theme.bg-card);
                            border-width: 1px;
                            border-color: root.selected-addon-category == 5 ? Theme.border-gold-normal : Theme.border-normal;
                            animate background { duration: Theme.transition-fast; easing: ease-out; }
                            animate border-color { duration: Theme.transition-fast; easing: ease-out; }
                            ap5 := TouchArea { mouse-cursor: pointer; clicked => { root.selected-addon-category = 5; } }
                            HorizontalLayout {
                                padding-left: 14px; padding-right: 14px; alignment: center;
                                Text { text: "Altro problema"; color: root.selected-addon-category == 5 ? Theme.gold-light : (ap5.has-hover ? Theme.text-primary : Theme.text-secondary); font-size: 12px; font-weight: root.selected-addon-category == 5 ? 600 : 400; vertical-alignment: center; }
                            }
                        }
                    }
                }
            }

            // Section 2: Titolo o Sintesi AddOn
            VerticalLayout {
                spacing: 6px;

                Text {
                    text: "Sintesi o titolo del problema";
                    color: Theme.text-primary;
                    font-size: 13px;
                    font-weight: 600;
                }

                Rectangle {
                    height: 38px;
                    background: Theme.bg-input;
                    border-radius: Theme.radius-sm;
                    border-width: 1px;
                    border-color: addon-title-input.has-focus ? Theme.border-gold-normal : Theme.border-normal;

                    animate border-color { duration: Theme.transition-fast; easing: ease-out; }

                    title-touch := TouchArea {
                        mouse-cursor: text;
                        clicked => { addon-title-input.focus(); }
                    }

                    if (root.addon-title == "" && !addon-title-input.has-focus) : Text {
                        x: 12px;
                        y: 11px;
                        text: "es: Errore Lua all'apertura del quest log di Ironforge";
                        color: Theme.text-muted;
                        font-size: 12px;
                    }

                    HorizontalLayout {
                        padding-left: 12px;
                        padding-right: 12px;
                        alignment: stretch;

                        addon-title-input := TextInput {
                            text <=> root.addon-title;
                            color: Theme.text-primary;
                            font-size: 13px;
                            single-line: true;
                            horizontal-alignment: left;
                            vertical-alignment: center;
                        }
                    }
                }
            }

            // Section 3: Errore Lua / Descrizione
            VerticalLayout {
                spacing: 6px;

                Text {
                    text: "Messaggio di errore Lua o comportamento anomalo";
                    color: Theme.text-primary;
                    font-size: 13px;
                    font-weight: 600;
                }

                Rectangle {
                    height: 80px;
                    background: Theme.bg-input;
                    border-radius: Theme.radius-md;
                    border-width: 1px;
                    border-color: addon-desc-input.has-focus ? Theme.border-gold-normal : Theme.border-normal;

                    animate border-color { duration: Theme.transition-fast; easing: ease-out; }

                    desc-touch := TouchArea {
                        mouse-cursor: text;
                        clicked => { addon-desc-input.focus(); }
                    }

                    if (root.addon-description == "" && !addon-desc-input.has-focus) : Text {
                        x: 12px;
                        y: 11px;
                        text: "Incolla qui l'errore Lua (Interface/AddOns/VivaVoce...) oppure descrivi il malfunzionamento";
                        color: Theme.text-muted;
                        font-size: 12px;
                    }

                    VerticalLayout {
                        padding: 10px;
                        addon-desc-input := TextInput {
                            text <=> root.addon-description;
                            color: Theme.text-primary;
                            font-size: 12px;
                            single-line: false;
                            wrap: word-wrap;
                            horizontal-alignment: left;
                        }
                    }
                }
            }

            // Section 4: Passaggi per riprodurre (opzionale)
            VerticalLayout {
                spacing: 6px;

                Text {
                    text: "Passaggi per riprodurre (opzionale)";
                    color: Theme.text-primary;
                    font-size: 13px;
                    font-weight: 600;
                }

                Rectangle {
                    height: 38px;
                    background: Theme.bg-input;
                    border-radius: Theme.radius-sm;
                    border-width: 1px;
                    border-color: repro-input.has-focus ? Theme.border-gold-normal : Theme.border-normal;

                    animate border-color { duration: Theme.transition-fast; easing: ease-out; }

                    repro-touch := TouchArea {
                        mouse-cursor: text;
                        clicked => { repro-input.focus(); }
                    }

                    if (root.addon-repro-steps == "" && !repro-input.has-focus) : Text {
                        x: 12px;
                        y: 11px;
                        text: "es: 1. Parlo con il gossip NPC, 2. Si chiude la finestra, 3. Compare l'errore";
                        color: Theme.text-muted;
                        font-size: 12px;
                    }

                    HorizontalLayout {
                        padding-left: 12px;
                        padding-right: 12px;
                        alignment: stretch;

                        repro-input := TextInput {
                            text <=> root.addon-repro-steps;
                            color: Theme.text-primary;
                            font-size: 13px;
                            single-line: true;
                            horizontal-alignment: left;
                            vertical-alignment: center;
                        }
                    }
                }
            }
        }

        // =====================================================================
        // SECTION: ALLEGATO MULTIMEDIALE (Screenshot o Video)
        // =====================================================================
        VerticalLayout {
            spacing: 6px;

            HorizontalLayout {
                alignment: space-between;

                Text {
                    text: "Screenshot o Video di prova (opzionale)";
                    color: Theme.text-primary;
                    font-size: 13px;
                    font-weight: 600;
                    vertical-alignment: center;
                }

                if (root.attachment-path != "") : Text {
                    text: "1 file pronto";
                    color: Theme.gold-light;
                    font-size: 11px;
                    font-weight: 500;
                    vertical-alignment: center;
                }
            }

            if (root.attachment-path == "") : Rectangle {
                height: 44px;
                background: Theme.bg-input;
                border-radius: Theme.radius-sm;
                border-width: 1px;
                border-color: attach-drop-area.has-hover ? Theme.border-gold-normal : Theme.border-normal;
                animate border-color { duration: Theme.transition-fast; easing: ease-out; }
                animate background { duration: Theme.transition-fast; easing: ease-out; }

                attach-drop-area := TouchArea {
                    mouse-cursor: pointer;
                    clicked => { root.select-attachment(); }
                }

                HorizontalLayout {
                    padding-left: 14px;
                    padding-right: 14px;
                    alignment: space-between;

                    HorizontalLayout {
                        spacing: 10px;
                        alignment: start;

                        VerticalLayout {
                            alignment: center;
                            Image {
                                width: 16px;
                                height: 16px;
                                source: @image-url("../assets/icons/image.svg");
                                colorize: attach-drop-area.has-hover ? Theme.gold-light : Theme.text-muted;
                                image-fit: contain;
                                animate colorize { duration: Theme.transition-fast; easing: ease-out; }
                            }
                        }

                        VerticalLayout {
                            alignment: center;
                            Text {
                                text: "Allega screenshot o registrazione video (.png, .jpg, .mp4, .webm...)";
                                color: attach-drop-area.has-hover ? Theme.text-primary : Theme.text-secondary;
                                font-size: 12px;
                                vertical-alignment: center;
                            }
                        }
                    }

                    HorizontalLayout {
                        alignment: end;
                        VerticalLayout {
                            alignment: center;
                            SecondaryButton {
                                text: "Sfoglia file…";
                                icon: @image-url("../assets/icons/folder-open.svg");
                                custom-height: 28px;
                                clicked => { root.select-attachment(); }
                            }
                        }
                    }
                }
            }

            if (root.attachment-path != "") : Rectangle {
                height: 48px;
                background: #101622;
                border-radius: Theme.radius-sm;
                border-width: 1px;
                border-color: Theme.border-gold-normal;
                clip: true;

                HorizontalLayout {
                    padding-left: 12px;
                    padding-right: 12px;
                    alignment: space-between;

                    HorizontalLayout {
                        spacing: 10px;
                        alignment: start;
                        horizontal-stretch: 1;

                        VerticalLayout {
                            alignment: center;
                            Rectangle {
                                width: 28px;
                                height: 28px;
                                border-radius: Theme.radius-xs;
                                background: #c89b3c22;
                                border-width: 1px;
                                border-color: #c89b3c44;

                                Image {
                                    width: 15px;
                                    height: 15px;
                                    source: @image-url("../assets/icons/image.svg");
                                    colorize: Theme.gold-light;
                                    image-fit: contain;
                                    x: (parent.width - self.width) / 2;
                                    y: (parent.height - self.height) / 2;
                                }
                            }
                        }

                        VerticalLayout {
                            alignment: center;
                            spacing: 2px;
                            horizontal-stretch: 1;

                            Text {
                                text: root.attachment-filename != "" ? root.attachment-filename : root.attachment-path;
                                color: Theme.text-primary;
                                font-size: 12px;
                                font-weight: 600;
                                overflow: elide;
                            }

                            Text {
                                text: "File pronto · Copiato negli appunti per incolla rapido (CTRL+V)";
                                color: Theme.gold-muted;
                                font-size: 11px;
                                overflow: elide;
                            }
                        }
                    }

                    HorizontalLayout {
                        spacing: 8px;
                        alignment: end;

                        VerticalLayout {
                            alignment: center;
                            SecondaryButton {
                                text: "Apri cartella ↗";
                                custom-height: 28px;
                                clicked => { root.reveal-attachment(); }
                            }
                        }

                        VerticalLayout {
                            alignment: center;
                            SecondaryButton {
                                text: "Cambia";
                                custom-height: 28px;
                                clicked => { root.select-attachment(); }
                            }
                        }

                        VerticalLayout {
                            alignment: center;
                            Rectangle {
                                width: 28px;
                                height: 28px;
                                border-radius: Theme.radius-xs;
                                background: remove-touch.has-hover ? #ef444433 : #ef444415;
                                border-width: 1px;
                                border-color: remove-touch.has-hover ? #ef444488 : #ef444433;
                                animate background { duration: Theme.transition-fast; easing: ease-out; }

                                remove-touch := TouchArea {
                                    mouse-cursor: pointer;
                                    clicked => { root.remove-attachment(); }
                                }

                                Image {
                                    width: 12px;
                                    height: 12px;
                                    source: @image-url("../assets/icons/x.svg");
                                    colorize: #ef4444;
                                    image-fit: contain;
                                    x: (parent.width - self.width) / 2;
                                    y: (parent.height - self.height) / 2;
                                }
                            }
                        }
                    }
                }
            }
        }

        // =====================================================================
        // SUCCESS & NOTIFICATION BANNER (Dedicated row to prevent button shift)
        // =====================================================================
        if (root.submit-status-text != "") : Rectangle {
            height: 38px;
            border-radius: Theme.radius-sm;
            background: #22c55e14;
            border-width: 1px;
            border-color: #22c55e44;
            clip: true;

            HorizontalLayout {
                padding-left: 14px;
                padding-right: 14px;
                alignment: space-between;

                HorizontalLayout {
                    spacing: 8px;
                    alignment: start;
                    horizontal-stretch: 1;

                    VerticalLayout {
                        alignment: center;
                        Image {
                            width: 15px;
                            height: 15px;
                            source: @image-url("../assets/icons/check.svg");
                            colorize: Theme.status-success;
                            image-fit: contain;
                        }
                    }

                    VerticalLayout {
                        alignment: center;
                        horizontal-stretch: 1;
                        Text {
                            text: root.submit-status-text;
                            color: Theme.status-success;
                            font-size: 12px;
                            font-weight: 600;
                            vertical-alignment: center;
                            overflow: elide;
                        }
                    }
                }

                if (root.last-created-issue-url != "") : HorizontalLayout {
                    alignment: end;
                    VerticalLayout {
                        alignment: center;
                        SecondaryButton {
                            text: "Apri Issue creata ↗";
                            custom-height: 26px;
                            clicked => { root.open-issue-url(root.last-created-issue-url); }
                        }
                    }
                }
            }
        }

        // =====================================================================
        // BOTTOM ACTION ROW (Badge & Action Buttons)
        // =====================================================================
        HorizontalLayout {
            alignment: space-between;

            // Left Meta Badge
            HorizontalLayout {
                spacing: 8px;
                alignment: start;

                // Target badge
                Rectangle {
                    height: 32px;
                    y: (parent.height - self.height) / 2;
                    border-radius: Theme.radius-xs;
                    background: #11151f;
                    border-width: 1px;
                    border-color: Theme.border-subtle;

                    HorizontalLayout {
                        padding-left: 10px;
                        padding-right: 10px;
                        spacing: 6px;
                        alignment: center;

                        Text {
                            text: root.report-type == 0 ? "Target:" : "Ambiente:";
                            color: Theme.text-muted;
                            font-size: 11px;
                            font-weight: 500;
                            vertical-alignment: center;
                        }
                        Text {
                            text: root.report-type == 0 ?
                                (root.current-sound-file != "" ? root.current-sound-file : "Segnalazione generale") :
                                "WoW Forever (1.12.1) · AddOn v1.0.0";
                            color: Theme.gold-light;
                            font-size: 11px;
                            overflow: elide;
                            vertical-alignment: center;
                        }
                    }
                }
            }

            // Right Action Buttons Pair
            HorizontalLayout {
                spacing: 10px;
                alignment: end;

                SecondaryButton {
                    text: "Esporta Markdown (.md)";
                    icon: @image-url("../assets/icons/file-text.svg");
                    custom-height: 38px;
                    clicked => {
                        if (root.report-type == 0) {
                            root.export-report-md(
                                0,
                                root.current-audio-category,
                                root.current-dialogue-title,
                                root.audio-effective-description,
                                root.current-sound-file,
                                root.attachment-path
                            );
                        } else {
                            root.export-report-md(
                                1,
                                root.current-addon-category,
                                root.addon-title != "" ? root.addon-title : "Problema AddOn",
                                root.addon-description,
                                root.addon-repro-steps,
                                root.attachment-path
                            );
                        }
                    }
                }

                PrimaryButton {
                    text: root.has-github-token ? "Crea Issue su GitHub (API)" : "Crea Issue su GitHub";
                    icon: @image-url("../assets/icons/github.svg");
                    custom-height: 38px;
                    clicked => {
                        if (root.report-type == 0) {
                            root.create-github-issue(
                                0,
                                root.current-audio-category,
                                root.current-dialogue-title,
                                root.audio-effective-description,
                                root.current-sound-file,
                                root.attachment-path
                            );
                        } else {
                            root.create-github-issue(
                                1,
                                root.current-addon-category,
                                root.addon-title != "" ? root.addon-title : "Problema AddOn",
                                root.addon-description,
                                root.addon-repro-steps,
                                root.attachment-path
                            );
                        }
                    }
                }
            }
        }
    }
}
