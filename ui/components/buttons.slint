import { Theme } from "../theme.slint";

export component PrimaryButton inherits Rectangle {
    in-out property <string> text: "Pulsante";
    in-out property <image> icon;
    in-out property <bool> enabled: true;
    in-out property <length> custom-height: 44px;

    callback clicked();

    height: root.custom-height;
    border-radius: Theme.radius-md;
    clip: true;

    y: (touch.pressed && root.enabled) ? 1px : 0px;
    animate y { duration: Theme.transition-instant; easing: ease-out; }

    background: !root.enabled ? #1a202c : (touch.has-hover ? (touch.pressed ? Theme.btn-primary-pressed : Theme.btn-primary-hover) : Theme.btn-primary-bg);
    border-width: 1px;
    border-color: !root.enabled ? Theme.border-subtle : Theme.border-gold-normal;

    animate background { duration: Theme.transition-fast; easing: ease-out; }
    animate border-color { duration: Theme.transition-fast; easing: ease-out; }

    touch := TouchArea {
        enabled: root.enabled;
        mouse-cursor: root.enabled ? pointer : default;
        clicked => { root.clicked(); }
    }

    HorizontalLayout {
        alignment: center;
        spacing: 8px;

        if (root.icon.width > 0) : Image {
            source: root.icon;
            width: 16px;
            height: 16px;
            colorize: !root.enabled ? Theme.text-muted : Theme.btn-primary-text;
            image-fit: contain;
            vertical-alignment: center;
        }

        Text {
            text: root.text;
            color: !root.enabled ? Theme.text-muted : Theme.btn-primary-text;
            font-size: 14px;
            font-weight: 600;
            vertical-alignment: center;
        }
    }
}

export component SecondaryButton inherits Rectangle {
    in-out property <string> text: "Pulsante";
    in-out property <image> icon;
    in-out property <bool> enabled: true;
    in-out property <length> custom-height: 36px;

    callback clicked();

    height: root.custom-height;
    border-radius: Theme.radius-md;
    clip: true;

    y: (touch.pressed && root.enabled) ? 1px : 0px;
    animate y { duration: Theme.transition-instant; easing: ease-out; }

    background: !root.enabled ? #0f131a : (touch.has-hover ? (touch.pressed ? Theme.btn-secondary-pressed : Theme.btn-secondary-hover) : Theme.btn-secondary-bg);
    border-width: 1px;
    border-color: !root.enabled ? Theme.border-subtle : (touch.has-hover ? Theme.btn-secondary-border-hover : Theme.btn-secondary-border);

    animate background { duration: Theme.transition-fast; easing: ease-out; }
    animate border-color { duration: Theme.transition-fast; easing: ease-out; }

    touch := TouchArea {
        enabled: root.enabled;
        mouse-cursor: root.enabled ? pointer : default;
        clicked => { root.clicked(); }
    }

    HorizontalLayout {
        padding-left: 12px;
        padding-right: 12px;
        alignment: center;
        spacing: 7px;

        if (root.icon.width > 0) : Image {
            source: root.icon;
            width: 14px;
            height: 14px;
            colorize: !root.enabled ? Theme.text-muted : (touch.has-hover ? Theme.text-primary : Theme.text-secondary);
            image-fit: contain;
            vertical-alignment: center;
            animate colorize { duration: Theme.transition-fast; }
        }

        Text {
            text: root.text;
            color: !root.enabled ? Theme.text-muted : (touch.has-hover ? Theme.text-primary : Theme.text-secondary);
            font-size: 12px;
            font-weight: 500;
            vertical-alignment: center;
            animate color { duration: Theme.transition-fast; }
        }
    }
}

