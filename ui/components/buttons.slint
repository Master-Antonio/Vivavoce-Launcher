import { Theme } from "../theme.slint";

export component PrimaryButton inherits Rectangle {
    in-out property <string> text: "Pulsante";
    in-out property <string> icon: "";
    in-out property <bool> enabled: true;
    in-out property <length> custom-height: 48px;

    callback clicked();

    height: root.custom-height;
    border-radius: Theme.radius-md;
    clip: true;

    // Tactile micro-displacement on active/pressed
    y: (touch.pressed && root.enabled) ? 1.5px : 0px;
    animate y { duration: Theme.transition-instant; easing: ease-out; }

    background: !root.enabled ? #1e2430 : (touch.has-hover ? (touch.pressed ? Theme.gold-gradient-pressed : Theme.gold-gradient-hover) : Theme.gold-gradient);
    border-width: 1px;
    border-color: !root.enabled ? #141822 : (touch.has-hover ? Theme.border-gold-glow : Theme.border-gold-bright);

    animate background { duration: Theme.transition-fast; easing: ease-out; }
    animate border-color { duration: Theme.transition-fast; easing: ease-out; }

    // Top metallic specular reflection line
    Rectangle {
        x: 4px;
        y: 1px;
        width: parent.width - 8px;
        height: 1px;
        border-radius: 1px;
        background: !root.enabled ? #ffffff08 : (touch.pressed ? #ffffff18 : #ffffff50);
        animate background { duration: Theme.transition-instant; easing: ease-out; }
    }

    touch := TouchArea {
        enabled: root.enabled;
        mouse-cursor: root.enabled ? pointer : default;
        clicked => { root.clicked(); }
    }

    HorizontalLayout {
        alignment: center;
        spacing: 9px;

        if (root.icon != "") : Text {
            text: root.icon;
            font-size: 15px;
            vertical-alignment: center;
        }

        Text {
            text: root.text;
            color: !root.enabled ? Theme.text-muted : Theme.text-dark;
            font-size: 13px;
            font-weight: 800;
            letter-spacing: 0.5px;
            vertical-alignment: center;
        }
    }
}

export component SecondaryButton inherits Rectangle {
    in-out property <string> text: "Pulsante";
    in-out property <string> icon: "";
    in-out property <bool> enabled: true;
    in-out property <length> custom-height: 38px;

    callback clicked();

    height: root.custom-height;
    border-radius: Theme.radius-md;
    clip: true;

    // Tactile micro-displacement on active/pressed
    y: (touch.pressed && root.enabled) ? 1px : 0px;
    animate y { duration: Theme.transition-instant; easing: ease-out; }

    background: !root.enabled ? #10141e40 : (touch.has-hover ? (touch.pressed ? #222a3d : #182030) : #131824);
    border-width: 1px;
    border-color: !root.enabled ? Theme.border-subtle : (touch.has-hover ? Theme.border-gold-normal : Theme.border-normal);

    animate background { duration: Theme.transition-fast; easing: ease-out; }
    animate border-color { duration: Theme.transition-fast; easing: ease-out; }

    // Subtle top inner highlight bevel
    Rectangle {
        x: 4px;
        y: 1px;
        width: parent.width - 8px;
        height: 1px;
        background: #ffffff10;
    }

    touch := TouchArea {
        enabled: root.enabled;
        mouse-cursor: root.enabled ? pointer : default;
        clicked => { root.clicked(); }
    }

    HorizontalLayout {
        padding-left: 14px;
        padding-right: 14px;
        alignment: center;
        spacing: 8px;

        if (root.icon != "") : Text {
            text: root.icon;
            font-size: 13px;
            vertical-alignment: center;
        }

        Text {
            text: root.text;
            color: !root.enabled ? Theme.text-muted : (touch.has-hover ? Theme.gold-light : Theme.text-primary);
            font-size: 12px;
            font-weight: 600;
            vertical-alignment: center;

            animate color { duration: Theme.transition-fast; easing: ease-out; }
        }
    }
}

