import { Theme } from "../theme.slint";

export component PrimaryButton inherits Rectangle {
    in-out property <string> text: "Pulsante";
    in-out property <image> icon;
    in-out property <bool> enabled: true;
    in-out property <length> custom-height: 44px;
    in-out property <length> font-size: 14px;
    in-out property <int> font-weight: 600;

    callback clicked();

    height: root.custom-height;
    border-radius: Theme.radius-pill;
    clip: true;

    background: !root.enabled ? #161b26 : (touch.has-hover ? (touch.pressed ? Theme.btn-primary-pressed : Theme.btn-primary-hover) : Theme.btn-primary-bg);
    border-width: 1px;
    border-color: !root.enabled ? Theme.border-subtle : (touch.has-hover ? Theme.brand-hover : Theme.btn-primary-bg);

    animate background { duration: touch.pressed ? 60ms : 120ms; easing: ease-out; }
    animate border-color { duration: touch.pressed ? 60ms : 120ms; easing: ease-out; }

    touch := TouchArea {
        enabled: root.enabled;
        mouse-cursor: root.enabled ? pointer : default;
        clicked => { root.clicked(); }
    }

    HorizontalLayout {
        padding-left: 18px;
        padding-right: 18px;
        padding-top: (touch.pressed && root.enabled) ? 1px : 0px;
        alignment: center;
        spacing: (root.icon.width > 0) ? 8px : 0px;

        if (root.icon.width > 0) : VerticalLayout {
            alignment: center;
            Image {
                source: root.icon;
                width: 16px;
                height: 16px;
                colorize: !root.enabled ? Theme.text-muted : Theme.btn-primary-text;
                image-fit: contain;
                vertical-alignment: center;
            }
        }

        VerticalLayout {
            alignment: center;
            Text {
                text: root.text;
                color: !root.enabled ? Theme.text-muted : Theme.btn-primary-text;
                font-size: root.font-size;
                font-weight: root.font-weight;
                vertical-alignment: center;
            }
        }
    }
}

export component SecondaryButton inherits Rectangle {
    in-out property <string> text: "Pulsante";
    in-out property <image> icon;
    in-out property <bool> enabled: true;
    in-out property <length> custom-height: 38px;
    in-out property <length> font-size: 13px;
    in-out property <int> font-weight: 600;

    callback clicked();

    height: root.custom-height;
    border-radius: Theme.radius-pill;
    clip: true;

    background: !root.enabled ? #121622 : (touch.has-hover ? (touch.pressed ? Theme.btn-secondary-pressed : Theme.btn-secondary-hover) : Theme.btn-secondary-bg);
    border-width: 1px;
    border-color: !root.enabled ? Theme.border-subtle : (touch.has-hover ? Theme.btn-secondary-border-hover : Theme.btn-secondary-border);

    animate background { duration: touch.pressed ? 60ms : 120ms; easing: ease-out; }
    animate border-color { duration: touch.pressed ? 60ms : 120ms; easing: ease-out; }

    touch := TouchArea {
        enabled: root.enabled;
        mouse-cursor: root.enabled ? pointer : default;
        clicked => { root.clicked(); }
    }

    HorizontalLayout {
        padding-left: 16px;
        padding-right: 16px;
        padding-top: (touch.pressed && root.enabled) ? 1px : 0px;
        alignment: center;
        spacing: (root.icon.width > 0) ? 8px : 0px;

        if (root.icon.width > 0) : VerticalLayout {
            alignment: center;
            Image {
                source: root.icon;
                width: 15px;
                height: 15px;
                colorize: !root.enabled ? Theme.text-muted : (touch.has-hover ? Theme.btn-secondary-text-hover : Theme.btn-secondary-text);
                image-fit: contain;
                vertical-alignment: center;
                animate colorize { duration: Theme.transition-fast; }
            }
        }

        VerticalLayout {
            alignment: center;
            Text {
                text: root.text;
                color: !root.enabled ? Theme.text-muted : (touch.has-hover ? Theme.btn-secondary-text-hover : Theme.btn-secondary-text);
                font-size: root.font-size;
                font-weight: root.font-weight;
                vertical-alignment: center;
                animate color { duration: Theme.transition-fast; }
            }
        }
    }
}

