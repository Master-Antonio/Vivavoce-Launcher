import { Theme } from "../theme.slint";

export struct PackageInfo {
    id: string,
    name: string,
    description: string,
    filename: string,
    size-str: string,
    installed: bool,
    verified: bool,
    blake3-hash: string,
}

export component PackageCard inherits Rectangle {
    in-out property <PackageInfo> package-data;

    // Real native PNG AddOn Icon from textures
    private property <image> package-icon:
        root.package-data.id == "vivavoce-core" || root.package-data.id == "vivavoce_core" ? @image-url("../assets/core.png") :
        (root.package-data.id == "vivavoce-quests" || root.package-data.id == "vivavoce_quests" ? @image-url("../assets/quests.png") :
        (root.package-data.id == "vivavoce-books" || root.package-data.id == "vivavoce_books" ? @image-url("../assets/books.png") :
        (root.package-data.id == "vivavoce-codex" || root.package-data.id == "vivavoce_codex" ? @image-url("../assets/codex.png") :
        (root.package-data.id == "vivavoce-zones" || root.package-data.id == "vivavoce_zones" ? @image-url("../assets/zones.png") :
        (root.package-data.id == "vivavoce-collector" || root.package-data.id == "vivavoce_collector" ? @image-url("../assets/collector.png") :
        @image-url("../assets/logo.png"))))));

    height: 64px;
    background: p-touch.has-hover ? Theme.bg-card-hover : Theme.bg-card;
    border-radius: Theme.radius-md;
    border-width: 1px;
    border-color: p-touch.has-hover ? Theme.border-bright : Theme.border-normal;
    clip: true;

    animate background { duration: Theme.transition-fast; easing: ease-out; }
    animate border-color { duration: Theme.transition-fast; easing: ease-out; }

    p-touch := TouchArea {
        mouse-cursor: default;
    }

    HorizontalLayout {
        padding-left: 12px;
        padding-right: 14px;
        alignment: space-between;

        // Left Block: Official AddOn Texture Icon + Name / Description
        HorizontalLayout {
            spacing: 12px;
            alignment: start;

            // Module Icon Box with Real WoW Texture
            Rectangle {
                width: 40px;
                height: 40px;
                y: (parent.height - self.height) / 2;
                border-radius: Theme.radius-sm;
                background: #11151f;
                border-width: 1px;
                border-color: Theme.border-subtle;
                clip: true;

                Image {
                    width: 100%;
                    height: 100%;
                    source: root.package-icon;
                    image-fit: contain;
                }
            }

            // Text Info Block
            VerticalLayout {
                alignment: center;
                spacing: 2px;

                HorizontalLayout {
                    spacing: 8px;
                    alignment: start;

                    Text {
                        text: root.package-data.name;
                        color: Theme.text-primary;
                        font-size: 13px;
                        font-weight: 600;
                        vertical-alignment: center;
                    }

                    Text {
                        text: root.package-data.filename;
                        color: Theme.text-muted;
                        font-size: 11px;
                        font-weight: 400;
                        vertical-alignment: center;
                    }
                }

                Text {
                    text: root.package-data.description;
                    color: Theme.text-secondary;
                    font-size: 11px;
                    overflow: elide;
                    max-width: 440px;
                }
            }
        }

        // Right Block: Status Pill and Size (Single non-repetitive status line)
        HorizontalLayout {
            alignment: end;
            spacing: 8px;

            // Status Badge
            Rectangle {
                height: 22px;
                y: (parent.height - self.height) / 2;
                border-radius: Theme.radius-pill;
                background: root.package-data.verified ? Theme.status-success-bg :
                            (root.package-data.installed ? Theme.status-info-bg : #14182480);
                border-width: 1px;
                border-color: root.package-data.verified ? Theme.status-success-border :
                              (root.package-data.installed ? Theme.status-info-border : Theme.border-normal);

                HorizontalLayout {
                    padding-left: 8px;
                    padding-right: 8px;
                    spacing: 5px;
                    alignment: center;

                    Image {
                        width: 11px;
                        height: 11px;
                        source: root.package-data.verified ? @image-url("../assets/icons/check.svg") :
                                (root.package-data.installed ? @image-url("../assets/icons/clock.svg") : @image-url("../assets/icons/alert-circle.svg"));
                        colorize: root.package-data.verified ? Theme.status-success :
                                  (root.package-data.installed ? Theme.status-info : Theme.text-muted);
                        image-fit: contain;
                        vertical-alignment: center;
                    }

                    Text {
                        text: root.package-data.verified ? "File integro" :
                              (root.package-data.installed ? "Installato" : "Mancante");
                        color: root.package-data.verified ? Theme.status-success :
                               (root.package-data.installed ? Theme.status-info : Theme.text-muted);
                        font-size: 10px;
                        font-weight: 500;
                        vertical-alignment: center;
                    }
                }
            }

            // Size Badge
            Rectangle {
                height: 22px;
                y: (parent.height - self.height) / 2;
                background: #090c13;
                border-radius: Theme.radius-xs;
                border-width: 1px;
                border-color: Theme.border-subtle;

                HorizontalLayout {
                    padding-left: 7px;
                    padding-right: 7px;
                    alignment: center;

                    Text {
                        text: root.package-data.size-str;
                        color: Theme.text-secondary;
                        font-size: 10px;
                        font-weight: 500;
                        vertical-alignment: center;
                    }
                }
            }
        }
    }
}
