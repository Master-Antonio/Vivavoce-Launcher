import { Theme } from "../theme.slint";

export struct PackageInfo {
    id: string,
    name: string,
    description: string,
    filename: string,
    size-str: string,
    installed: bool,
    verified: bool,
    blake3-hash: string,
}

export component PackageCard inherits Rectangle {
    in-out property <PackageInfo> package-data;
    in-out property <string> icon: "📦";

    // Real native PNG AddOn Icon from K:\WoW\VivaVoce\pack\*\Textures\Icon.tga
    private property <image> package-icon:
        root.package-data.id == "vivavoce-core" || root.package-data.id == "vivavoce_core" ? @image-url("../assets/core.png") :
        (root.package-data.id == "vivavoce-quests" || root.package-data.id == "vivavoce_quests" ? @image-url("../assets/quests.png") :
        (root.package-data.id == "vivavoce-books" || root.package-data.id == "vivavoce_books" ? @image-url("../assets/books.png") :
        (root.package-data.id == "vivavoce-codex" || root.package-data.id == "vivavoce_codex" ? @image-url("../assets/codex.png") :
        (root.package-data.id == "vivavoce-zones" || root.package-data.id == "vivavoce_zones" ? @image-url("../assets/zones.png") :
        (root.package-data.id == "vivavoce-collector" || root.package-data.id == "vivavoce_collector" ? @image-url("../assets/collector.png") :
        @image-url("../assets/logo.png"))))));

    height: 70px;
    background: p-touch.has-hover ? Theme.bg-card-hover : Theme.bg-card;
    border-radius: Theme.radius-md;
    border-width: 1px;
    border-color: root.package-data.verified ? #1f3a2b : (p-touch.has-hover ? Theme.border-bright : Theme.border-normal);
    clip: true;

    x: p-touch.pressed ? 1px : 0px;
    animate x { duration: Theme.transition-instant; easing: ease-out; }
    animate background { duration: Theme.transition-fast; easing: ease-out; }
    animate border-color { duration: Theme.transition-fast; easing: ease-out; }

    p-touch := TouchArea {
        mouse-cursor: default;
    }

    // Top subtle 1px specular bevel
    Rectangle {
        x: 4px;
        y: 1px;
        width: parent.width - 8px;
        height: 1px;
        background: #ffffff0a;
    }

    HorizontalLayout {
        padding-left: 12px;
        padding-right: 12px;
        alignment: space-between;

        // Left Block: Official AddOn Icon + Name / Description
        HorizontalLayout {
            spacing: 12px;
            alignment: start;

            // Module Icon Box with Real WoW Texture
            Rectangle {
                width: 44px;
                height: 44px;
                y: (parent.height - self.height) / 2;
                border-radius: Theme.radius-sm;
                background: #11151f;
                border-width: 1px;
                border-color: Theme.border-subtle;
                clip: true;

                Image {
                    width: 100%;
                    height: 100%;
                    source: root.package-icon;
                    image-fit: contain;
                }
            }

            // Text Info Block
            VerticalLayout {
                alignment: center;
                spacing: 3px;

                HorizontalLayout {
                    spacing: 8px;
                    alignment: start;

                    Text {
                        text: root.package-data.name;
                        color: Theme.gold-light;
                        font-size: 13px;
                        font-weight: 700;
                        vertical-alignment: center;
                    }

                    Text {
                        text: root.package-data.filename;
                        color: Theme.text-muted;
                        font-size: 10px;
                        font-weight: 500;
                        vertical-alignment: center;
                    }
                }

                Text {
                    text: root.package-data.description;
                    color: Theme.text-secondary;
                    font-size: 11px;
                    overflow: elide;
                    max-width: 440px;
                }
            }
        }

        // Right Block: Status Badge + Integrità & Size Pills
        VerticalLayout {
            alignment: center;
            spacing: 5px;

            // Row 1: Status Badge (User-Friendly: File Integro)
            HorizontalLayout {
                alignment: end;
                spacing: 6px;

                if (root.package-data.verified) : Rectangle {
                    height: 20px;
                    border-radius: Theme.radius-pill;
                    background: Theme.status-success-bg;
                    border-width: 1px;
                    border-color: Theme.status-success-border;

                    HorizontalLayout {
                        padding-left: 7px;
                        padding-right: 7px;
                        Text {
                            text: "✓ File Integro";
                            color: Theme.status-success;
                            font-size: 10px;
                            font-weight: 700;
                            vertical-alignment: center;
                        }
                    }
                }

                if (!root.package-data.verified && root.package-data.installed) : Rectangle {
                    height: 20px;
                    border-radius: Theme.radius-pill;
                    background: Theme.status-info-bg;
                    border-width: 1px;
                    border-color: Theme.status-info-border;

                    HorizontalLayout {
                        padding-left: 7px;
                        padding-right: 7px;
                        Text {
                            text: "Installato";
                            color: Theme.status-info;
                            font-size: 10px;
                            font-weight: 600;
                            vertical-alignment: center;
                        }
                    }
                }

                if (!root.package-data.installed) : Rectangle {
                    height: 20px;
                    border-radius: Theme.radius-pill;
                    background: #1c223080;
                    border-width: 1px;
                    border-color: Theme.border-normal;

                    HorizontalLayout {
                        padding-left: 7px;
                        padding-right: 7px;
                        Text {
                            text: "Mancante";
                            color: Theme.text-muted;
                            font-size: 10px;
                            font-weight: 600;
                            vertical-alignment: center;
                        }
                    }
                }
            }

            // Row 2: Integrità Verificata & Size Pill
            HorizontalLayout {
                alignment: end;
                spacing: 8px;

                HorizontalLayout {
                    spacing: 4px;
                    alignment: center;

                    Text {
                        text: "Integrità:";
                        color: Theme.text-muted;
                        font-size: 10px;
                        font-weight: 600;
                        vertical-alignment: center;
                    }

                    Text {
                        text: root.package-data.verified ? "Verificata" : "Da verificare";
                        color: root.package-data.verified ? Theme.status-success : Theme.text-muted;
                        font-size: 10px;
                        vertical-alignment: center;
                    }
                }

                Rectangle {
                    height: 18px;
                    background: #090c13;
                    border-radius: Theme.radius-xs;
                    border-width: 1px;
                    border-color: Theme.border-subtle;

                    HorizontalLayout {
                        padding-left: 6px;
                        padding-right: 6px;
                        Text {
                            text: root.package-data.size-str;
                            color: Theme.gold-bright;
                            font-size: 10px;
                            font-weight: 600;
                            vertical-alignment: center;
                        }
                    }
                }
            }
        }
    }
}
