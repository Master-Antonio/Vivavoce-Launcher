import { Theme } from "../theme.slint";
import { PrimaryButton, SecondaryButton, DangerButton } from "buttons.slint";

export struct PackageInfo {
    id: string,
    name: string,
    description: string,
    filename: string,
    size-str: string,
    installed: bool,
    verified: bool,
    blake3-hash: string,
}

export component PackageCard inherits Rectangle {
    in-out property <PackageInfo> package-data;
    callback install-clicked(string);
    callback remove-clicked(string);

    // Real native PNG AddOn Icon from textures
    private property <image> package-icon:
        root.package-data.id == "vivavoce-core" || root.package-data.id == "vivavoce_core" ? @image-url("../assets/core.png") :
        (root.package-data.id == "vivavoce-quests" || root.package-data.id == "vivavoce_quests" ? @image-url("../assets/quests.png") :
        (root.package-data.id == "vivavoce-books" || root.package-data.id == "vivavoce_books" ? @image-url("../assets/books.png") :
        (root.package-data.id == "vivavoce-codex" || root.package-data.id == "vivavoce_codex" ? @image-url("../assets/codex.png") :
        (root.package-data.id == "vivavoce-zones" || root.package-data.id == "vivavoce_zones" ? @image-url("../assets/zones.png") :
        (root.package-data.id == "vivavoce-collector" || root.package-data.id == "vivavoce_collector" ? @image-url("../assets/collector.png") :
        @image-url("../assets/logo.png"))))));

    height: 72px;
    background: p-touch.has-hover ? Theme.bg-card-hover : Theme.bg-card;
    border-radius: Theme.radius-md;
    border-width: 1px;
    border-color: p-touch.has-hover ? Theme.border-bright : Theme.border-normal;
    clip: true;

    animate background { duration: Theme.transition-fast; easing: ease-out; }
    animate border-color { duration: Theme.transition-fast; easing: ease-out; }

    p-touch := TouchArea {
        mouse-cursor: default;
    }

    HorizontalLayout {
        padding-left: 14px;
        padding-right: 16px;
        alignment: space-between;

        // Left Block: Official AddOn Texture Icon + Name / Description
        HorizontalLayout {
            spacing: 14px;
            alignment: start;

            // Module Icon Box with Real WoW Texture
            Rectangle {
                width: 46px;
                height: 46px;
                y: (parent.height - self.height) / 2;
                border-radius: Theme.radius-sm;
                background: #11151f;
                border-width: 1px;
                border-color: Theme.border-subtle;
                clip: true;

                Image {
                    width: 100%;
                    height: 100%;
                    source: root.package-icon;
                    image-fit: contain;
                }
            }

            // Text Info Block
            VerticalLayout {
                alignment: center;
                spacing: 3px;

                HorizontalLayout {
                    spacing: 8px;
                    alignment: start;

                    Text {
                        text: root.package-data.name;
                        color: Theme.text-primary;
                        font-size: 15px;
                        font-weight: 600;
                        vertical-alignment: center;
                    }

                    Text {
                        text: root.package-data.filename;
                        color: Theme.text-muted;
                        font-size: 12px;
                        font-weight: 400;
                        vertical-alignment: center;
                    }
                }

                Text {
                    text: root.package-data.description;
                    color: Theme.text-secondary;
                    font-size: 13px;
                    overflow: elide;
                    max-width: 520px;
                }
            }
        }

        // Right Block: Status Pill, Size, and Action Button
        HorizontalLayout {
            alignment: end;
            spacing: 10px;

            // Status Badge
            Rectangle {
                height: 28px;
                y: (parent.height - self.height) / 2;
                border-radius: Theme.radius-pill;
                background: root.package-data.installed ? Theme.status-success-bg : #14182480;
                border-width: 1px;
                border-color: root.package-data.installed ? Theme.status-success-border : Theme.border-normal;

                HorizontalLayout {
                    padding-left: 10px;
                    padding-right: 10px;
                    spacing: 6px;
                    alignment: center;

                    VerticalLayout {
                        alignment: center;
                        Image {
                            width: 12px;
                            height: 12px;
                            source: root.package-data.installed ? @image-url("../assets/icons/check.svg") : @image-url("../assets/icons/alert-circle.svg");
                            colorize: root.package-data.installed ? Theme.status-success : Theme.text-muted;
                            image-fit: contain;
                        }
                    }

                    VerticalLayout {
                        alignment: center;
                        Text {
                            text: root.package-data.installed ? "Installato" : "Non installato";
                            color: root.package-data.installed ? Theme.status-success : Theme.text-muted;
                            font-size: 11px;
                            font-weight: 500;
                        }
                    }
                }
            }

            // Size Badge
            Rectangle {
                height: 28px;
                y: (parent.height - self.height) / 2;
                background: #090c13;
                border-radius: Theme.radius-xs;
                border-width: 1px;
                border-color: Theme.border-subtle;

                HorizontalLayout {
                    padding-left: 8px;
                    padding-right: 8px;
                    alignment: center;

                    VerticalLayout {
                        alignment: center;
                        Text {
                            text: root.package-data.size-str;
                            color: Theme.text-secondary;
                            font-size: 11px;
                            font-weight: 500;
                        }
                    }
                }
            }

            // Action Button
            if root.package-data.installed : DangerButton {
                text: "Rimuovi";
                icon: @image-url("../assets/icons/trash-2.svg");
                custom-height: 28px;
                y: (parent.height - self.height) / 2;
                clicked => { root.remove-clicked(root.package-data.id); }
            }

            if !root.package-data.installed : SecondaryButton {
                text: "Installa";
                icon: @image-url("../assets/icons/download.svg");
                custom-height: 28px;
                y: (parent.height - self.height) / 2;
                clicked => { root.install-clicked(root.package-data.id); }
            }
        }
    }
}
