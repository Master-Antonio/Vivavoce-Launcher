import { Theme } from "../theme.slint";

export component ProgressBar inherits VerticalLayout {
    in-out property <float> progress: 0.0; // 0.0 to 1.0
    in-out property <string> title: "Avanzamento";
    in-out property <string> details: "";
    in-out property <bool> is-active: false;

    spacing: 6px;

    // Header: Operation Title and Percentage
    HorizontalLayout {
        alignment: space-between;

        Text {
            text: root.title;
            color: Theme.text-primary;
            font-size: 12px;
            font-weight: 500;
            vertical-alignment: center;
        }

        Text {
            text: Math.round(Math.max(0.0, Math.min(1.0, root.progress)) * 100) + "%";
            color: root.is-active ? Theme.gold-light : Theme.text-secondary;
            font-size: 12px;
            font-weight: 600;
            vertical-alignment: center;
        }
    }

    // Progress Bar Track (Slim pill modern design)
    Rectangle {
        height: 6px;
        border-radius: Theme.radius-pill;
        background: Theme.bg-inset;
        border-width: 1px;
        border-color: root.is-active ? Theme.border-gold-subtle : Theme.border-normal;
        clip: true;

        animate border-color { duration: Theme.transition-normal; easing: ease-out; }

        // Progress Fill Bar
        Rectangle {
            x: 0;
            y: 0;
            height: parent.height;
            width: Math.max(0px, Math.min(parent.width, parent.width * root.progress));
            border-radius: Theme.radius-pill;
            background: Theme.progress-fill;

            animate width { duration: 160ms; easing: ease-out; }
        }
    }

    // Footer: Detailed transfer statistics
    if (root.details != "") : HorizontalLayout {
        alignment: space-between;

        Text {
            text: root.details;
            color: Theme.text-secondary;
            font-size: 11px;
            font-weight: 400;
            vertical-alignment: center;
        }
    }
}
