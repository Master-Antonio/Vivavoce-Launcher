import { Theme } from "../theme.slint";

export component TitleBar inherits Rectangle {
    in-out property <bool> is-maximized: false;

    callback minimize-clicked();
    callback maximize-clicked();
    callback close-clicked();
    callback drag-window();

    height: 36px;
    background: transparent;

    // Draggable window area covering the non-button space
    drag-touch := TouchArea {
        width: parent.width - 120px;
        height: parent.height;
        x: 0;
        y: 0;
        mouse-cursor: default;

        pointer-event(event) => {
            if (event.kind == PointerEventKind.down && event.button == PointerEventButton.left) {
                root.drag-window();
            }
        }
    }

    HorizontalLayout {
        padding-left: 14px;
        padding-right: 12px;
        alignment: end;

        // Window Controls (Right side: Minimize, Maximize/Restore, Close)
        HorizontalLayout {
            spacing: 4px;
            alignment: end;

            // Minimize Button
            Rectangle {
                width: 30px;
                height: 26px;
                y: (parent.height - self.height) / 2;
                border-radius: Theme.radius-xs;
                background: min-touch.has-hover ? (min-touch.pressed ? #1c2333 : #141a26) : transparent;

                animate background { duration: Theme.transition-fast; easing: ease-out; }

                min-touch := TouchArea {
                    mouse-cursor: pointer;
                    clicked => { root.minimize-clicked(); }
                }

                Image {
                    width: 13px;
                    height: 13px;
                    source: @image-url("../assets/icons/minus.svg");
                    colorize: min-touch.has-hover ? Theme.text-primary : Theme.text-secondary;
                    image-fit: contain;
                    x: (parent.width - self.width) / 2;
                    y: (parent.height - self.height) / 2;
                    animate colorize { duration: Theme.transition-fast; }
                }
            }

            // Maximize / Restore Button
            Rectangle {
                width: 30px;
                height: 26px;
                y: (parent.height - self.height) / 2;
                border-radius: Theme.radius-xs;
                background: max-touch.has-hover ? (max-touch.pressed ? #1c2333 : #141a26) : transparent;

                animate background { duration: Theme.transition-fast; easing: ease-out; }

                max-touch := TouchArea {
                    mouse-cursor: pointer;
                    clicked => { root.maximize-clicked(); }
                }

                Image {
                    width: 12px;
                    height: 12px;
                    source: root.is-maximized ? @image-url("../assets/icons/copy.svg") : @image-url("../assets/icons/square.svg");
                    colorize: max-touch.has-hover ? Theme.text-primary : Theme.text-secondary;
                    image-fit: contain;
                    x: (parent.width - self.width) / 2;
                    y: (parent.height - self.height) / 2;
                    animate colorize { duration: Theme.transition-fast; }
                }
            }

            // Close Button
            Rectangle {
                width: 30px;
                height: 26px;
                y: (parent.height - self.height) / 2;
                border-radius: Theme.radius-xs;
                background: close-touch.has-hover ? (close-touch.pressed ? #7f1d1d : #ef444422) : transparent;

                animate background { duration: Theme.transition-fast; easing: ease-out; }

                close-touch := TouchArea {
                    mouse-cursor: pointer;
                    clicked => { root.close-clicked(); }
                }

                Image {
                    width: 13px;
                    height: 13px;
                    source: @image-url("../assets/icons/x.svg");
                    colorize: close-touch.has-hover ? #fca5a5 : Theme.text-secondary;
                    image-fit: contain;
                    x: (parent.width - self.width) / 2;
                    y: (parent.height - self.height) / 2;
                    animate colorize { duration: Theme.transition-fast; }
                }
            }
        }
    }
}
