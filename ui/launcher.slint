                                                            color: root.selected-wallpaper == 0 ? Theme.brand-light : Theme.text-muted;
                                                            font-size: Theme.font-size-xs;
                                                        }
                                                    }
                                                }
                                            }

                                            // Wallpaper 1: Dun Morogh Shaman
                                            Rectangle {
