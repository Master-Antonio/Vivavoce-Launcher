import { Theme } from "theme.slint";
import { TitleBar } from "components/titlebar.slint";
import { ProgressBar } from "components/progress_bar.slint";
import { StatusBadge } from "components/status_badge.slint";
import { BugCard, DialogueEntry } from "components/bug_card.slint";
import { PackageCard, PackageInfo } from "components/package_card.slint";
import { PrimaryButton, SecondaryButton, DangerButton } from "components/buttons.slint";
import { ScrollView } from "std-widgets.slint";

export { DialogueEntry, PackageInfo }

export component MainWindow inherits Window {
    title: "VivaVoce — WoW Forever Voiceover Launcher";
    icon: @image-url("assets/logo.png");
    min-width: 980px;
    min-height: 640px;
    preferred-width: 1180px;
    preferred-height: 760px;
    default-font-family: "Segoe UI, -apple-system, BlinkMacSystemFont, sans-serif";
    no-frame: true;
    background: transparent;

    // === REACTIVE PROPERTIES EXPOSED TO RUST ===
    in-out property <bool> is-maximized: false;
    in-out property <float> progress: 0.0;
    in-out property <string> status-text: "Pronto";
    in-out property <string> sub_status_text: "";
    in-out property <bool> is-updating: false;
    in-out property <string> wow-path: "";
    in-out property <string> wow-path-input: "";
    in-out property <string> wow-flavor: "WoW Forever";
    in-out property <bool> is-installed: false;
    in-out property <bool> has-update: false;
    in-out property <string> installed-version: "";
    in-out property <string> remote-version: "1.0.0";
    in-out property <int> active-tab: 0; // 0: Dashboard, 1: Pacchetti, 2: Bug Report, 3: Impostazioni
    in-out property <int> selected-wallpaper <=> Theme.active-theme; // 0: campfire/Teldrassil, 1: shaman/Dun Morogh, 2: landscape/Mulgore, 3: elves/Ashenvale

    // GitHub automated issue & bug reporter reactive state
    in-out property <string> github-token: "";
    in-out property <string> bug-submit-status: "";
    in-out property <string> last-created-issue-url: "";
    in-out property <string> bug-attachment-path: "";
    in-out property <string> bug-attachment-filename: "";

    // Launcher self-updater reactive state
    in-out property <string> launcher-version: "0.5.0";
    in-out property <bool> launcher-has-update: false;
    in-out property <string> launcher-new-version: "";
    in-out property <bool> launcher-is-updating: false;
    in-out property <string> launcher-update-status: "";
    in-out property <float> launcher-update-progress: 0.0;

    // Data models
    in-out property <[DialogueEntry]> recent-dialogues: [];
    in-out property <[PackageInfo]> packages: [];

    // === CALLBACKS EXPOSED TO RUST ===
    callback start-update();
    callback start-repair();
    callback start-uninstall();
    callback submit-bug-report(int /* type: 0=audio, 1=addon, 2=launcher */, string /* category */, string /* title */, string /* description */, string /* extra */, string /* attachment_path */);
    callback create-github-issue(int /* type: 0=audio, 1=addon, 2=launcher */, string /* category */, string /* title */, string /* description */, string /* extra */, string /* attachment_path */);
    callback select-bug-attachment();
    callback reveal-bug-attachment();
    callback select-wow-folder();
    callback select-wow-file();
    callback set-custom-wow-path(string);
    callback launch-game();
    callback close-window();
    callback minimize-window();
    callback maximize-window();
    callback resize-window();
    callback set-window-size(int /* width */, int /* height */);
    callback open-url(string);
    callback open-addons-folder();
    callback drag-window();
    callback install-module(string);
    callback remove-module(string);
    callback check-launcher-update();
    callback perform-launcher-update();

    // Main App Shell
    Rectangle {
        width: 100%;
        height: 100%;
        border-radius: root.is-maximized ? 0px : Theme.radius-lg;
        background: Theme.main-window-gradient;
        border-width: 1px;
        border-color: Theme.border-normal;
        clip: true;

        // Main Application Body: Left Sidebar (Full 100% Height) + Right View
        HorizontalLayout {
            width: 100%;
            height: 100%;

            // === SLIM ICON DOCK / RAIL NAVIGATION (LEFT BORDER, ~76px) ===
            sidebar := Rectangle {
                width: 76px;
                height: 100%;
                background: Theme.bg-sidebar;

                // Draggable region at top of sidebar
                TouchArea {
                    x: 0;
                    y: 0;
                    width: parent.width;
                    height: 24px;
                    mouse-cursor: default;
                    pointer-event(event) => {
                        if (event.kind == PointerEventKind.down && event.button == PointerEventButton.left) {
                            root.drag-window();
                        }
                    }
                }

                // Subtle right separator line
                Rectangle {
                    x: parent.width - 1px;
                    width: 1px;
                    height: parent.height;
                    background: Theme.border-subtle;
                }

                VerticalLayout {
                    width: 100%;
                    height: 100%;
                    padding-top: 14px;
                    padding-bottom: 14px;
                    alignment: space-between;

                    // IN ALTO: Logo VivaVoce (Box con spade bianche di VivaVoce)
                    HorizontalLayout {
                        alignment: center;
                        Rectangle {
                            width: 40px;
                            height: 40px;
                            border-radius: 12px;
                            background: Theme.brand-primary;
                            clip: true;

                            logo-touch := TouchArea {
                                mouse-cursor: pointer;
                                clicked => { root.open-url("https://discord.gg/EAwNYqs3Ra"); }
                            }

                            Image {
                                width: 22px;
                                height: 22px;
                                source: @image-url("assets/icons/swords.svg");
                                colorize: #ffffff;
                                image-fit: contain;
                                x: (parent.width - self.width) / 2;
                                y: (parent.height - self.height) / 2;
                            }
                        }
                    }

                    // AL CENTRO: Capsule / Floating Dock verticale (larghezza 52px, sfondo #0a0d13, bordo #1c2333, border-radius pill 26px, padding verticale 8px, spacing 6px)
                    HorizontalLayout {
                        alignment: center;
                        Rectangle {
                            width: 52px;
                            border-radius: 26px;
                            background: #0a0d13;
                            border-width: 1px;
                            border-color: #1c2333;

                            VerticalLayout {
                                padding-top: 8px;
                                padding-bottom: 8px;
                                padding-left: 6px;
                                padding-right: 6px;
                                spacing: 6px;
                                alignment: center;

                                // Tab 0: Dashboard / Game Home
                                Rectangle {
                                    width: 40px;
                                    height: 40px;
                                    border-radius: Theme.radius-pill;
                                    background: root.active-tab == 0 ? Theme.brand-primary : (t0-touch.has-hover ? #1c2333 : transparent);
                                    animate background { duration: Theme.transition-fast; easing: ease-out; }

                                    t0-touch := TouchArea {
                                        mouse-cursor: pointer;
                                        clicked => { root.active-tab = 0; }
                                    }

                                    Image {
                                        width: 20px;
                                        height: 20px;
                                        source: @image-url("assets/icons/dashboard.svg");
                                        colorize: root.active-tab == 0 ? #ffffff : (t0-touch.has-hover ? #f2f3f5 : Theme.text-secondary);
                                        image-fit: contain;
                                        x: (parent.width - self.width) / 2;
                                        y: (parent.height - self.height) / 2;
                                        animate colorize { duration: Theme.transition-fast; }
                                    }
                                }

                                // Tab 1: Moduli / Pacchetti
                                Rectangle {
                                    width: 40px;
                                    height: 40px;
                                    border-radius: Theme.radius-pill;
                                    background: root.active-tab == 1 ? Theme.brand-primary : (t1-touch.has-hover ? #1c2333 : transparent);
                                    animate background { duration: Theme.transition-fast; easing: ease-out; }

                                    t1-touch := TouchArea {
                                        mouse-cursor: pointer;
                                        clicked => { root.active-tab = 1; }
                                    }

                                    Image {
                                        width: 20px;
                                        height: 20px;
                                        source: @image-url("assets/icons/package.svg");
                                        colorize: root.active-tab == 1 ? #ffffff : (t1-touch.has-hover ? #f2f3f5 : Theme.text-secondary);
                                        image-fit: contain;
                                        x: (parent.width - self.width) / 2;
                                        y: (parent.height - self.height) / 2;
                                        animate colorize { duration: Theme.transition-fast; }
                                    }
                                }

                                // Tab 2: Segnalazioni Bug
                                Rectangle {
                                    width: 40px;
                                    height: 40px;
                                    border-radius: Theme.radius-pill;
                                    background: root.active-tab == 2 ? Theme.brand-primary : (t2-touch.has-hover ? #1c2333 : transparent);
                                    animate background { duration: Theme.transition-fast; easing: ease-out; }

                                    t2-touch := TouchArea {
                                        mouse-cursor: pointer;
                                        clicked => { root.active-tab = 2; }
                                    }

                                    Image {
                                        width: 20px;
                                        height: 20px;
                                        source: @image-url("assets/icons/bug.svg");
                                        colorize: root.active-tab == 2 ? #ffffff : (t2-touch.has-hover ? #f2f3f5 : Theme.text-secondary);
                                        image-fit: contain;
                                        x: (parent.width - self.width) / 2;
                                        y: (parent.height - self.height) / 2;
                                        animate colorize { duration: Theme.transition-fast; }
                                    }
                                }

                                // Tab 3: Impostazioni
                                Rectangle {
                                    width: 40px;
                                    height: 40px;
                                    border-radius: Theme.radius-pill;
                                    background: root.active-tab == 3 ? Theme.brand-primary : (t3-touch.has-hover ? #1c2333 : transparent);
                                    animate background { duration: Theme.transition-fast; easing: ease-out; }

                                    t3-touch := TouchArea {
                                        mouse-cursor: pointer;
                                        clicked => { root.active-tab = 3; }
                                    }

                                    Image {
                                        width: 20px;
                                        height: 20px;
                                        source: @image-url("assets/icons/settings.svg");
                                        colorize: root.active-tab == 3 ? #ffffff : (t3-touch.has-hover ? #f2f3f5 : Theme.text-secondary);
                                        image-fit: contain;
                                        x: (parent.width - self.width) / 2;
                                        y: (parent.height - self.height) / 2;
                                        animate colorize { duration: Theme.transition-fast; }
                                    }
                                }
                            }
                        }
                    }

                    // IN BASSO: Tasti Discord e GitHub
                    HorizontalLayout {
                        alignment: center;
                        VerticalLayout {
                            spacing: 8px;
                            alignment: center;

                            // Tasto Discord
                            Rectangle {
                                width: 38px;
                                height: 38px;
                                border-radius: 12px;
                                background: d-touch.has-hover ? #1c2333 : #161b26;
                                border-width: 1px;
                                border-color: d-touch.has-hover ? Theme.border-blurple-normal : #283347;

                                animate background { duration: Theme.transition-fast; easing: ease-out; }
                                animate border-color { duration: Theme.transition-fast; easing: ease-out; }

                                d-touch := TouchArea {
                                    mouse-cursor: pointer;
                                    clicked => { root.open-url("https://discord.gg/EAwNYqs3Ra"); }
                                }

                                Image {
                                    width: 18px;
                                    height: 18px;
                                    source: @image-url("assets/icons/discord.svg");
                                    colorize: d-touch.has-hover ? Theme.brand-primary : Theme.text-secondary;
                                    image-fit: contain;
                                    x: (parent.width - self.width) / 2;
                                    y: (parent.height - self.height) / 2;
                                    animate colorize { duration: Theme.transition-fast; }
                                }
                            }

                            // Tasto GitHub
                            Rectangle {
                                width: 38px;
                                height: 38px;
                                border-radius: 12px;
                                background: g-touch.has-hover ? #1c2333 : #161b26;
                                border-width: 1px;
                                border-color: g-touch.has-hover ? #3d4d6b : #283347;

                                animate background { duration: Theme.transition-fast; easing: ease-out; }
                                animate border-color { duration: Theme.transition-fast; easing: ease-out; }

                                g-touch := TouchArea {
                                    mouse-cursor: pointer;
                                    clicked => { root.open-url("https://github.com/Master-Antonio/Vivavoce-Releases"); }
                                }

                                Image {
                                    width: 18px;
                                    height: 18px;
                                    source: @image-url("assets/icons/github.svg");
                                    colorize: g-touch.has-hover ? #ffffff : Theme.text-secondary;
                                    image-fit: contain;
                                    x: (parent.width - self.width) / 2;
                                    y: (parent.height - self.height) / 2;
                                    animate colorize { duration: Theme.transition-fast; }
                                }
                            }
                        }
                    }
                }
            }

            // === RIGHT MAIN VIEW (Native TitleBar at top + Content View below) ===
            VerticalLayout {
                horizontal-stretch: 1;
                height: 100%;

                // Top Native TitleBar spanning only the right content column
                TitleBar {
                    is-maximized: root.is-maximized;
                    minimize-clicked => { root.minimize-window(); }
                    maximize-clicked => { root.maximize-window(); }
                    close-clicked => { root.close-window(); }
                    drag-window => { root.drag-window(); }
                }

                // === RIGHT MAIN CONTENT VIEW ===
                Rectangle {
                    background: transparent;
                    height: 100%;
                    vertical-stretch: 1;

                    VerticalLayout {
                        width: 100%;
                        height: 100%;
                        padding-left: 28px;
                        padding-right: 28px;
                        padding-top: 10px;
                        padding-bottom: 20px;

                        // ==========================================
                        // TAB 0: DASHBOARD - CINEMATIC HERO & TELEMETRY
                        // ==========================================
                        if (root.active-tab == 0) : ScrollView {
                            vertical-stretch: 1;
                            height: 100%;

                            VerticalLayout {
                                padding-right: 6px;
                                spacing: 14px;
                                alignment: start;

                                // Launcher Self-Update Banner (When GitHub Release is detected)
                                if (root.launcher-has-update || root.launcher-is-updating) : Rectangle {
                                    height: 56px;
                                    border-radius: Theme.radius-md;
                                    background: #161b26;
                                    border-width: 1px;
                                    border-color: root.launcher-is-updating ? Theme.status-info : Theme.brand-primary;
                                    clip: true;

                                    HorizontalLayout {
                                        padding-left: 16px;
                                        padding-right: 16px;
                                        alignment: space-between;

                                        HorizontalLayout {
                                            spacing: 12px;
                                            alignment: center;

                                            Image {
                                                width: 20px;
                                                height: 20px;
                                                source: @image-url("assets/icons/zap.svg");
                                                colorize: Theme.brand-primary;
                                                image-fit: contain;
                                            }

                                            VerticalLayout {
                                                spacing: 2px;
                                                alignment: center;

                                                Text {
                                                    text: root.launcher-is-updating ?
                                                        root.launcher-update-status :
                                                        ("Nuova versione di VivaVoce Launcher disponibile: v" + root.launcher-new-version);
                                                    color: Theme.text-primary;
                                                    font-size: 13px;
                                                    font-weight: 600;
                                                    vertical-alignment: center;
                                                }
                                                if (!root.launcher-is-updating) : Text {
                                                    text: "Aggiorna subito con 1 click per ottenere le ultime migliorie e correzioni.";
                                                    color: Theme.text-secondary;
                                                    font-size: 11px;
                                                }
                                            }
                                        }

                                        VerticalLayout {
                                            alignment: center;
                                            if (!root.launcher-is-updating) : PrimaryButton {
                                                text: "Aggiorna Launcher";
                                                icon: @image-url("assets/icons/download.svg");
                                                custom-height: 34px;
                                                clicked => { root.perform-launcher-update(); }
                                            }
                                            if (root.launcher-is-updating) : Rectangle {
                                                width: 180px;
                                                height: 12px;
                                                border-radius: 6px;
                                                background: #0a0d13;
                                                clip: true;
                                                Rectangle {
                                                    x: 0;
                                                    y: 0;
                                                    width: parent.width * root.launcher-update-progress;
                                                    height: 100%;
                                                    border-radius: 6px;
                                                    background: Theme.brand-primary;
                                                }
                                            }
                                        }
                                    }
                                }

                                // ==========================================
                                // HERO STAGE CINEMATOGRAFICO (~330px)
                                // ==========================================
                                Rectangle {
                                    height: 330px;
                                    border-radius: Theme.radius-lg;
                                    background: #0b0e14;
                                    border-width: 1px;
                                    border-color: Theme.border-normal;
                                    clip: true;

                                    // Sfondo reattivo wallpaper WoW (Default: Campfire notturno Teldrassil)
                                    Image {
                                        width: 100%;
                                        height: 100%;
                                        source: root.selected-wallpaper == 1 ? @image-url("assets/wallpapers/wp-shaman.jpg") : (root.selected-wallpaper == 2 ? @image-url("assets/wallpapers/wp-landscape.jpg") : (root.selected-wallpaper == 3 ? @image-url("assets/wallpapers/wp-elves.jpg") : @image-url("assets/wallpapers/wp-campfire.jpg")));
                                        image-fit: cover;
                                        opacity: 0.52;
                                    }

                                    // Gradiente scuro orizzontale
                                    Rectangle {
                                        width: 100%;
                                        height: 100%;
                                        background: @linear-gradient(90deg, #0b0e14 0%, #0b0e14f0 45%, #0b0e144d 100%);
                                    }

                                    // Gradiente scuro verticale
                                    Rectangle {
                                        width: 100%;
                                        height: 100%;
                                        background: @linear-gradient(180deg, #0b0e1414 0%, #0b0e14cc 100%);
                                    }

                                    // Contenuto in primo piano (sinistra)
                                    VerticalLayout {
                                        padding-left: 32px;
                                        padding-right: 32px;
                                        padding-top: 26px;
                                        padding-bottom: 26px;
                                        alignment: space-between;

                                        // Top Block: Tag Pillola + Live Status + Titolo Epico + Descrizione Chiara
                                        VerticalLayout {
                                            spacing: 12px;
                                            alignment: start;

                                            HorizontalLayout {
                                                alignment: space-between;

                                                // Tag Pillola: WOW FOREVER · DOPPIAGGIO NATIVO (Icona SVG Zap)
                                                Rectangle {
                                                    height: 26px;
                                                    border-radius: Theme.radius-pill;
                                                    background: Theme.status-info-bg;
                                                    border-width: 1px;
                                                    border-color: Theme.border-blurple-subtle;

                                                    HorizontalLayout {
                                                        padding-left: 10px;
                                                        padding-right: 12px;
                                                        spacing: 6px;
                                                        alignment: center;

                                                        VerticalLayout {
                                                            alignment: center;
                                                            Image {
                                                                source: @image-url("assets/icons/zap.svg");
                                                                width: 13px;
                                                                height: 13px;
                                                                colorize: Theme.brand-light;
                                                                image-fit: contain;
                                                                vertical-alignment: center;
                                                            }
                                                        }

                                                        VerticalLayout {
                                                            alignment: center;
                                                            Text {
                                                                text: "WOW FOREVER · DOPPIAGGIO NATIVO";
                                                                color: Theme.brand-light;
                                                                font-size: Theme.font-size-xs;
                                                                font-weight: 700;
                                                                letter-spacing: 0.5px;
                                                                vertical-alignment: center;
                                                            }
                                                        }
                                                    }
                                                }

                                                // Live StatusBadge in alto a destra
                                                StatusBadge {
                                                    is-installed: root.is-installed;
                                                    has-update: root.has-update;
                                                    is-verifying: root.is-updating;
                                                    installed-version: root.installed-version;
                                                }
                                            }

                                            // Titolo Epico
                                            // Riga 1: "WORLD OF WARCRAFT" (13px, font-weight 700, colore Theme.text-secondary)
                                            // Riga 2: "FOREVER" (34px, font-weight 900, colore Theme.text-primary bianco nitido)
                                            VerticalLayout {
                                                spacing: 2px;
                                                alignment: start;
                                                Text {
                                                    text: "WORLD OF WARCRAFT";
                                                    color: Theme.text-secondary;
                                                    font-size: 13px;
                                                    font-weight: 700;
                                                    letter-spacing: 1.5px;
                                                }
                                                Text {
                                                    text: "FOREVER";
                                                    color: #ffffff;
                                                    font-size: 34px;
                                                    font-weight: 900;
                                                    letter-spacing: 1px;
                                                }
                                            }

                                            // Descrizione Chiara
                                            Text {
                                                text: "Oltre 27.000 battute vocali recitate per dialoghi NPC, gossip, tomi lore e quest di Azeroth in italiano.";
                                                color: Theme.text-secondary;
                                                font-size: 13px;
                                                max-width: 560px;
                                            }
                                        }

                                        // Grand Action Bar (Pill Buttons) o Avanzamento Aggiornamento
                                        if (root.is-updating) : VerticalLayout {
                                            spacing: 8px;
                                            alignment: center;
                                            ProgressBar {
                                                progress: root.progress;
                                                title: root.status-text;
                                                details: root.sub_status_text;
                                                is-active: true;
                                            }
                                        }

                                        if (!root.is-updating) : HorizontalLayout {
                                            spacing: 14px;
                                            alignment: start;

                                            // Grand Primary Pill: 48px, 230px, radius-pill, Blurple #5865F2, 15px 700 bianco
                                            PrimaryButton {
                                                width: 230px;
                                                custom-height: 48px;
                                                font-size: 15px;
                                                font-weight: 700;
                                                text: !root.is-installed ? "Installa VivaVoce" : (root.has-update ? ("Aggiorna a v" + root.remote-version) : "Avvia WoW Forever");
                                                icon: !root.is-installed ? @image-url("assets/icons/download.svg") : (root.has-update ? @image-url("assets/icons/refresh-cw.svg") : @image-url("assets/icons/play.svg"));
                                                clicked => {
                                                    if (!root.is-installed || root.has-update) {
                                                        root.start-update();
                                                    } else {
                                                        root.launch-game();
                                                    }
                                                }
                                            }

                                            // Secondary Pill: 48px, 150px, #1e2535, bordo #323f57, "Verifica file", wrench
                                            if (root.is-installed) : SecondaryButton {
                                                width: 150px;
                                                custom-height: 48px;
                                                font-size: 14px;
                                                font-weight: 600;
                                                text: "Verifica file";
                                                icon: @image-url("assets/icons/wrench.svg");
                                                clicked => { root.start-repair(); }
                                            }

                                            // Client Status Pill: 34px, pill #0a0d13, bordo #283347, dot verde #23a55a
                                            VerticalLayout {
                                                alignment: center;
                                                Rectangle {
                                                    height: 34px;
                                                    border-radius: Theme.radius-pill;
                                                    background: #0a0d13;
                                                    border-width: 1px;
                                                    border-color: #283347;

                                                    HorizontalLayout {
                                                        padding-left: 14px;
                                                        padding-right: 14px;
                                                        spacing: 8px;
                                                        alignment: center;

                                                        Rectangle {
                                                            width: 8px;
                                                            height: 8px;
                                                            border-radius: 4px;
                                                            background: #23a55a;
                                                            y: (parent.height - self.height) / 2;
                                                        }

                                                        Text {
                                                            text: "Client WoW Forever Rilevato";
                                                            color: Theme.text-primary;
                                                            font-size: 12px;
                                                            font-weight: 500;
                                                            vertical-alignment: center;
                                                        }
                                                    }
                                                }
                                            }
                                        }
                                    }
                                }

                                // ==========================================
                                // 4 FLOATING METRIC & TELEMETRY WIDGETS ROW (~96px)
                                // ==========================================
                                HorizontalLayout {
                                    spacing: 12px;
                                    height: 96px;

                                    // Widget 1: Battute Sincronizzate + LoL Equalizer
                                    w1 := Rectangle {
                                        horizontal-stretch: 1;
                                        height: 96px;
                                        border-radius: Theme.radius-lg;
                                        background: w1-touch.has-hover ? #1c2333 : #161b26;
                                        border-width: 1px;
                                        border-color: w1-touch.has-hover ? #3d4d6b : #283347;
                                        animate background { duration: Theme.transition-fast; }
                                        animate border-color { duration: Theme.transition-fast; }

                                        w1-touch := TouchArea {}

                                        VerticalLayout {
                                            padding-left: 14px;
                                            padding-right: 14px;
                                            padding-top: 12px;
                                            padding-bottom: 12px;
                                            alignment: space-between;

                                            // Header con mic.svg in brand color + "Battute Sincronizzate"
                                            HorizontalLayout {
                                                spacing: 6px;
                                                alignment: start;
                                                Image {
                                                    width: 14px;
                                                    height: 14px;
                                                    source: @image-url("assets/icons/mic.svg");
                                                    colorize: Theme.brand-primary;
                                                    image-fit: contain;
                                                    vertical-alignment: center;
                                                }
                                                Text {
                                                    text: "Battute Sincronizzate";
                                                    color: Theme.text-secondary;
                                                    font-size: Theme.font-size-xs;
                                                    font-weight: 600;
                                                    vertical-alignment: center;
                                                }
                                            }

                                            // Valore 27.420 + Equalizzatore grafico LoL (7 barre: 4, 10, 16, 12, 6, 14, 8px)
                                            HorizontalLayout {
                                                alignment: space-between;

                                                VerticalLayout {
                                                    alignment: center;
                                                    Text {
                                                        text: "27.420";
                                                        color: #ffffff;
                                                        font-size: 22px;
                                                        font-weight: 700;
                                                    }
                                                }

                                                VerticalLayout {
                                                    alignment: center;
                                                    HorizontalLayout {
                                                        spacing: 3px;
                                                        alignment: end;
                                                        height: 18px;

                                                        VerticalLayout { alignment: end; Rectangle { width: 3px; height: 4px; border-radius: 1.5px; background: Theme.brand-primary; } }
                                                        VerticalLayout { alignment: end; Rectangle { width: 3px; height: 10px; border-radius: 1.5px; background: Theme.brand-primary; } }
                                                        VerticalLayout { alignment: end; Rectangle { width: 3px; height: 16px; border-radius: 1.5px; background: Theme.brand-primary; } }
                                                        VerticalLayout { alignment: end; Rectangle { width: 3px; height: 12px; border-radius: 1.5px; background: Theme.brand-primary; } }
                                                        VerticalLayout { alignment: end; Rectangle { width: 3px; height: 6px; border-radius: 1.5px; background: Theme.brand-primary; } }
                                                        VerticalLayout { alignment: end; Rectangle { width: 3px; height: 14px; border-radius: 1.5px; background: Theme.brand-primary; } }
                                                        VerticalLayout { alignment: end; Rectangle { width: 3px; height: 8px; border-radius: 1.5px; background: Theme.brand-primary; } }
                                                    }
                                                }
                                            }

                                            Text {
                                                text: "Audio OGG Vorbis 48 kHz";
                                                color: Theme.text-muted;
                                                font-size: Theme.font-size-xs;
                                            }
                                        }
                                    }

                                    // Widget 2: Contenuti Lore + Badge pillola "100% In-Game"
                                    w2 := Rectangle {
                                        horizontal-stretch: 1;
                                        height: 96px;
                                        border-radius: Theme.radius-lg;
                                        background: w2-touch.has-hover ? #1c2333 : #161b26;
                                        border-width: 1px;
                                        border-color: w2-touch.has-hover ? #3d4d6b : #283347;
                                        animate background { duration: Theme.transition-fast; }
                                        animate border-color { duration: Theme.transition-fast; }

                                        w2-touch := TouchArea {}

                                        VerticalLayout {
                                            padding-left: 14px;
                                            padding-right: 14px;
                                            padding-top: 12px;
                                            padding-bottom: 12px;
                                            alignment: space-between;

                                            // Header con book-open.svg in brand color + "Contenuti Lore"
                                            HorizontalLayout {
                                                spacing: 6px;
                                                alignment: start;
                                                Image {
                                                    width: 14px;
                                                    height: 14px;
                                                    source: @image-url("assets/icons/book-open.svg");
                                                    colorize: Theme.brand-primary;
                                                    image-fit: contain;
                                                    vertical-alignment: center;
                                                }
                                                Text {
                                                    text: "Contenuti Lore";
                                                    color: Theme.text-secondary;
                                                    font-size: Theme.font-size-xs;
                                                    font-weight: 600;
                                                    vertical-alignment: center;
                                                }
                                            }

                                            // Valore 2.500+ + Badge con dot verde
                                            HorizontalLayout {
                                                alignment: space-between;

                                                VerticalLayout {
                                                    alignment: center;
                                                    Text {
                                                        text: "2.500+";
                                                        color: #ffffff;
                                                        font-size: 22px;
                                                        font-weight: 700;
                                                    }
                                                }

                                                VerticalLayout {
                                                    alignment: center;
                                                    Rectangle {
                                                        height: 20px;
                                                        border-radius: Theme.radius-pill;
                                                        background: #23a55a18;
                                                        border-width: 1px;
                                                        border-color: #23a55a40;

                                                        HorizontalLayout {
                                                            padding-left: 6px;
                                                            padding-right: 8px;
                                                            spacing: 4px;
                                                            alignment: center;

                                                            Rectangle {
                                                                width: 5px;
                                                                height: 5px;
                                                                border-radius: 2.5px;
                                                                background: #23a55a;
                                                                y: (parent.height - self.height) / 2;
                                                            }

                                                            Text {
                                                                text: "100% In-Game";
                                                                color: #23a55a;
                                                                font-size: Theme.font-size-xs;
                                                                font-weight: 600;
                                                                vertical-alignment: center;
                                                            }
                                                        }
                                                    }
                                                }
                                            }

                                            Text {
                                                text: "Quest, NPC & Gossip";
                                                color: Theme.text-muted;
                                                font-size: Theme.font-size-xs;
                                            }
                                        }
                                    }

                                    // Widget 3: Integrità AddOn + Badge "BLAKE3 Verificato"
                                    w3 := Rectangle {
                                        horizontal-stretch: 1;
                                        height: 96px;
                                        border-radius: Theme.radius-lg;
                                        background: w3-touch.has-hover ? #1c2333 : #161b26;
                                        border-width: 1px;
                                        border-color: w3-touch.has-hover ? #3d4d6b : #283347;
                                        animate background { duration: Theme.transition-fast; }
                                        animate border-color { duration: Theme.transition-fast; }

                                        w3-touch := TouchArea {}

                                        VerticalLayout {
                                            padding-left: 14px;
                                            padding-right: 14px;
                                            padding-top: 12px;
                                            padding-bottom: 12px;
                                            alignment: space-between;

                                            // Header con shield-check.svg in Emerald #23a55a + "Stato Moduli"
                                            HorizontalLayout {
                                                spacing: 6px;
                                                alignment: start;
                                                Image {
                                                    width: 14px;
                                                    height: 14px;
                                                    source: @image-url("assets/icons/shield-check.svg");
                                                    colorize: #23a55a;
                                                    image-fit: contain;
                                                    vertical-alignment: center;
                                                }
                                                Text {
                                                    text: "Stato Moduli";
                                                    color: Theme.text-secondary;
                                                    font-size: Theme.font-size-xs;
                                                    font-weight: 600;
                                                    vertical-alignment: center;
                                                }
                                            }

                                            // Valore 6 / 6 + Badge BLAKE3 Verificato
                                            HorizontalLayout {
                                                alignment: space-between;

                                                VerticalLayout {
                                                    alignment: center;
                                                    Text {
                                                        text: "6 / 6";
                                                        color: #ffffff;
                                                        font-size: 22px;
                                                        font-weight: 700;
                                                    }
                                                }

                                                VerticalLayout {
                                                    alignment: center;
                                                    Rectangle {
                                                        height: 20px;
                                                        border-radius: Theme.radius-pill;
                                                        background: Theme.status-info-bg;
                                                        border-width: 1px;
                                                        border-color: Theme.border-blurple-subtle;

                                                        HorizontalLayout {
                                                            padding-left: 6px;
                                                            padding-right: 6px;
                                                            alignment: center;

                                                            Text {
                                                                text: "BLAKE3 Verificato";
                                                                color: Theme.brand-light;
                                                                font-size: Theme.font-size-xs;
                                                                font-weight: 600;
                                                                vertical-alignment: center;
                                                            }
                                                        }
                                                    }
                                                }
                                            }

                                            Text {
                                                text: "Pacchetti audio integri";
                                                color: Theme.text-muted;
                                                font-size: Theme.font-size-xs;
                                            }
                                        }
                                    }

                                    // Widget 4: Cartella di Gioco & AddOns
                                    w4 := Rectangle {
                                        horizontal-stretch: 1.35;
                                        height: 96px;
                                        border-radius: Theme.radius-lg;
                                        background: w4-touch.has-hover ? #1c2333 : #161b26;
                                        border-width: 1px;
                                        border-color: w4-touch.has-hover ? #3d4d6b : #283347;
                                        animate background { duration: Theme.transition-fast; }
                                        animate border-color { duration: Theme.transition-fast; }

                                        w4-touch := TouchArea {}

                                        VerticalLayout {
                                            padding-left: 14px;
                                            padding-right: 14px;
                                            padding-top: 10px;
                                            padding-bottom: 10px;
                                            alignment: space-between;

                                            // Header con folder.svg + "WoW Forever Path"
                                            HorizontalLayout {
                                                spacing: 6px;
                                                alignment: start;
                                                Image {
                                                    width: 14px;
                                                    height: 14px;
                                                    source: @image-url("assets/icons/folder.svg");
                                                    colorize: Theme.brand-primary;
                                                    image-fit: contain;
                                                    vertical-alignment: center;
                                                }
                                                Text {
                                                    text: "WoW Forever Path";
                                                    color: Theme.text-secondary;
                                                    font-size: Theme.font-size-xs;
                                                    font-weight: 600;
                                                    vertical-alignment: center;
                                                }
                                            }

                                            // Percorso sintetico o placeholder
                                            HorizontalLayout {
                                                alignment: start;
                                                Text {
                                                    text: root.wow-path != "" ? root.wow-path : "Percorso non rilevato";
                                                    color: root.wow-path != "" ? Theme.text-primary : Theme.text-muted;
                                                    font-size: Theme.font-size-xs;
                                                    overflow: elide;
                                                    vertical-alignment: center;
                                                }
                                            }

                                            // Due mini pill buttons: [ Sfoglia… ] e [ Apri AddOns ]
                                            HorizontalLayout {
                                                spacing: 8px;
                                                alignment: start;

                                                // Mini Pill 1: Sfoglia…
                                                Rectangle {
                                                    height: 28px;
                                                    border-radius: Theme.radius-pill;
                                                    background: sfoglia-touch.has-hover ? #283347 : #1e2535;
                                                    border-width: 1px;
                                                    border-color: sfoglia-touch.has-hover ? #495b7d : #323f57;
                                                    animate background { duration: Theme.transition-fast; }
                                                    animate border-color { duration: Theme.transition-fast; }

                                                    sfoglia-touch := TouchArea {
                                                        mouse-cursor: pointer;
                                                        clicked => { root.select-wow-folder(); }
                                                    }

                                                    HorizontalLayout {
                                                        padding-left: 12px;
                                                        padding-right: 12px;
                                                        spacing: 6px;
                                                        alignment: center;
                                                        VerticalLayout {
                                                            alignment: center;
                                                            Image {
                                                                width: 13px;
                                                                height: 13px;
                                                                source: @image-url("assets/icons/folder.svg");
                                                                colorize: sfoglia-touch.has-hover ? #ffffff : Theme.text-secondary;
                                                                image-fit: contain;
                                                                vertical-alignment: center;
                                                            }
                                                        }
                                                        VerticalLayout {
                                                            alignment: center;
                                                            Text {
                                                                text: "Sfoglia…";
                                                                color: sfoglia-touch.has-hover ? #ffffff : Theme.text-secondary;
                                                                font-size: Theme.font-size-xs;
                                                                font-weight: 600;
                                                                vertical-alignment: center;
                                                            }
                                                        }
                                                    }
                                                }

                                                // Mini Pill 2: Apri AddOns
                                                Rectangle {
                                                    height: 28px;
                                                    border-radius: Theme.radius-pill;
                                                    background: addons-touch.has-hover ? #283347 : #1e2535;
                                                    border-width: 1px;
                                                    border-color: addons-touch.has-hover ? #495b7d : #323f57;
                                                    animate background { duration: Theme.transition-fast; }
                                                    animate border-color { duration: Theme.transition-fast; }

                                                    addons-touch := TouchArea {
                                                        mouse-cursor: pointer;
                                                        clicked => { root.open-addons-folder(); }
                                                    }

                                                    HorizontalLayout {
                                                        padding-left: 12px;
                                                        padding-right: 12px;
                                                        spacing: 6px;
                                                        alignment: center;
                                                        VerticalLayout {
                                                            alignment: center;
                                                            Image {
                                                                width: 13px;
                                                                height: 13px;
                                                                source: @image-url("assets/icons/folder-open.svg");
                                                                colorize: addons-touch.has-hover ? #ffffff : Theme.text-secondary;
                                                                image-fit: contain;
                                                                vertical-alignment: center;
                                                            }
                                                        }
                                                        VerticalLayout {
                                                            alignment: center;
                                                            Text {
                                                                text: "Apri AddOns";
                                                                color: addons-touch.has-hover ? #ffffff : Theme.text-secondary;
                                                                font-size: Theme.font-size-xs;
                                                                font-weight: 600;
                                                                vertical-alignment: center;
                                                            }
                                                        }
                                                    }
                                                }
                                            }
                                        }
                                    }
                                }
                            }
                        }

                        // ==========================================
                        // TAB 1: MODULI INSTALLATI - GAMING LIBRARY STYLE
                        // ==========================================
                        if (root.active-tab == 1) : VerticalLayout {
                            vertical-stretch: 1;
                            height: 100%;
                            spacing: 14px;

                            // Tab Header Gaming Library Style
                            HorizontalLayout {
                                alignment: space-between;

                                VerticalLayout {
                                    spacing: 3px;
                                    alignment: center;
                                    Text {
                                        text: "Libreria Moduli Audio";
                                        color: #ffffff;
                                        font-size: 22px;
                                        font-weight: 700;
                                    }
                                    Text {
                                        text: "World of Warcraft: Forever — Pacchetti vocali neurali OGG Vorbis 48 kHz";
                                        color: Theme.text-secondary;
                                        font-size: 13px;
                                    }
                                }

                                VerticalLayout {
                                    alignment: center;
                                    HorizontalLayout {
                                        spacing: 10px;

                                        SecondaryButton {
                                            text: "Verifica integrità";
                                            icon: @image-url("assets/icons/wrench.svg");
                                            custom-height: 36px;
                                            clicked => { root.start-repair(); }
                                        }

                                        SecondaryButton {
                                            text: "Cartella AddOns";
                                            icon: @image-url("assets/icons/folder-open.svg");
                                            custom-height: 36px;
                                            clicked => { root.open-addons-folder(); }
                                        }
                                    }
                                }
                            }

                            // Telemetry Summary Strip (3 KPI Cards compatte)
                            HorizontalLayout {
                                spacing: 12px;
                                height: 60px;

                                // KPI 1: Battute Vocali
                                Rectangle {
                                    horizontal-stretch: 1;
                                    height: 60px;
                                    background: #161b26;
                                    border-radius: Theme.radius-md;
                                    border-width: 1px;
                                    border-color: Theme.border-normal;

                                    HorizontalLayout {
                                        padding-left: 14px;
                                        padding-right: 14px;
                                        spacing: 12px;
                                        alignment: start;

                                        VerticalLayout {
                                            alignment: center;
                                            Rectangle {
                                                width: 36px;
                                                height: 36px;
                                                border-radius: Theme.radius-pill;
                                                background: Theme.status-info-bg;
                                                border-width: 1px;
                                                border-color: Theme.border-blurple-subtle;

                                                Image {
                                                    source: @image-url("assets/icons/mic.svg");
                                                    width: 16px;
                                                    height: 16px;
                                                    colorize: Theme.brand-primary;
                                                    image-fit: contain;
                                                    x: (parent.width - self.width) / 2;
                                                    y: (parent.height - self.height) / 2;
                                                }
                                            }
                                        }

                                        VerticalLayout {
                                            alignment: center;
                                            spacing: 2px;
                                            Text {
                                                text: "27.420";
                                                color: #ffffff;
                                                font-size: 17px;
                                                font-weight: 700;
                                            }
                                            Text {
                                                text: "Battute Vocali Sincronizzate";
                                                color: Theme.text-secondary;
                                                font-size: Theme.font-size-xs;
                                                font-weight: 500;
                                            }
                                        }
                                    }
                                }

                                // KPI 2: Missioni & Tomi Lore
                                Rectangle {
                                    horizontal-stretch: 1;
                                    height: 60px;
                                    background: #161b26;
                                    border-radius: Theme.radius-md;
                                    border-width: 1px;
                                    border-color: Theme.border-normal;

                                    HorizontalLayout {
                                        padding-left: 14px;
                                        padding-right: 14px;
                                        spacing: 12px;
                                        alignment: start;

                                        VerticalLayout {
                                            alignment: center;
                                            Rectangle {
                                                width: 36px;
                                                height: 36px;
                                                border-radius: Theme.radius-pill;
                                                background: Theme.status-info-bg;
                                                border-width: 1px;
                                                border-color: Theme.border-blurple-subtle;

                                                Image {
                                                    source: @image-url("assets/icons/book-open.svg");
                                                    width: 16px;
                                                    height: 16px;
                                                    colorize: Theme.brand-primary;
                                                    image-fit: contain;
                                                    x: (parent.width - self.width) / 2;
                                                    y: (parent.height - self.height) / 2;
                                                }
                                            }
                                        }

                                        VerticalLayout {
                                            alignment: center;
                                            spacing: 2px;
                                            Text {
                                                text: "2.500+";
                                                color: #ffffff;
                                                font-size: 17px;
                                                font-weight: 700;
                                            }
                                            Text {
                                                text: "Missioni & Tomi Lore";
                                                color: Theme.text-secondary;
                                                font-size: Theme.font-size-xs;
                                                font-weight: 500;
                                            }
                                        }
                                    }
                                }

                                // KPI 3: Moduli Attivi & BLAKE3 Verificati (Smeraldo)
                                Rectangle {
                                    horizontal-stretch: 1;
                                    height: 60px;
                                    background: #161b26;
                                    border-radius: Theme.radius-md;
                                    border-width: 1px;
                                    border-color: Theme.border-normal;

                                    HorizontalLayout {
                                        padding-left: 14px;
                                        padding-right: 14px;
                                        spacing: 12px;
                                        alignment: start;

                                        VerticalLayout {
                                            alignment: center;
                                            Rectangle {
                                                width: 36px;
                                                height: 36px;
                                                border-radius: Theme.radius-pill;
                                                background: #23a55a18;
                                                border-width: 1px;
                                                border-color: #23a55a40;

                                                Image {
                                                    source: @image-url("assets/icons/shield-check.svg");
                                                    width: 16px;
                                                    height: 16px;
                                                    colorize: #23a55a;
                                                    image-fit: contain;
                                                    x: (parent.width - self.width) / 2;
                                                    y: (parent.height - self.height) / 2;
                                                }
                                            }
                                        }

                                        VerticalLayout {
                                            alignment: center;
                                            spacing: 2px;
                                            Text {
                                                text: "6 / 6";
                                                color: #23a55a;
                                                font-size: 17px;
                                                font-weight: 700;
                                            }
                                            Text {
                                                text: "Moduli Attivi & BLAKE3 Verificati";
                                                color: Theme.text-secondary;
                                                font-size: 11px;
                                                font-weight: 500;
                                            }
                                        }
                                    }
                                }
                            }

                            // Loading / Updating Progress Banner in Tab 1
                            if (root.is-updating) : Rectangle {
                                height: 56px;
                                background: #161b26;
                                border-radius: Theme.radius-md;
                                border-width: 1px;
                                border-color: Theme.brand-primary;

                                HorizontalLayout {
                                    padding-left: 16px;
                                    padding-right: 16px;
                                    alignment: space-between;

                                    HorizontalLayout {
                                        spacing: 12px;
                                        alignment: start;

                                        VerticalLayout {
                                            alignment: center;
                                            Image {
                                                width: 20px;
                                                height: 20px;
                                                source: @image-url("assets/icons/refresh-cw.svg");
                                                colorize: Theme.brand-primary;
                                                image-fit: contain;
                                            }
                                        }

                                        VerticalLayout {
                                            alignment: center;
                                            spacing: 2px;

                                            Text {
                                                text: root.status-text;
                                                color: Theme.brand-light;
                                                font-size: 13px;
                                                font-weight: 600;
                                            }

                                            Text {
                                                text: root.sub_status_text != "" ? root.sub_status_text : "Operazione sul pacchetto in corso...";
                                                color: Theme.text-secondary;
                                                font-size: 11px;
                                            }
                                        }
                                    }

                                    VerticalLayout {
                                        alignment: center;
                                        Rectangle {
                                            width: 140px;
                                            height: 6px;
                                            background: #0a0d13;
                                            border-radius: Theme.radius-pill;
                                            clip: true;

                                            Rectangle {
                                                x: 0;
                                                width: root.progress > 0 ? parent.width * root.progress : parent.width * 0.35;
                                                height: 100%;
                                                background: Theme.brand-primary;
                                                border-radius: Theme.radius-pill;
                                                animate width { duration: 160ms; easing: ease-out; }
                                            }
                                        }
                                    }
                                }
                            }

                            // Dynamic scrollable list of modules (Full height container showing all 6 modules)
                            ScrollView {
                                vertical-stretch: 1;
                                VerticalLayout {
                                    spacing: 12px;
                                    padding-top: 16px;
                                    padding-right: 22px;
                                    padding-bottom: 32px;
                                    alignment: start;

                                    // Dynamic packages from Rust
                                    for pkg in root.packages : PackageCard {
                                        package-data: pkg;
                                        is-busy: root.is-updating;
                                        install-clicked(id) => { root.install-module(id); }
                                        remove-clicked(id) => { root.remove-module(id); }
                                    }

                                    // Fallback when packages list is empty
                                    if (root.packages.length == 0) : VerticalLayout {
                                        spacing: 10px;

                                        PackageCard {
                                            package-data: {
                                                id: "vivavoce-core",
                                                name: "VivaVoce Core",
                                                description: "Motore audio principale, gestione code, sottotitoli e opzioni in-game",
                                                filename: "vivavoce-core.tar.zst",
                                                size-str: "865 KB",
                                                installed: root.is-installed,
                                                verified: root.is-installed,
                                                blake3-hash: "b3f8...91a2"
                                            };
                                            is-busy: root.is-updating;
                                            install-clicked(id) => { root.install-module(id); }
                                            remove-clicked(id) => { root.remove-module(id); }
                                        }

                                        PackageCard {
                                            package-data: {
                                                id: "vivavoce-quests",
                                                name: "VivaVoce Quests",
                                                description: "15.838 battute: dialoghi quest, gossip NPC, accettazione e completamento",
                                                filename: "vivavoce-quests.tar.zst",
                                                size-str: "2.48 GB",
                                                installed: root.is-installed,
                                                verified: root.is-installed,
                                                blake3-hash: "7c2d...4401"
                                            };
                                            is-busy: root.is-updating;
                                            install-clicked(id) => { root.install-module(id); }
                                            remove-clicked(id) => { root.remove-module(id); }
                                        }

                                        PackageCard {
                                            package-data: {
                                                id: "vivavoce-books",
                                                name: "VivaVoce Books",
                                                description: "5.594 battute: tomi di Azeroth, lettere, diari, pergamene e lapidi",
                                                filename: "vivavoce-books.tar.zst",
                                                size-str: "1.10 GB",
                                                installed: root.is-installed,
                                                verified: root.is-installed,
                                                blake3-hash: "33aa...ff99"
                                            };
                                            is-busy: root.is-updating;
                                            install-clicked(id) => { root.install-module(id); }
                                            remove-clicked(id) => { root.remove-module(id); }
                                        }

                                        PackageCard {
                                            package-data: {
                                                id: "vivavoce-codex",
                                                name: "VivaVoce Codex",
                                                description: "1.606 battute: supporto a CodexIT e missioni lore classiche",
                                                filename: "vivavoce-codex.tar.zst",
                                                size-str: "385 MB",
                                                installed: root.is-installed,
                                                verified: root.is-installed,
                                                blake3-hash: "19e0...8821"
                                            };
                                            is-busy: root.is-updating;
                                            install-clicked(id) => { root.install-module(id); }
                                            remove-clicked(id) => { root.remove-module(id); }
                                        }

                                        PackageCard {
                                            package-data: {
                                                id: "vivavoce-zones",
                                                name: "VivaVoce Zones",
                                                description: "Annunci e tracce d'atmosfera delle zone del mondo",
                                                filename: "vivavoce-zones.tar.zst",
                                                size-str: "120 MB",
                                                installed: root.is-installed,
                                                verified: root.is-installed,
                                                blake3-hash: "4fa1...bb12"
                                            };
                                            is-busy: root.is-updating;
                                            install-clicked(id) => { root.install-module(id); }
                                            remove-clicked(id) => { root.remove-module(id); }
                                        }

                                        PackageCard {
                                            package-data: {
                                                id: "vivavoce-collector",
                                                name: "VivaVoce Collector",
                                                description: "Registratore SavedVariables per report di bug e pronunce in-game",
                                                filename: "vivavoce-collector.tar.zst",
                                                size-str: "15 KB",
                                                installed: root.is-installed,
                                                verified: root.is-installed,
                                                blake3-hash: "6c9d...ff51"
                                            };
                                            is-busy: root.is-updating;
                                            install-clicked(id) => { root.install-module(id); }
                                            remove-clicked(id) => { root.remove-module(id); }
                                        }
                                    }
                                }
                            }
                        }

                        // ==========================================
                        // TAB 2: SEGNALA BUG (Audio & AddOn)
                        // ==========================================
                        if (root.active-tab == 2) : ScrollView {
                            vertical-stretch: 1;
                            height: 100%;
                            VerticalLayout {
                                padding-right: 24px;
                                padding-bottom: 40px;
                                BugCard {
                                    width: 100%;
                                    recent-dialogues: root.recent-dialogues;
                                    submit-status-text: root.bug-submit-status;
                                    last-created-issue-url: root.last-created-issue-url;
                                    has-github-token: root.github-token != "";
                                    attachment-path <=> root.bug-attachment-path;
                                    attachment-filename <=> root.bug-attachment-filename;

                                    select-attachment => {
                                        root.select-bug-attachment();
                                    }

                                    reveal-attachment => {
                                        root.reveal-bug-attachment();
                                    }

                                    remove-attachment => {
                                        root.bug-attachment-path = "";
                                        root.bug-attachment-filename = "";
                                    }

                                    create-github-issue(rtype, cat, title, desc, extra, attach) => {
                                        root.create-github-issue(rtype, cat, title, desc, extra, attach);
                                    }

                                    export-report-md(rtype, cat, title, desc, extra, attach) => {
                                        root.submit-bug-report(rtype, cat, title, desc, extra, attach);
                                    }

                                    open-issue-url(url) => {
                                        root.open-url(url);
                                    }
                                }
                            }
                        }

                        // ==========================================
                        // TAB 3: IMPOSTAZIONI - AAA GAMING PREFERENCES
                        // ==========================================
                        if (root.active-tab == 3) : ScrollView {
                            vertical-stretch: 1;
                            height: 100%;
                            VerticalLayout {
                                padding-right: 6px;
                                padding-bottom: 40px;
                                spacing: 14px;
                                alignment: start;

                                // Settings Header
                                VerticalLayout {
                                    spacing: 4px;
                                    Text {
                                        text: "Impostazioni";
                                        color: #ffffff;
                                        font-size: 22px;
                                        font-weight: 700;
                                    }
                                    Text {
                                        text: "Personalizzazione visuale, cartella di gioco, risoluzione finestra e manutenzione.";
                                        color: Theme.text-secondary;
                                        font-size: 13px;
                                    }
                                }

                                // ==========================================
                                // SEZIONE 1: AGGIORNAMENTI LAUNCHER (IN CIMA - PRIORITÀ MASSIMA)
                                // ==========================================
                                Rectangle {
                                    border-radius: Theme.radius-md;
                                    background: Theme.bg-card;
                                    border-width: root.launcher-has-update ? 2px : 1px;
                                    border-color: root.launcher-has-update ? Theme.brand-primary : Theme.border-normal;

                                    VerticalLayout {
                                        padding: 16px;
                                        spacing: 14px;

                                        HorizontalLayout {
                                            alignment: space-between;

                                            VerticalLayout {
                                                spacing: 4px;
                                                alignment: center;

                                                HorizontalLayout {
                                                    spacing: 8px;
                                                    alignment: start;
                                                    Text {
                                                        text: "VivaVoce Launcher";
                                                        color: Theme.text-primary;
                                                        font-size: 14px;
                                                        font-weight: 700;
                                                        vertical-alignment: center;
                                                    }
                                                    Rectangle {
                                                        height: 20px;
                                                        border-radius: Theme.radius-pill;
                                                        background: #1e2535;
                                                        border-width: 1px;
                                                        border-color: Theme.border-subtle;
                                                        HorizontalLayout {
                                                            padding-left: 8px;
                                                            padding-right: 8px;
                                                            Text {
                                                                text: "v" + root.launcher-version;
                                                                color: Theme.brand-light;
                                                                font-size: 11px;
                                                                font-weight: 700;
                                                                vertical-alignment: center;
                                                            }
                                                        }
                                                    }
                                                }

                                                Text {
                                                    text: root.launcher-is-updating ?
                                                        root.launcher-update-status :
                                                        (root.launcher-has-update ? ("Nuova versione v" + root.launcher-new-version + " disponibile!") : "Il launcher è aggiornato all'ultima versione stabile.");
                                                    color: root.launcher-has-update ? Theme.brand-light : Theme.text-secondary;
                                                    font-size: 12px;
                                                }
                                            }

                                            HorizontalLayout {
                                                spacing: 10px;
                                                alignment: center;

                                                if (!root.launcher-is-updating && !root.launcher-has-update) : SecondaryButton {
                                                    text: "Verifica aggiornamenti";
                                                    icon: @image-url("assets/icons/refresh-cw.svg");
                                                    custom-height: 36px;
                                                    clicked => { root.check-launcher-update(); }
                                                }

                                                if (!root.launcher-is-updating && root.launcher-has-update) : PrimaryButton {
                                                    text: "Aggiorna ora";
                                                    icon: @image-url("assets/icons/download.svg");
                                                    custom-height: 36px;
                                                    clicked => { root.perform-launcher-update(); }
                                                }

                                                if (root.launcher-is-updating) : Rectangle {
                                                    width: 160px;
                                                    height: 10px;
                                                    border-radius: 5px;
                                                    background: #0a0d13;
                                                    clip: true;
                                                    Rectangle {
                                                        x: 0;
                                                        y: 0;
                                                        width: parent.width * root.launcher-update-progress;
                                                        height: 100%;
                                                        border-radius: 5px;
                                                        background: Theme.brand-primary;
                                                    }
                                                }
                                            }
                                        }
                                    }
                                }

                                // ==========================================
                                // SEZIONE 2: PERSONALIZZAZIONE VISUALE & WALLPAPER HOME
                                // ==========================================
                                Rectangle {
                                    border-radius: Theme.radius-md;
