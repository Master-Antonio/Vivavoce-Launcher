                                                    font-size: 14px;
                                                    font-weight: 600;
                                                }
                                                Text {
                                                    text: "Seleziona l'artwork epico di World of Warcraft visualizzato nella Hero Card della schermata principale.";
                                                    color: Theme.text-secondary;
                                                    font-size: 12px;
                                                }
                                            }
                                        }

                                        HorizontalLayout {
                                            spacing: 10px;
                                            height: 84px;

                                            // Wallpaper 0: Campfire Night
                                            Rectangle {
                                                horizontal-stretch: 1;
                                                height: 84px;
                                                border-radius: Theme.radius-md;
                                                background: root.selected-wallpaper == 0 ? #1c2333 : (wp0-touch.has-hover ? #19202f : #141822);
