                                                    height: 100%;
                                                    background: @linear-gradient(135deg, #2b1f4d 0%, #171c38 60%, #0d111a 100%);
                                                    opacity: root.selected-wallpaper == 0 ? 0.95 : 0.65;
                                                }

                                                Rectangle {
                                                    width: 100%;
                                                    height: 100%;
                                                    background: @linear-gradient(180deg, transparent 0%, #0b0e14d0 100%);
                                                }

                                                VerticalLayout {
                                                    padding-left: 12px;
                                                    padding-right: 12px;
