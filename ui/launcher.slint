import { Theme } from "theme.slint";
import { TitleBar } from "components/titlebar.slint";
import { ProgressBar } from "components/progress_bar.slint";
import { StatusBadge } from "components/status_badge.slint";
import { BugCard, DialogueEntry } from "components/bug_card.slint";
import { PackageCard, PackageInfo } from "components/package_card.slint";
import { PrimaryButton, SecondaryButton, DangerButton } from "components/buttons.slint";
import { ScrollView } from "std-widgets.slint";

export { DialogueEntry, PackageInfo }

export component MainWindow inherits Window {
    title: "VivaVoce — WoW Forever Voiceover Launcher";
    icon: @image-url("assets/logo.png");
    min-width: 980px;
    min-height: 640px;
    preferred-width: 1180px;
    preferred-height: 760px;
    default-font-family: "Segoe UI, -apple-system, BlinkMacSystemFont, sans-serif";
    no-frame: true;
    background: transparent;

    // === REACTIVE PROPERTIES EXPOSED TO RUST ===
    in-out property <bool> is-maximized: false;
    in-out property <float> progress: 0.0;
    in-out property <string> status-text: "Pronto";
    in-out property <string> sub_status_text: "";
    in-out property <bool> is-updating: false;
    in-out property <string> wow-path: "";
    in-out property <string> wow-path-input: "";
    in-out property <string> wow-flavor: "WoW Forever (1.12.1)";
    in-out property <bool> is-installed: false;
    in-out property <bool> has-update: false;
    in-out property <string> installed-version: "";
    in-out property <string> remote-version: "1.0.0";
    in-out property <int> active-tab: 0; // 0: Dashboard, 1: Pacchetti, 2: Bug Report, 3: Impostazioni

    // GitHub automated issue & bug reporter reactive state
    in-out property <string> github-token: "";
    in-out property <string> bug-submit-status: "";
    in-out property <string> last-created-issue-url: "";
    in-out property <string> bug-attachment-path: "";
    in-out property <string> bug-attachment-filename: "";

    // Launcher self-updater reactive state
    in-out property <string> launcher-version: "0.3.1";
    in-out property <bool> launcher-has-update: false;
    in-out property <string> launcher-new-version: "";
    in-out property <bool> launcher-is-updating: false;
    in-out property <string> launcher-update-status: "";
    in-out property <float> launcher-update-progress: 0.0;

    // Data models
    in-out property <[DialogueEntry]> recent-dialogues: [];
    in-out property <[PackageInfo]> packages: [];

    // === CALLBACKS EXPOSED TO RUST ===
    callback start-update();
    callback start-repair();
    callback start-uninstall();
    callback submit-bug-report(int /* type: 0=audio, 1=addon, 2=launcher */, string /* category */, string /* title */, string /* description */, string /* extra */, string /* attachment_path */);
    callback create-github-issue(int /* type: 0=audio, 1=addon, 2=launcher */, string /* category */, string /* title */, string /* description */, string /* extra */, string /* attachment_path */);
    callback select-bug-attachment();
    callback reveal-bug-attachment();
    callback select-wow-folder();
    callback select-wow-file();
    callback set-custom-wow-path(string);
    callback launch-game();
    callback close-window();
    callback minimize-window();
    callback maximize-window();
    callback resize-window();
    callback set-window-size(int /* width */, int /* height */);
    callback open-url(string);
    callback open-addons-folder();
    callback drag-window();
    callback install-module(string);
    callback remove-module(string);
    callback check-launcher-update();
    callback perform-launcher-update();

    // Main App Shell
    Rectangle {
        width: 100%;
        height: 100%;
        border-radius: root.is-maximized ? 0px : Theme.radius-lg;
        background: Theme.main-window-gradient;
        border-width: 1px;
        border-color: Theme.border-normal;
        clip: true;

        // Main Application Body: Left Sidebar (Full 100% Height) + Right View
        HorizontalLayout {
            width: 100%;
            height: 100%;

            // === LEFT SIDEBAR NAVIGATION (FULL HEIGHT from y=0 to bottom) ===
            sidebar := Rectangle {
                width: 228px;
                height: 100%;
                background: Theme.bg-sidebar;

                // Draggable region at top of sidebar
                TouchArea {
                    x: 0;
                    y: 0;
                    width: parent.width;
                    height: 24px;
                    mouse-cursor: default;
                    pointer-event(event) => {
                        if (event.kind == PointerEventKind.down && event.button == PointerEventButton.left) {
                            root.drag-window();
                        }
                    }
                }

                    // Subtle right separator line
                    Rectangle {
                        x: parent.width - 1px;
                        width: 1px;
                        height: parent.height;
                        background: Theme.border-subtle;
                    }

                    VerticalLayout {
                        padding-left: 14px;
                        padding-right: 14px;
                        padding-top: 16px;
                        padding-bottom: 16px;
                        alignment: space-between;

                        // Top Brand Card & Nav Items
                        VerticalLayout {
                            spacing: 16px;

                            Rectangle {
                                height: 56px;
                                border-radius: Theme.radius-md;
                                background: Theme.bg-panel;
                                border-width: 1px;
                                border-color: Theme.border-subtle;

                                HorizontalLayout {
                                    padding-left: 12px;
                                    padding-right: 12px;
                                    alignment: start;
                                    spacing: 12px;

                                    Rectangle {
                                        width: 36px;
                                        height: 36px;
                                        y: (parent.height - self.height) / 2;
                                        border-radius: Theme.radius-xs;
                                        background: #11151f;
                                        border-width: 1px;
                                        border-color: Theme.border-subtle;
                                        clip: true;

                                        Image {
                                            width: 100%;
                                            height: 100%;
                                            source: @image-url("assets/logo.png");
                                            image-fit: contain;
                                        }
                                    }

                                    VerticalLayout {
                                        alignment: center;
                                        spacing: 2px;

                                        Text {
                                            text: "VivaVoce";
                                            color: Theme.gold-light;
                                            font-size: 14px;
                                            font-weight: 600;
                                        }

                                        Text {
                                            text: "WoW Forever Voiceover";
                                            color: Theme.text-secondary;
                                            font-size: 11px;
                                            font-weight: 400;
                                        }
                                    }
                                }
                            }

                            // Navigation Items
                            VerticalLayout {
                                spacing: 6px;

                                // Tab 0: Dashboard
                                Rectangle {
                                    height: 42px;
                                    border-radius: Theme.radius-sm;
                                    background: root.active-tab == 0 ? #161e2c : (t0-touch.has-hover ? #111622 : transparent);
                                    border-width: 1px;
                                    border-color: root.active-tab == 0 ? Theme.border-gold-subtle : transparent;

                                    animate background { duration: Theme.transition-fast; easing: ease-out; }
                                    animate border-color { duration: Theme.transition-fast; easing: ease-out; }

                                    if (root.active-tab == 0) : Rectangle {
                                        x: 0;
                                        y: (parent.height - self.height) / 2;
                                        width: 3px;
                                        height: 20px;
                                        border-radius: Theme.radius-pill;
                                        background: Theme.gold-primary;
                                    }

                                    t0-touch := TouchArea {
                                        mouse-cursor: pointer;
                                        clicked => { root.active-tab = 0; }
                                    }

                                    HorizontalLayout {
                                        padding-left: 14px;
                                        padding-right: 14px;
                                        spacing: 12px;

                                        VerticalLayout {
                                            alignment: center;
                                            Image {
                                                width: 18px;
                                                height: 18px;
                                                source: @image-url("assets/icons/dashboard.svg");
                                                colorize: root.active-tab == 0 ? Theme.gold-light : Theme.text-secondary;
                                                image-fit: contain;
                                                animate colorize { duration: Theme.transition-fast; }
                                            }
                                        }

                                        VerticalLayout {
                                            alignment: center;
                                            Text {
                                                text: "Dashboard";
                                                color: root.active-tab == 0 ? Theme.text-primary : (t0-touch.has-hover ? Theme.text-primary : Theme.text-secondary);
                                                font-size: 14px;
                                                font-weight: root.active-tab == 0 ? 600 : 500;
                                                animate color { duration: Theme.transition-fast; }
                                            }
                                        }
                                    }
                                }

                                // Tab 1: Pacchetti e dettagli
                                Rectangle {
                                    height: 42px;
                                    border-radius: Theme.radius-sm;
                                    background: root.active-tab == 1 ? #161e2c : (t1-touch.has-hover ? #111622 : transparent);
                                    border-width: 1px;
                                    border-color: root.active-tab == 1 ? Theme.border-gold-subtle : transparent;

                                    animate background { duration: Theme.transition-fast; easing: ease-out; }
                                    animate border-color { duration: Theme.transition-fast; easing: ease-out; }

                                    if (root.active-tab == 1) : Rectangle {
                                        x: 0;
                                        y: (parent.height - self.height) / 2;
                                        width: 3px;
                                        height: 20px;
                                        border-radius: Theme.radius-pill;
                                        background: Theme.gold-primary;
                                    }

                                    t1-touch := TouchArea {
                                        mouse-cursor: pointer;
                                        clicked => { root.active-tab = 1; }
                                    }

                                    HorizontalLayout {
                                        padding-left: 14px;
                                        padding-right: 14px;
                                        spacing: 12px;

                                        VerticalLayout {
                                            alignment: center;
                                            Image {
                                                width: 18px;
                                                height: 18px;
                                                source: @image-url("assets/icons/package.svg");
                                                colorize: root.active-tab == 1 ? Theme.gold-light : Theme.text-secondary;
                                                image-fit: contain;
                                                animate colorize { duration: Theme.transition-fast; }
                                            }
                                        }

                                        VerticalLayout {
                                            alignment: center;
                                            Text {
                                                text: "Pacchetti e dettagli";
                                                color: root.active-tab == 1 ? Theme.text-primary : (t1-touch.has-hover ? Theme.text-primary : Theme.text-secondary);
                                                font-size: 14px;
                                                font-weight: root.active-tab == 1 ? 600 : 500;
                                                animate color { duration: Theme.transition-fast; }
                                            }
                                        }
                                    }
                                }

                                // Tab 2: Segnala un bug
                                Rectangle {
                                    height: 42px;
                                    border-radius: Theme.radius-sm;
                                    background: root.active-tab == 2 ? #161e2c : (t2-touch.has-hover ? #111622 : transparent);
                                    border-width: 1px;
                                    border-color: root.active-tab == 2 ? Theme.border-gold-subtle : transparent;

                                    animate background { duration: Theme.transition-fast; easing: ease-out; }
                                    animate border-color { duration: Theme.transition-fast; easing: ease-out; }

                                    if (root.active-tab == 2) : Rectangle {
                                        x: 0;
                                        y: (parent.height - self.height) / 2;
                                        width: 3px;
                                        height: 20px;
                                        border-radius: Theme.radius-pill;
                                        background: Theme.gold-primary;
                                    }

                                    t2-touch := TouchArea {
                                        mouse-cursor: pointer;
                                        clicked => { root.active-tab = 2; }
                                    }

                                    HorizontalLayout {
                                        padding-left: 14px;
                                        padding-right: 14px;
                                        spacing: 12px;

                                        VerticalLayout {
                                            alignment: center;
                                            Image {
                                                width: 18px;
                                                height: 18px;
                                                source: @image-url("assets/icons/bug.svg");
                                                colorize: root.active-tab == 2 ? Theme.gold-light : Theme.text-secondary;
                                                image-fit: contain;
                                                animate colorize { duration: Theme.transition-fast; }
                                            }
                                        }

                                        VerticalLayout {
                                            alignment: center;
                                            Text {
                                                text: "Segnala un bug";
                                                color: root.active-tab == 2 ? Theme.text-primary : (t2-touch.has-hover ? Theme.text-primary : Theme.text-secondary);
                                                font-size: 14px;
                                                font-weight: root.active-tab == 2 ? 600 : 500;
                                                animate color { duration: Theme.transition-fast; }
                                            }
                                        }
                                    }
                                }

                                // Tab 3: Impostazioni
                                Rectangle {
                                    height: 42px;
                                    border-radius: Theme.radius-sm;
                                    background: root.active-tab == 3 ? #161e2c : (t3-touch.has-hover ? #111622 : transparent);
                                    border-width: 1px;
                                    border-color: root.active-tab == 3 ? Theme.border-gold-subtle : transparent;

                                    animate background { duration: Theme.transition-fast; easing: ease-out; }
                                    animate border-color { duration: Theme.transition-fast; easing: ease-out; }

                                    if (root.active-tab == 3) : Rectangle {
                                        x: 0;
                                        y: (parent.height - self.height) / 2;
                                        width: 3px;
                                        height: 20px;
                                        border-radius: Theme.radius-pill;
                                        background: Theme.gold-primary;
                                    }

                                    t3-touch := TouchArea {
                                        mouse-cursor: pointer;
                                        clicked => { root.active-tab = 3; }
                                    }

                                    HorizontalLayout {
                                        padding-left: 14px;
                                        padding-right: 14px;
                                        spacing: 12px;

                                        VerticalLayout {
                                            alignment: center;
                                            Image {
                                                width: 18px;
                                                height: 18px;
                                                source: @image-url("assets/icons/settings.svg");
                                                colorize: root.active-tab == 3 ? Theme.gold-light : Theme.text-secondary;
                                                image-fit: contain;
                                                animate colorize { duration: Theme.transition-fast; }
                                            }
                                        }

                                        VerticalLayout {
                                            alignment: center;
                                            Text {
                                                text: "Impostazioni";
                                                color: root.active-tab == 3 ? Theme.text-primary : (t3-touch.has-hover ? Theme.text-primary : Theme.text-secondary);
                                                font-size: 14px;
                                                font-weight: root.active-tab == 3 ? 600 : 500;
                                                animate color { duration: Theme.transition-fast; }
                                            }
                                        }
                                    }
                                }
                            }
                        }

                        // Bottom Sidebar Info & Community Links
                        VerticalLayout {
                            spacing: 10px;

                            // WoW Forever Client Badge
                            Rectangle {
                                height: 32px;
                                border-radius: Theme.radius-sm;
                                background: #0c0f16;
                                border-width: 1px;
                                border-color: Theme.border-subtle;

                                HorizontalLayout {
                                    padding-left: 12px;
                                    padding-right: 12px;
                                    alignment: space-between;

                                    Text {
                                        text: "Client:";
                                        color: Theme.text-muted;
                                        font-size: 12px;
                                        vertical-alignment: center;
                                    }

                                    Text {
                                        text: "WoW Forever (1.12.1)";
                                        color: Theme.text-secondary;
                                        font-size: 12px;
                                        font-weight: 500;
                                        vertical-alignment: center;
                                    }
                                }
                            }

                            // Community Buttons Row
                            HorizontalLayout {
                                spacing: 8px;

                                // Discord Link
                                Rectangle {
                                    height: 32px;
                                    border-radius: Theme.radius-xs;
                                    background: d-touch.has-hover ? #171f2e : #0f131c;
                                    border-width: 1px;
                                    border-color: d-touch.has-hover ? Theme.border-bright : Theme.border-subtle;

                                    animate background { duration: Theme.transition-fast; easing: ease-out; }
                                    animate border-color { duration: Theme.transition-fast; easing: ease-out; }

                                    d-touch := TouchArea {
                                        mouse-cursor: pointer;
                                        clicked => { root.open-url("https://discord.gg/EAwNYqs3Ra"); }
                                    }

                                    HorizontalLayout {
                                        alignment: center;
                                        spacing: 8px;

                                        VerticalLayout {
                                            alignment: center;
                                            Image {
                                                width: 15px;
                                                height: 15px;
                                                source: @image-url("assets/icons/discord.svg");
                                                colorize: d-touch.has-hover ? Theme.text-primary : Theme.text-secondary;
                                                image-fit: contain;
                                            }
                                        }

                                        VerticalLayout {
                                            alignment: center;
                                            Text {
                                                text: "Discord ↗";
                                                color: d-touch.has-hover ? Theme.text-primary : Theme.text-secondary;
                                                font-size: 12px;
                                                font-weight: 500;
                                            }
                                        }
                                    }
                                }

                                // GitHub Link
                                Rectangle {
                                    height: 32px;
                                    border-radius: Theme.radius-xs;
                                    background: g-touch.has-hover ? #171f2e : #0f131c;
                                    border-width: 1px;
                                    border-color: g-touch.has-hover ? Theme.border-bright : Theme.border-subtle;

                                    animate background { duration: Theme.transition-fast; easing: ease-out; }
                                    animate border-color { duration: Theme.transition-fast; easing: ease-out; }

                                    g-touch := TouchArea {
                                        mouse-cursor: pointer;
                                        clicked => { root.open-url("https://github.com/Master-Antonio/Vivavoce-Releases"); }
                                    }

                                    HorizontalLayout {
                                        alignment: center;
                                        spacing: 8px;

                                        VerticalLayout {
                                            alignment: center;
                                            Image {
                                                width: 15px;
                                                height: 15px;
                                                source: @image-url("assets/icons/github.svg");
                                                colorize: g-touch.has-hover ? Theme.text-primary : Theme.text-secondary;
                                                image-fit: contain;
                                            }
                                        }

                                        VerticalLayout {
                                            alignment: center;
                                            Text {
                                                text: "GitHub ↗";
                                                color: g-touch.has-hover ? Theme.text-primary : Theme.text-secondary;
                                                font-size: 12px;
                                                font-weight: 500;
                                            }
                                        }
                                    }
                                }
                            }
                        }
                    }
                }

            // === RIGHT MAIN VIEW (Native TitleBar at top + Content View below) ===
            VerticalLayout {
                horizontal-stretch: 1;
                height: 100%;

                // Top Native TitleBar spanning only the right content column
                TitleBar {
                    is-maximized: root.is-maximized;
                    minimize-clicked => { root.minimize-window(); }
                    maximize-clicked => { root.maximize-window(); }
                    close-clicked => { root.close-window(); }
                    drag-window => { root.drag-window(); }
                }

                // === RIGHT MAIN CONTENT VIEW ===
                Rectangle {
                    background: transparent;
                    height: 100%;
                    vertical-stretch: 1;

                    VerticalLayout {
                        width: 100%;
                        height: 100%;
                        padding-left: 28px;
                        padding-right: 28px;
                        padding-top: 10px;
                        padding-bottom: 20px;

                        // ==========================================
                        // TAB 0: DASHBOARD
                        // ==========================================
                        if (root.active-tab == 0) : VerticalLayout {
                            spacing: 16px;
                            alignment: start;

                            // Top Header Block: World of Warcraft: Forever
                            HorizontalLayout {
                                alignment: space-between;

                                VerticalLayout {
                                    spacing: 4px;
                                    alignment: center;
                                    Text {
                                        text: "World of Warcraft: Forever";
                                        color: Theme.text-primary;
                                        font-size: 22px;
                                        font-weight: 700;
                                    }
                                    Text {
                                        text: "Doppiaggio italiano completo per tutti i dialoghi e le missioni.";
                                        color: Theme.text-secondary;
                                        font-size: 13px;
                                    }
                                }

                                // Live Status Badge (Vertically centered with header)
                                VerticalLayout {
                                    alignment: center;
                                    StatusBadge {
                                        is-installed: root.is-installed;
                                        has-update: root.has-update;
                                        is-verifying: root.is-updating;
                                        installed-version: root.installed-version;
                                    }
                                }
                            }

                            // Launcher Self-Update Banner (When GitHub Release is detected)
                            if (root.launcher-has-update || root.launcher-is-updating) : Rectangle {
                                height: 56px;
                                border-radius: Theme.radius-md;
                                background: #131c2a;
                                border-width: 1px;
                                border-color: root.launcher-is-updating ? Theme.status-info : Theme.gold-primary;
                                clip: true;

                                HorizontalLayout {
                                    padding-left: 16px;
                                    padding-right: 16px;
                                    alignment: space-between;

                                    HorizontalLayout {
                                        spacing: 12px;
                                        alignment: center;

                                        Image {
                                            width: 20px;
                                            height: 20px;
                                            source: @image-url("assets/icons/zap.svg");
                                            colorize: Theme.gold-primary;
                                            image-fit: contain;
                                        }

                                        VerticalLayout {
                                            spacing: 2px;
                                            alignment: center;

                                            Text {
                                                text: root.launcher-is-updating ?
                                                    root.launcher-update-status :
                                                    ("Nuova versione di VivaVoce Launcher disponibile: v" + root.launcher-new-version);
                                                color: Theme.text-primary;
                                                font-size: 13px;
                                                font-weight: 600;
                                                vertical-alignment: center;
                                            }
                                            if (!root.launcher-is-updating) : Text {
                                                text: "Aggiorna subito con 1 click per ottenere le ultime migliorie e correzioni.";
                                                color: Theme.text-secondary;
                                                font-size: 11px;
                                            }
                                        }
                                    }

                                    VerticalLayout {
                                        alignment: center;
                                        if (!root.launcher-is-updating) : PrimaryButton {
                                            text: "Aggiorna Launcher";
                                            icon: @image-url("assets/icons/download.svg");
                                            custom-height: 34px;
                                            clicked => { root.perform-launcher-update(); }
                                        }
                                        if (root.launcher-is-updating) : Rectangle {
                                            width: 180px;
                                            height: 12px;
                                            border-radius: 6px;
                                            background: #1a2234;
                                            clip: true;
                                            Rectangle {
                                                x: 0;
                                                y: 0;
                                                width: parent.width * root.launcher-update-progress;
                                                height: 100%;
                                                border-radius: 6px;
                                                background: Theme.gold-primary;
                                            }
                                        }
                                    }
                                }
                            }

                            // Stat Cards Row: 3 Balanced Metric Columns (Anatomy: icon + value + context label)
                            Rectangle {
                                height: 86px;
                                border-radius: Theme.radius-md;
                                background: Theme.bg-panel;
                                border-width: 1px;
                                border-color: Theme.border-normal;

                                HorizontalLayout {
                                    padding: 12px;
                                    alignment: space-around;

                                    // Stat 1: 27.420 battute
                                    VerticalLayout {
                                        alignment: center;
                                        spacing: 4px;
                                        HorizontalLayout {
                                            alignment: center;
                                            spacing: 8px;
                                            Image {
                                                width: 16px;
                                                height: 16px;
                                                source: @image-url("assets/icons/mic.svg");
                                                colorize: Theme.gold-primary;
                                                image-fit: contain;
                                                vertical-alignment: center;
                                            }
                                            Text {
                                                text: "27.420";
                                                color: Theme.text-primary;
                                                font-size: 24px;
                                                font-weight: 700;
                                                vertical-alignment: center;
                                            }
                                        }
                                        Text {
                                            text: "Battute vocali recitate";
                                            color: Theme.text-secondary;
                                            font-size: 12px;
                                            font-weight: 500;
                                            horizontal-alignment: center;
                                        }
                                    }

                                    // Feathered Divider Line
                                    Rectangle {
                                        width: 1px;
                                        height: 50px;
                                        background: @linear-gradient(180deg, #19202c00 0%, #2a354a 50%, #19202c00 100%);
                                        y: (parent.height - self.height) / 2;
                                    }

                                    // Stat 2: 2.500+ missioni e tomi
                                    VerticalLayout {
                                        alignment: center;
                                        spacing: 4px;
                                        HorizontalLayout {
                                            alignment: center;
                                            spacing: 8px;
                                            Image {
                                                width: 16px;
                                                height: 16px;
                                                source: @image-url("assets/icons/book-open.svg");
                                                colorize: Theme.gold-primary;
                                                image-fit: contain;
                                                vertical-alignment: center;
                                            }
                                            Text {
                                                text: "2.500+";
                                                color: Theme.text-primary;
                                                font-size: 24px;
                                                font-weight: 700;
                                                vertical-alignment: center;
                                            }
                                        }
                                        Text {
                                            text: "Missioni e tomi doppiati";
                                            color: Theme.text-secondary;
                                            font-size: 12px;
                                            font-weight: 500;
                                            horizontal-alignment: center;
                                        }
                                    }

                                    // Feathered Divider Line
                                    Rectangle {
                                        width: 1px;
                                        height: 50px;
                                        background: @linear-gradient(180deg, #19202c00 0%, #2a354a 50%, #19202c00 100%);
                                        y: (parent.height - self.height) / 2;
                                    }

                                    // Stat 3: 6 / 6 moduli
                                    VerticalLayout {
                                        alignment: center;
                                        spacing: 4px;
                                        HorizontalLayout {
                                            alignment: center;
                                            spacing: 8px;
                                            Image {
                                                width: 16px;
                                                height: 16px;
                                                source: @image-url("assets/icons/shield-check.svg");
                                                colorize: Theme.gold-primary;
                                                image-fit: contain;
                                                vertical-alignment: center;
                                            }
                                            Text {
                                                text: "6 / 6";
                                                color: Theme.text-primary;
                                                font-size: 24px;
                                                font-weight: 700;
                                                vertical-alignment: center;
                                            }
                                        }
                                        Text {
                                            text: "Moduli audio integri";
                                            color: Theme.text-secondary;
                                            font-size: 12px;
                                            font-weight: 500;
                                            horizontal-alignment: center;
                                        }
                                    }
                                }
                            }

                            // WoW Forever Directory Card
                            Rectangle {
                                height: 66px;
                                border-radius: Theme.radius-md;
                                background: Theme.bg-card;
                                border-width: 1px;
                                border-color: Theme.border-subtle;

                                HorizontalLayout {
                                    padding-left: 16px;
                                    padding-right: 16px;
                                    alignment: space-between;

                                    VerticalLayout {
                                        alignment: center;
                                        spacing: 4px;

                                        HorizontalLayout {
                                            spacing: 8px;
                                            alignment: start;
                                            Text {
                                                text: "Cartella di gioco:";
                                                color: Theme.text-secondary;
                                                font-size: 12px;
                                                font-weight: 500;
                                                vertical-alignment: center;
                                            }
                                            Rectangle {
                                                height: 18px;
                                                border-radius: Theme.radius-xs;
                                                background: #c89b3c15;
                                                border-width: 1px;
                                                border-color: #c89b3c33;
                                                HorizontalLayout {
                                                    padding-left: 6px;
                                                    padding-right: 6px;
                                                    Text {
                                                        text: "Forever 1.12.1";
                                                        color: Theme.gold-light;
                                                        font-size: 10px;
                                                        font-weight: 600;
                                                        vertical-alignment: center;
                                                    }
                                                }
                                            }
                                        }

                                        Text {
                                            text: root.wow-path != "" ? root.wow-path : "Nessun percorso rilevato. Seleziona la cartella di WoW Forever.";
                                            color: root.wow-path != "" ? Theme.text-primary : Theme.text-muted;
                                            font-size: 13px;
                                            overflow: elide;
                                            max-width: 560px;
                                        }
                                    }

                                    VerticalLayout {
                                        alignment: center;
                                        HorizontalLayout {
                                            spacing: 10px;

                                            SecondaryButton {
                                                text: "Sfoglia…";
                                                icon: @image-url("assets/icons/folder.svg");
                                                custom-height: 36px;
                                                clicked => { root.select-wow-folder(); }
                                            }

                                            SecondaryButton {
                                                text: "File WoW.exe…";
                                                icon: @image-url("assets/icons/file-text.svg");
                                                custom-height: 36px;
                                                clicked => { root.select-wow-file(); }
                                            }

                                            SecondaryButton {
                                                text: "Apri AddOns";
                                                icon: @image-url("assets/icons/folder-open.svg");
                                                custom-height: 36px;
                                                clicked => { root.open-addons-folder(); }
                                            }
                                        }
                                    }
                                }
                            }

                            // Command Panel: Primary CTA / Progress & Highlights
                            Rectangle {
                                height: 250px;
                                border-radius: Theme.radius-md;
                                background: Theme.bg-panel;
                                border-width: 1px;
                                border-color: Theme.border-normal;

                                VerticalLayout {
                                    padding: 20px;
                                    spacing: 16px;
                                    alignment: space-between;

                                    // Top CTA Bar or Progress Bar
                                    if (root.is-updating) : VerticalLayout {
                                        spacing: 8px;
                                        ProgressBar {
                                            progress: root.progress;
                                            title: root.status-text;
                                            details: root.sub_status_text;
                                            is-active: true;
                                        }
                                    }

                                    if (!root.is-updating) : HorizontalLayout {
                                        spacing: 14px;
                                        alignment: center;

                                        // Primary CTA Button
                                        PrimaryButton {
                                            width: 300px;
                                            custom-height: 50px;
                                            text: !root.is-installed ? "Installa VivaVoce" : (root.has-update ? ("Aggiorna a v" + root.remote-version) : "Avvia WoW Forever");
                                            icon: !root.is-installed ? @image-url("assets/icons/download.svg") : (root.has-update ? @image-url("assets/icons/refresh-cw.svg") : @image-url("assets/icons/play.svg"));
                                            enabled: true;

                                            clicked => {
                                                if (!root.is-installed || root.has-update) {
                                                    root.start-update();
                                                } else {
                                                    root.launch-game();
                                                }
                                            }
                                        }

                                        // Secondary Repair Button
                                        if (root.is-installed) : SecondaryButton {
                                            width: 170px;
                                            custom-height: 50px;
                                            text: "Verifica file";
                                            icon: @image-url("assets/icons/wrench.svg");
                                            clicked => { root.start-repair(); }
                                        }
                                    }

                                    // Subtle horizontal separator
                                    Rectangle { height: 1px; background: Theme.border-subtle; }

                                    // Feature Highlights: Clean 3-column metadata bar
                                    Rectangle {
                                        height: 54px;
                                        background: Theme.bg-card;
                                        border-radius: Theme.radius-sm;
                                        border-width: 1px;
                                        border-color: Theme.border-subtle;

                                        HorizontalLayout {
                                            alignment: space-around;

                                            // Feature 1
                                            HorizontalLayout {
                                                alignment: center;
                                                spacing: 10px;
                                                VerticalLayout {
                                                    alignment: center;
                                                    Image {
                                                        width: 18px;
                                                        height: 18px;
                                                        source: @image-url("assets/icons/mic.svg");
                                                        colorize: Theme.gold-primary;
                                                        image-fit: contain;
                                                    }
                                                }
                                                VerticalLayout {
                                                    alignment: center;
                                                    spacing: 1px;
                                                    Text { text: "Doppiaggio italiano"; color: Theme.text-primary; font-size: 12px; font-weight: 600; }
                                                    Text { text: "Dialoghi e missioni recitati"; color: Theme.text-muted; font-size: 11px; }
                                                }
                                            }

                                            // Divider
                                            Rectangle { width: 1px; height: 30px; background: Theme.border-subtle; y: (parent.height - self.height) / 2; }

                                            // Feature 2
                                            HorizontalLayout {
                                                alignment: center;
                                                spacing: 10px;
                                                VerticalLayout {
                                                    alignment: center;
                                                    Image {
                                                        width: 18px;
                                                        height: 18px;
                                                        source: @image-url("assets/icons/zap.svg");
                                                        colorize: Theme.gold-primary;
                                                        image-fit: contain;
                                                    }
                                                }
                                                VerticalLayout {
                                                    alignment: center;
                                                    spacing: 1px;
                                                    Text { text: "Formato OGG Vorbis"; color: Theme.text-primary; font-size: 12px; font-weight: 600; }
                                                    Text { text: "Stream audio a 48 kHz"; color: Theme.text-muted; font-size: 11px; }
                                                }
                                            }

                                            // Divider
                                            Rectangle { width: 1px; height: 30px; background: Theme.border-subtle; y: (parent.height - self.height) / 2; }

                                            // Feature 3
                                            HorizontalLayout {
                                                alignment: center;
                                                spacing: 10px;
                                                VerticalLayout {
                                                    alignment: center;
                                                    Image {
                                                        width: 18px;
                                                        height: 18px;
                                                        source: @image-url("assets/icons/shield-check.svg");
                                                        colorize: Theme.gold-primary;
                                                        image-fit: contain;
                                                    }
                                                }
                                                VerticalLayout {
                                                    alignment: center;
                                                    spacing: 1px;
                                                    Text { text: "Integrazione nativa"; color: Theme.text-primary; font-size: 12px; font-weight: 600; }
                                                    Text { text: "Solo cartella Interface/AddOns"; color: Theme.text-muted; font-size: 11px; }
                                                }
                                            }
                                        }
                                    }

                                    // Disclaimer Footer
                                    Text {
                                        text: "VivaVoce integra l'audio OGG direttamente nella cartella AddOns di World of Warcraft: Forever senza modificare i file Blizzard.";
                                        color: Theme.text-muted;
                                        font-size: 12px;
                                        horizontal-alignment: center;
                                    }
                                }
                            }
                        }

                        // ==========================================
                        // TAB 1: PACCHETTI E DETTAGLI (6 Moduli)
                        // ==========================================
                        if (root.active-tab == 1) : VerticalLayout {
                            spacing: 14px;
                            alignment: start;

                            // Tab Header
                            HorizontalLayout {
                                alignment: space-between;

                                VerticalLayout {
                                    spacing: 4px;
                                    alignment: center;
                                    Text {
                                        text: "Moduli installati";
                                        color: Theme.text-primary;
                                        font-size: 18px;
                                        font-weight: 600;
                                    }
                                    Text {
                                        text: "Componenti modulari installati in World of Warcraft: Forever.";
                                        color: Theme.text-secondary;
                                        font-size: 13px;
                                    }
                                }

                                VerticalLayout {
                                    alignment: center;
                                    HorizontalLayout {
                                        spacing: 10px;

                                        SecondaryButton {
                                            text: "Verifica integrità";
                                            icon: @image-url("assets/icons/wrench.svg");
                                            custom-height: 36px;
                                            clicked => { root.start-repair(); }
                                        }

                                        SecondaryButton {
                                            text: "Cartella AddOns";
                                            icon: @image-url("assets/icons/folder-open.svg");
                                            custom-height: 36px;
                                            clicked => { root.open-addons-folder(); }
                                        }
                                    }
                                }
                            }

                            // Loading / Updating Progress Banner in Tab 1
                            if (root.is-updating) : Rectangle {
                                height: 56px;
                                background: #0c121e;
                                border-radius: Theme.radius-md;
                                border-width: 1px;
                                border-color: Theme.border-gold-normal;

                                HorizontalLayout {
                                    padding-left: 16px;
                                    padding-right: 16px;
                                    alignment: space-between;

                                    HorizontalLayout {
                                        spacing: 12px;
                                        alignment: start;

                                        VerticalLayout {
                                            alignment: center;
                                            Image {
                                                width: 20px;
                                                height: 20px;
                                                source: @image-url("assets/icons/refresh-cw.svg");
                                                colorize: Theme.gold-primary;
                                                image-fit: contain;
                                            }
                                        }

                                        VerticalLayout {
                                            alignment: center;
                                            spacing: 2px;

                                            Text {
                                                text: root.status-text;
                                                color: Theme.gold-light;
                                                font-size: 13px;
                                                font-weight: 600;
                                            }

                                            Text {
                                                text: root.sub_status_text != "" ? root.sub_status_text : "Operazione sul pacchetto in corso...";
                                                color: Theme.text-secondary;
                                                font-size: 11px;
                                            }
                                        }
                                    }

                                    VerticalLayout {
                                        alignment: center;
                                        Rectangle {
                                            width: 140px;
                                            height: 6px;
                                            background: #141a26;
                                            border-radius: Theme.radius-pill;
                                            clip: true;

                                            Rectangle {
                                                x: 0;
                                                width: root.progress > 0 ? parent.width * root.progress : parent.width * 0.35;
                                                height: 100%;
                                                background: Theme.gold-primary;
                                                border-radius: Theme.radius-pill;
                                                animate width { duration: 160ms; easing: ease-out; }
                                            }
                                        }
                                    }
                                }
                            }

                            // Dynamic scrollable list of modules (Full height container showing all 6 modules)
                            ScrollView {
                                height: root.is-updating ? 500px : 560px;
                                VerticalLayout {
                                    spacing: 8px;
                                    padding-right: 8px;
                                    alignment: start;

                                    // Dynamic packages from Rust
                                    for pkg in root.packages : PackageCard {
                                        package-data: pkg;
                                        is-busy: root.is-updating;
                                        install-clicked(id) => { root.install-module(id); }
                                        remove-clicked(id) => { root.remove-module(id); }
                                    }

                                    // Fallback when packages list is empty
                                    if (root.packages.length == 0) : VerticalLayout {
                                        spacing: 8px;

                                        PackageCard {
                                            package-data: {
                                                id: "vivavoce-core",
                                                name: "VivaVoce Core",
                                                description: "Motore audio principale, gestione code, sottotitoli e opzioni in-game",
                                                filename: "vivavoce-core.tar.zst",
                                                size-str: "865 KB",
                                                installed: root.is-installed,
                                                verified: root.is-installed,
                                                blake3-hash: "b3f8...91a2"
                                            };
                                            is-busy: root.is-updating;
                                            install-clicked(id) => { root.install-module(id); }
                                            remove-clicked(id) => { root.remove-module(id); }
                                        }

                                        PackageCard {
                                            package-data: {
                                                id: "vivavoce-quests",
                                                name: "VivaVoce Quests",
                                                description: "15.838 battute: dialoghi quest, gossip NPC, accettazione e completamento",
                                                filename: "vivavoce-quests.tar.zst",
                                                size-str: "2.48 GB",
                                                installed: root.is-installed,
                                                verified: root.is-installed,
                                                blake3-hash: "7c2d...4401"
                                            };
                                            is-busy: root.is-updating;
                                            install-clicked(id) => { root.install-module(id); }
                                            remove-clicked(id) => { root.remove-module(id); }
                                        }

                                        PackageCard {
                                            package-data: {
                                                id: "vivavoce-books",
                                                name: "VivaVoce Books",
                                                description: "5.594 battute: tomi di Azeroth, lettere, diari, pergamene e lapidi",
                                                filename: "vivavoce-books.tar.zst",
                                                size-str: "1.12 GB",
                                                installed: root.is-installed,
                                                verified: root.is-installed,
                                                blake3-hash: "33aa...ff99"
                                            };
                                            is-busy: root.is-updating;
                                            install-clicked(id) => { root.install-module(id); }
                                            remove-clicked(id) => { root.remove-module(id); }
                                        }

                                        PackageCard {
                                            package-data: {
                                                id: "vivavoce-codex",
                                                name: "VivaVoce Codex",
                                                description: "1.606 battute: supporto a CodexIT e missioni lore classiche",
                                                filename: "vivavoce-codex.tar.zst",
                                                size-str: "385 MB",
                                                installed: root.is-installed,
                                                verified: root.is-installed,
                                                blake3-hash: "19e0...8821"
                                            };
                                            is-busy: root.is-updating;
                                            install-clicked(id) => { root.install-module(id); }
                                            remove-clicked(id) => { root.remove-module(id); }
                                        }

                                        PackageCard {
                                            package-data: {
                                                id: "vivavoce-zones",
                                                name: "VivaVoce Zones",
                                                description: "Annunci e tracce d'atmosfera delle zone del mondo",
                                                filename: "vivavoce-zones.tar.zst",
                                                size-str: "120 MB",
                                                installed: root.is-installed,
                                                verified: root.is-installed,
                                                blake3-hash: "4fa1...bb12"
                                            };
                                            is-busy: root.is-updating;
                                            install-clicked(id) => { root.install-module(id); }
                                            remove-clicked(id) => { root.remove-module(id); }
                                        }

                                        PackageCard {
                                            package-data: {
                                                id: "vivavoce-collector",
                                                name: "VivaVoce Collector",
                                                description: "Registratore SavedVariables per report di bug e pronunce in-game",
                                                filename: "vivavoce-collector.tar.zst",
                                                size-str: "15 KB",
                                                installed: root.is-installed,
                                                verified: root.is-installed,
                                                blake3-hash: "6c9d...ff51"
                                            };
                                            is-busy: root.is-updating;
                                            install-clicked(id) => { root.install-module(id); }
                                            remove-clicked(id) => { root.remove-module(id); }
                                        }
                                    }
                                }
                            }
                        }

                        // ==========================================
                        // TAB 2: SEGNALA BUG (Audio & AddOn)
                        // ==========================================
                        if (root.active-tab == 2) : ScrollView {
                            vertical-stretch: 1;
                            height: 100%;
                            VerticalLayout {
                                padding-right: 8px;
                                BugCard {
                                    width: 100%;
                                    recent-dialogues: root.recent-dialogues;
                                    submit-status-text: root.bug-submit-status;
                                    last-created-issue-url: root.last-created-issue-url;
                                    has-github-token: root.github-token != "";
                                    attachment-path <=> root.bug-attachment-path;
                                    attachment-filename <=> root.bug-attachment-filename;

                                    select-attachment => {
                                        root.select-bug-attachment();
                                    }

                                    reveal-attachment => {
                                        root.reveal-bug-attachment();
                                    }

                                    remove-attachment => {
                                        root.bug-attachment-path = "";
                                        root.bug-attachment-filename = "";
                                    }

                                    create-github-issue(rtype, cat, title, desc, extra, attach) => {
                                        root.create-github-issue(rtype, cat, title, desc, extra, attach);
                                    }

                                    export-report-md(rtype, cat, title, desc, extra, attach) => {
                                        root.submit-bug-report(rtype, cat, title, desc, extra, attach);
                                    }

                                    open-issue-url(url) => {
                                        root.open-url(url);
                                    }
                                }
                            }
                        }

                        // ==========================================
                        // TAB 3: IMPOSTAZIONI
                        // ==========================================
                        if (root.active-tab == 3) : ScrollView {
                            vertical-stretch: 1;
                            VerticalLayout {
                                padding-right: 6px;
                                spacing: 14px;
                                alignment: start;

                                // Settings Header
                                VerticalLayout {
                                    spacing: 4px;
                                    Text {
                                        text: "Impostazioni";
                                        color: Theme.text-primary;
                                        font-size: 18px;
                                        font-weight: 600;
                                    }
                                    Text {
                                        text: "Configurazione cartella di gioco, risoluzione finestra, integrazione GitHub e manutenzione.";
                                        color: Theme.text-secondary;
                                        font-size: 13px;
                                    }
                                }

                                // Card 0: Aggiornamento VivaVoce Launcher
                                Rectangle {
                                    height: 84px;
                                    border-radius: Theme.radius-md;
                                    background: Theme.bg-panel;
                                    border-width: 1px;
                                    border-color: Theme.border-normal;

                                    VerticalLayout {
                                        padding: 16px;
                                        spacing: 8px;
                                        alignment: center;

                                        HorizontalLayout {
                                            alignment: space-between;

                                            VerticalLayout {
                                                spacing: 2px;
                                                alignment: center;

                                                HorizontalLayout {
                                                    spacing: 8px;
                                                    Text {
                                                        text: "VivaVoce Launcher";
                                                        color: Theme.text-primary;
                                                        font-size: 14px;
                                                        font-weight: 600;
                                                    }
                                                    Rectangle {
                                                        height: 20px;
                                                        border-radius: 4px;
                                                        background: #1e293b;
                                                        border-width: 1px;
                                                        border-color: Theme.border-subtle;
                                                        HorizontalLayout {
                                                            padding-left: 6px;
                                                            padding-right: 6px;
                                                            Text {
                                                                text: "v" + root.launcher-version;
                                                                color: Theme.gold-light;
                                                                font-size: 11px;
                                                                font-weight: 600;
                                                                vertical-alignment: center;
                                                            }
                                                        }
                                                    }
                                                }

                                                Text {
                                                    text: root.launcher-is-updating ?
                                                        root.launcher-update-status :
                                                        (root.launcher-has-update ? ("Nuova versione v" + root.launcher-new-version + " disponibile!") : "Il launcher è aggiornato all'ultima versione.");
                                                    color: root.launcher-has-update ? Theme.gold-light : Theme.text-secondary;
                                                    font-size: 12px;
                                                }
                                            }

                                            HorizontalLayout {
                                                spacing: 10px;
                                                alignment: center;

                                                if (!root.launcher-is-updating && !root.launcher-has-update) : SecondaryButton {
                                                    text: "Verifica aggiornamenti";
                                                    icon: @image-url("assets/icons/refresh-cw.svg");
                                                    custom-height: 38px;
                                                    clicked => { root.check-launcher-update(); }
                                                }

                                                if (!root.launcher-is-updating && root.launcher-has-update) : PrimaryButton {
                                                    text: "Aggiorna ora";
                                                    icon: @image-url("assets/icons/download.svg");
                                                    custom-height: 38px;
                                                    clicked => { root.perform-launcher-update(); }
                                                }

                                                if (root.launcher-is-updating) : Rectangle {
                                                    width: 160px;
                                                    height: 10px;
                                                    border-radius: 5px;
                                                    background: #1a2234;
                                                    clip: true;
                                                    Rectangle {
                                                        x: 0;
                                                        y: 0;
                                                        width: parent.width * root.launcher-update-progress;
                                                        height: 100%;
                                                        border-radius: 5px;
                                                        background: Theme.gold-primary;
                                                    }
                                                }
                                            }
                                        }
                                    }
                                }

                                // Card 1: Percorso World of Warcraft: Forever
                                Rectangle {
                                    height: 168px;
                                    border-radius: Theme.radius-md;
                                    background: Theme.bg-panel;
                                    border-width: 1px;
                                    border-color: Theme.border-normal;

                                    VerticalLayout {
                                        padding: 16px;
                                        spacing: 10px;
                                        alignment: center;

                                        HorizontalLayout {
                                            alignment: space-between;
                                            Text {
                                                text: "Cartella di gioco (World of Warcraft)";
                                                color: Theme.text-primary;
                                                font-size: 13px;
                                                font-weight: 600;
                                            }

                                            Text {
                                                text: root.wow-path != "" ? "Rilevato: " + root.wow-flavor : "Non configurato";
                                                color: root.wow-path != "" ? Theme.gold-light : Theme.text-muted;
                                                font-size: 11px;
                                                font-weight: 500;
                                            }
                                        }

                                        // Riga di input percorso manuale / incolla + pulsante Applica
                                        HorizontalLayout {
                                            spacing: 10px;

                                            Rectangle {
                                                height: 38px;
                                                background: Theme.bg-input;
                                                border-radius: Theme.radius-sm;
                                                border-width: 1px;
                                                border-color: Theme.border-normal;

                                                if root.wow-path-input == "" : Text {
                                                    x: 12px;
                                                    y: 10px;
                                                    text: "Incolla o digita il percorso (es. Z:\\home\\deck\\Games\\World of Warcraft o C:\\Games\\...)";
                                                    color: Theme.text-muted;
                                                    font-size: 12px;
                                                }

                                                HorizontalLayout {
                                                    padding-left: 12px;
                                                    padding-right: 12px;
                                                    alignment: stretch;

                                                    TextInput {
                                                        text <=> root.wow-path-input;
                                                        color: Theme.text-primary;
                                                        font-size: 13px;
                                                        single-line: true;
                                                        horizontal-alignment: left;
                                                        vertical-alignment: center;
                                                        accepted => { root.set-custom-wow-path(self.text); }
                                                    }
                                                }
                                            }

                                            PrimaryButton {
                                                width: 110px;
                                                text: "Applica";
                                                icon: @image-url("assets/icons/check.svg");
                                                custom-height: 38px;
                                                clicked => { root.set-custom-wow-path(root.wow-path-input); }
                                            }
                                        }

                                        // Riga azioni rapide Sfoglia / Seleziona WoW.exe / Aiuto Steam Deck
                                        HorizontalLayout {
                                            spacing: 10px;
                                            alignment: start;

                                            SecondaryButton {
                                                text: "Sfoglia Cartella…";
                                                icon: @image-url("assets/icons/folder.svg");
                                                custom-height: 34px;
                                                clicked => { root.select-wow-folder(); }
                                            }

                                            SecondaryButton {
                                                text: "Seleziona WoW.exe…";
                                                icon: @image-url("assets/icons/file-text.svg");
                                                custom-height: 34px;
                                                clicked => { root.select-wow-file(); }
                                            }

                                            Text {
                                                text: "Su Steam Deck / Linux (Proton) usa 'Seleziona WoW.exe' o incolla il percorso Z:\\...";
                                                color: Theme.text-muted;
                                                font-size: 11px;
                                                vertical-alignment: center;
                                            }
                                        }
                                    }
                                }

                                // Card 2: Risoluzione Finestra e Ridimensionamento Interfaccia
                                Rectangle {
                                    height: 124px;
                                    border-radius: Theme.radius-md;
                                    background: Theme.bg-panel;
                                    border-width: 1px;
                                    border-color: Theme.border-normal;

                                    VerticalLayout {
                                        padding: 16px;
                                        spacing: 10px;
                                        alignment: center;

                                        HorizontalLayout {
                                            alignment: space-between;
                                            Text {
                                                text: "Dimensione finestra e risoluzione interfaccia";
                                                color: Theme.text-primary;
                                                font-size: 13px;
                                                font-weight: 600;
                                            }

                                            Text {
                                                text: "Ridimensionabile anche trascinando l'angolo in basso a destra";
                                                color: Theme.gold-light;
                                                font-size: 11px;
                                                font-weight: 500;
                                            }
                                        }

                                        HorizontalLayout {
                                            spacing: 10px;

                                            SecondaryButton {
                                                text: "1020 × 680";
                                                custom-height: 36px;
                                                clicked => { root.set-window-size(1020, 680); }
                                            }

                                            PrimaryButton {
                                                text: "1180 × 760 (Consigliata)";
                                                custom-height: 36px;
                                                clicked => { root.set-window-size(1180, 760); }
                                            }

                                            SecondaryButton {
                                                text: "1360 × 860";
                                                custom-height: 36px;
                                                clicked => { root.set-window-size(1360, 860); }
                                            }

                                            SecondaryButton {
                                                text: "Schermo Intero";
                                                custom-height: 36px;
                                                clicked => { root.set-window-size(0, 0); }
                                            }
                                        }

                                        Text {
                                            text: "Seleziona un formato predefinito per adattare la dimensione del launcher allo schermo del tuo PC.";
                                            color: Theme.text-muted;
                                            font-size: 12px;
                                        }
                                    }
                                }

                                // Card 3: Integrazione GitHub (Issue automatizzate)
                                Rectangle {
                                    height: 116px;
                                    border-radius: Theme.radius-md;
                                    background: Theme.bg-panel;
                                    border-width: 1px;
                                    border-color: Theme.border-normal;

                                    VerticalLayout {
                                        padding: 16px;
                                        spacing: 10px;
                                        alignment: center;

                                        HorizontalLayout {
                                            alignment: space-between;
                                            Text {
                                                text: "Integrazione GitHub (Creazione automatica issue)";
                                                color: Theme.text-primary;
                                                font-size: 13px;
                                                font-weight: 600;
                                            }

                                            Text {
                                                text: root.github-token != "" ? "Token configurato (Invio API attivo)" : "1-Click browser attivo";
                                                color: root.github-token != "" ? Theme.status-success : Theme.gold-light;
                                                font-size: 11px;
                                                font-weight: 500;
                                            }
                                        }

                                        Rectangle {
                                            height: 38px;
                                            background: Theme.bg-input;
                                            border-radius: Theme.radius-sm;
                                            border-width: 1px;
                                            border-color: token-input.has-focus ? Theme.border-gold-normal : Theme.border-normal;

                                            animate border-color { duration: Theme.transition-fast; easing: ease-out; }

                                            token-touch := TouchArea {
                                                mouse-cursor: text;
                                                clicked => { token-input.focus(); }
                                            }

                                            if (root.github-token == "" && !token-input.has-focus) : Text {
                                                x: 12px;
                                                y: 10px;
                                                text: "Opzionale: inserisci un Personal Access Token (ghp_...) per creare issue via API";
                                                color: Theme.text-muted;
                                                font-size: 12px;
                                            }

                                            HorizontalLayout {
                                                padding-left: 12px;
                                                padding-right: 12px;
                                                alignment: stretch;

                                                token-input := TextInput {
                                                    text <=> root.github-token;
                                                    color: Theme.text-primary;
                                                    font-size: 13px;
                                                    single-line: true;
                                                    horizontal-alignment: left;
                                                    vertical-alignment: center;
                                                }
                                            }
                                        }

                                        Text {
                                            text: "Senza token, il pulsante apre il browser con titolo, etichette e corpo precompilati al 100% (zero click manuali).";
                                            color: Theme.text-muted;
                                            font-size: 11px;
                                        }
                                    }
                                }

                                // Card 4: Manutenzione & Disinstallazione
                                Rectangle {
                                    height: 160px;
                                    border-radius: Theme.radius-md;
                                    background: Theme.bg-panel;
                                    border-width: 1px;
                                    border-color: Theme.border-normal;

                                    VerticalLayout {
                                        padding: 16px;
                                        spacing: 12px;
                                        alignment: start;

                                        Text {
                                            text: "Manutenzione addon";
                                            color: Theme.text-primary;
                                            font-size: 13px;
                                            font-weight: 600;
                                        }

                                        // Row 1: Ripara
                                        HorizontalLayout {
                                            alignment: space-between;

                                            VerticalLayout {
                                                spacing: 2px;
                                                alignment: center;

                                                Text {
                                                    text: "Verifica e ripara file";
                                                    color: Theme.text-primary;
                                                    font-size: 13px;
                                                    font-weight: 500;
                                                }
                                                Text {
                                                    text: "Scansiona tutti i pacchetti audio e riscarica solo i file mancanti o danneggiati.";
                                                    color: Theme.text-secondary;
                                                    font-size: 12px;
                                                }
                                            }

                                            SecondaryButton {
                                                width: 160px;
                                                text: "Esegui verifica";
                                                icon: @image-url("assets/icons/wrench.svg");
                                                custom-height: 38px;
                                                clicked => { root.start-repair(); }
                                            }
                                        }

                                        Rectangle { height: 1px; background: Theme.border-subtle; }

                                        // Row 2: Disinstalla
                                        HorizontalLayout {
                                            alignment: space-between;

                                            VerticalLayout {
                                                spacing: 2px;
                                                alignment: center;

                                                Text {
                                                    text: "Disinstalla VivaVoce";
                                                    color: Theme.btn-danger-text;
                                                    font-size: 13px;
                                                    font-weight: 500;
                                                }
                                                Text {
                                                    text: "Rimuove in modo pulito tutti i 6 pacchetti audio dalla cartella AddOns di WoW Forever.";
                                                    color: Theme.text-secondary;
                                                    font-size: 12px;
                                                }
                                            }

                                            DangerButton {
                                                width: 160px;
                                                text: "Disinstalla addon";
                                                icon: @image-url("assets/icons/trash-2.svg");
                                                custom-height: 38px;
                                                clicked => { root.start-uninstall(); }
                                            }
                                        }
                                    }
                                }

                                // Card 5: Dettagli Tecnici & Runtime
                                Rectangle {
                                    height: 54px;
                                    border-radius: Theme.radius-md;
                                    background: Theme.bg-card;
                                    border-width: 1px;
                                    border-color: Theme.border-subtle;

                                    HorizontalLayout {
                                        padding-left: 16px;
                                        padding-right: 16px;
                                        alignment: space-between;

                                        HorizontalLayout {
                                            spacing: 8px;
                                            alignment: center;
                                            Text { text: "Client WoW:"; color: Theme.text-muted; font-size: 12px; vertical-alignment: center; }
                                            Text { text: root.wow-flavor; color: Theme.text-secondary; font-size: 12px; font-weight: 500; vertical-alignment: center; }
                                        }

                                        HorizontalLayout {
                                            spacing: 8px;
                                            alignment: center;
                                            Text { text: "Audio engine:"; color: Theme.text-muted; font-size: 12px; vertical-alignment: center; }
                                            Text { text: "OGG Vorbis 48 kHz"; color: Theme.text-secondary; font-size: 12px; font-weight: 500; vertical-alignment: center; }
                                        }

                                        HorizontalLayout {
                                            spacing: 8px;
                                            alignment: center;
                                            Text { text: "GUI stack:"; color: Theme.text-muted; font-size: 12px; vertical-alignment: center; }
                                            Text { text: "Slint 1.18 (Skia)"; color: Theme.text-secondary; font-size: 12px; font-weight: 500; vertical-alignment: center; }
                                        }
                                    }
                                }
                            }
                        }
                    }
                }
            }
        }

        // Bottom-Right Corner Resize Grip (only visible when not maximized)
        if (!root.is-maximized) : Rectangle {
            x: parent.width - 20px;
            y: parent.height - 20px;
            width: 20px;
            height: 20px;
            background: transparent;

            resize-touch := TouchArea {
                mouse-cursor: nwse-resize;
                pointer-event(event) => {
                    if (event.kind == PointerEventKind.down && event.button == PointerEventButton.left) {
                        root.resize-window();
                    }
                }
            }

            Image {
                width: 14px;
                height: 14px;
                x: 3px;
                y: 3px;
                source: @image-url("assets/icons/grip.svg");
                colorize: resize-touch.has-hover ? Theme.gold-light : #475569;
                image-fit: contain;
                animate colorize { duration: Theme.transition-fast; }
            }
        }
    }
}
