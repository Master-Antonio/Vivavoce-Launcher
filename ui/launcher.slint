                                            }
                                        }
                                    }
                                }

                                // ==========================================
                                // SEZIONE 2: CARTELLA DI GIOCO WOW FOREVER
                                // ==========================================
                                Rectangle {
                                    border-radius: Theme.radius-md;
                                    background: Theme.bg-card;
                                    border-width: 1px;
                                    border-color: Theme.border-normal;

                                    VerticalLayout {
                                        padding: 16px;
                                        spacing: 12px;

                                        HorizontalLayout {
                                            alignment: space-between;
                                            VerticalLayout {
                                                spacing: 2px;
                                                Text {
                                                    text: "Cartella di Gioco WoW Forever";
                                                    color: Theme.text-primary;
                                                    font-size: 14px;
                                                    font-weight: 600;
                                                }
                                                Text {
                                                    text: "Directory principale in cui risiede World of Warcraft o l'eseguibile WoW.exe.";
                                                    color: Theme.text-secondary;
                                                    font-size: 12px;
                                                }
                                            }

                                            // Badge stato rilevamento ("Client Rilevato" con dot verde #23a55a)
                                            Rectangle {
                                                height: 26px;
                                                border-radius: Theme.radius-pill;
                                                background: root.wow-path != "" ? #23a55a18 : #6d738018;
                                                border-width: 1px;
                                                border-color: root.wow-path != "" ? #23a55a40 : #6d738033;
                                                HorizontalLayout {
                                                    padding-left: 10px;
                                                    padding-right: 10px;
                                                    spacing: 6px;
                                                    alignment: center;
                                                    Rectangle {
                                                        width: 6px;
                                                        height: 6px;
                                                        border-radius: 3px;
                                                        background: root.wow-path != "" ? #23a55a : #6d7380;
                                                        y: (parent.height - self.height) / 2;
                                                    }
                                                    Text {
                                                        text: root.wow-path != "" ? ("Client Rilevato · " + root.wow-flavor) : "Client Non Rilevato";
                                                        color: root.wow-path != "" ? #23a55a : Theme.text-muted;
                                                        font-size: 11px;
                                                        font-weight: 600;
                                                        vertical-alignment: center;
                                                    }
                                                }
                                            }
                                        }

                                        // Input path elegante con tasto "Applica" pill
                                        HorizontalLayout {
                                            spacing: 10px;

                                            Rectangle {
                                                height: 38px;
                                                background: Theme.bg-input;
                                                border-radius: Theme.radius-pill;
                                                border-width: 1px;
                                                border-color: wow-path-focus.has-focus ? Theme.brand-primary : Theme.border-normal;
                                                animate border-color { duration: Theme.transition-fast; }

                                                if root.wow-path-input == "" && !wow-path-focus.has-focus : Text {
                                                    x: 16px;
                                                    y: 10px;
                                                    text: "Incolla o digita il percorso (es. Z:\\home\\deck\\Games\\World of Warcraft o C:\\Games\\...)";
                                                    color: Theme.text-muted;
                                                    font-size: 12px;
                                                }

                                                HorizontalLayout {
                                                    padding-left: 16px;
                                                    padding-right: 16px;
                                                    alignment: stretch;

                                                    wow-path-focus := TextInput {
                                                        text <=> root.wow-path-input;
                                                        color: Theme.text-primary;
                                                        font-size: 13px;
                                                        single-line: true;
                                                        horizontal-alignment: left;
                                                        vertical-alignment: center;
                                                        accepted => { root.set-custom-wow-path(self.text); }
                                                    }
                                                }
                                            }

                                            PrimaryButton {
                                                width: 110px;
                                                text: "Applica";
                                                icon: @image-url("assets/icons/check.svg");
                                                custom-height: 38px;
                                                clicked => { root.set-custom-wow-path(root.wow-path-input); }
                                            }
                                        }

                                        // Tasti rapidi pill: [ Sfoglia Cartella… ], [ Seleziona WoW.exe… ] e hint Steam Deck / Proton
                                        HorizontalLayout {
                                            spacing: 10px;
                                            alignment: start;

                                            SecondaryButton {
                                                text: "Sfoglia Cartella…";
                                                icon: @image-url("assets/icons/folder.svg");
                                                custom-height: 34px;
                                                clicked => { root.select-wow-folder(); }
                                            }

                                            SecondaryButton {
                                                text: "Seleziona WoW.exe…";
                                                icon: @image-url("assets/icons/file-text.svg");
                                                custom-height: 34px;
                                                clicked => { root.select-wow-file(); }
                                            }

                                            VerticalLayout {
                                                alignment: center;
                                                Text {
                                                    text: "Su Steam Deck / Linux (Proton) usa 'Seleziona WoW.exe' o incolla il percorso Z:\\...";
                                                    color: Theme.text-muted;
                                                    font-size: 11px;
                                                }
                                            }
                                        }
                                    }
                                }

                                // ==========================================
                                // SEZIONE 3: RISOLUZIONE FINESTRA & MODALITÀ SCHERMO
                                // ==========================================
                                Rectangle {
                                    border-radius: Theme.radius-md;
                                    background: Theme.bg-card;
                                    border-width: 1px;
                                    border-color: Theme.border-normal;

                                    VerticalLayout {
                                        padding: 16px;
                                        spacing: 12px;

                                        HorizontalLayout {
                                            alignment: space-between;
                                            VerticalLayout {
                                                spacing: 2px;
                                                Text {
                                                    text: "Risoluzione Finestra & Modalità Schermo";
                                                    color: Theme.text-primary;
                                                    font-size: 14px;
                                                    font-weight: 600;
                                                }
                                                Text {
                                                    text: "Adatta istantaneamente la dimensione del launcher allo schermo del tuo PC o Steam Deck.";
                                                    color: Theme.text-secondary;
                                                    font-size: 12px;
                                                }
                                            }

                                            Text {
                                                text: "Ridimensionabile dall'angolo ↘";
                                                color: Theme.brand-light;
                                                font-size: 11px;
                                                font-weight: 500;
                                                vertical-alignment: center;
                                            }
                                        }

                                        HorizontalLayout {
                                            spacing: 10px;

                                            SecondaryButton {
                                                text: "1020 × 680";
                                                custom-height: 36px;
                                                clicked => { root.set-window-size(1020, 680); }
                                            }

                                            PrimaryButton {
                                                text: "1180 × 760 (Consigliata)";
                                                custom-height: 36px;
                                                clicked => { root.set-window-size(1180, 760); }
                                            }

                                            SecondaryButton {
                                                text: "1360 × 860";
                                                custom-height: 36px;
                                                clicked => { root.set-window-size(1360, 860); }
                                            }

                                            SecondaryButton {
                                                text: "Schermo Intero";
                                                custom-height: 36px;
                                                clicked => { root.set-window-size(0, 0); }
                                            }
                                        }
                                    }
                                }

                                // ==========================================
                                // SEZIONE 5: INTEGRAZIONE GITHUB & BUG TRACKER
                                // ==========================================
                                Rectangle {
                                    border-radius: Theme.radius-md;
                                    background: Theme.bg-card;
                                    border-width: 1px;
                                    border-color: Theme.border-normal;

                                    VerticalLayout {
                                        padding: 16px;
                                        spacing: 14px;

                                        // Integrazione GitHub Issue
                                        VerticalLayout {
                                            spacing: 8px;

                                            HorizontalLayout {
                                                alignment: space-between;
                                                Text {
                                                    text: "Integrazione GitHub (Creazione automatica Issue & Segnalazioni)";
                                                    color: Theme.text-primary;
                                                    font-size: 13px;
                                                    font-weight: 600;
                                                }

                                                Text {
                                                    text: root.github-token != "" ? "Token configurato (Invio API attivo)" : "1-Click browser attivo";
                                                    color: root.github-token != "" ? Theme.status-success : Theme.brand-light;
                                                    font-size: 11px;
                                                    font-weight: 500;
                                                }
                                            }

                                            Rectangle {
                                                height: 38px;
                                                background: Theme.bg-input;
                                                border-radius: Theme.radius-pill;
                                                border-width: 1px;
                                                border-color: token-input.has-focus ? Theme.brand-primary : Theme.border-normal;

                                                animate border-color { duration: Theme.transition-fast; easing: ease-out; }

                                                token-touch := TouchArea {
                                                    mouse-cursor: text;
                                                    clicked => { token-input.focus(); }
                                                }

                                                if (root.github-token == "" && !token-input.has-focus) : Text {
                                                    x: 16px;
                                                    y: 10px;
                                                    text: "Opzionale: inserisci un Personal Access Token (ghp_...) per creare issue via API";
                                                    color: Theme.text-muted;
                                                    font-size: 12px;
                                                }

                                                HorizontalLayout {
                                                    padding-left: 16px;
                                                    padding-right: 16px;
                                                    alignment: stretch;

                                                    token-input := TextInput {
                                                        text <=> root.github-token;
                                                        color: Theme.text-primary;
                                                        font-size: 13px;
                                                        single-line: true;
                                                        horizontal-alignment: left;
                                                        vertical-alignment: center;
                                                    }
                                                }
                                            }

                                            Text {
                                                text: "Senza token, il pulsante apre il browser con titolo, etichette e corpo precompilati al 100% (zero click manuali).";
                                                color: Theme.text-muted;
                                                font-size: 11px;
                                            }
                                        }
                                    }
                                }

                                // ==========================================
                                // SEZIONE 5: MANUTENZIONE & RIPRISTINO (DUE CARD BILANCIATE)
                                // ==========================================
                                HorizontalLayout {
                                    spacing: 12px;

                                    // Card Ripristino / Verifica (Blu / Smeraldo)
                                    Rectangle {
                                        horizontal-stretch: 1;
                                        border-radius: Theme.radius-md;
                                        background: Theme.bg-card;
                                        border-width: 1px;
                                        border-color: Theme.border-normal;

                                        VerticalLayout {
                                            padding: 16px;
                                            spacing: 12px;
                                            alignment: space-between;

                                            VerticalLayout {
                                                spacing: 4px;
                                                HorizontalLayout {
                                                    spacing: 8px;
                                                    alignment: start;
                                                    Image {
                                                        width: 16px;
                                                        height: 16px;
                                                        source: @image-url("assets/icons/wrench.svg");
                                                        colorize: Theme.brand-light;
                                                        image-fit: contain;
                                                        vertical-alignment: center;
                                                    }
                                                    Text {
                                                        text: "Verifica e ripara file";
                                                        color: Theme.text-primary;
                                                        font-size: 14px;
                                                        font-weight: 600;
                                                        vertical-alignment: center;
                                                    }
                                                }
                                                Text {
                                                    text: "Scansiona tutti i pacchetti audio e riscarica solo i file mancanti o danneggiati.";
                                                    color: Theme.text-secondary;
                                                    font-size: 12px;
                                                }
                                            }

                                            SecondaryButton {
                                                text: "Esegui verifica";
                                                icon: @image-url("assets/icons/wrench.svg");
                                                custom-height: 38px;
                                                clicked => { root.start-repair(); }
                                            }
                                        }
                                    }

                                    // Card Disinstallazione (Rosso elegante)
                                    Rectangle {
                                        horizontal-stretch: 1;
                                        border-radius: Theme.radius-md;
                                        background: Theme.bg-card;
                                        border-width: 1px;
                                        border-color: Theme.btn-danger-border;

                                        VerticalLayout {
                                            padding: 16px;
                                            spacing: 12px;
                                            alignment: space-between;

                                            VerticalLayout {
                                                spacing: 4px;
                                                HorizontalLayout {
                                                    spacing: 8px;
                                                    alignment: start;
                                                    Image {
                                                        width: 16px;
                                                        height: 16px;
                                                        source: @image-url("assets/icons/trash-2.svg");
                                                        colorize: Theme.btn-danger-text;
                                                        image-fit: contain;
                                                        vertical-alignment: center;
                                                    }
                                                    Text {
                                                        text: "Disinstalla VivaVoce";
                                                        color: Theme.btn-danger-text;
                                                        font-size: 14px;
                                                        font-weight: 600;
                                                        vertical-alignment: center;
                                                    }
                                                }
                                                Text {
                                                    text: "Rimuove in modo pulito tutti i 6 pacchetti audio dalla cartella AddOns di WoW Forever.";
                                                    color: Theme.text-secondary;
                                                    font-size: 12px;
                                                }
                                            }

                                            DangerButton {
                                                text: "Disinstalla addon";
                                                icon: @image-url("assets/icons/trash-2.svg");
                                                custom-height: 38px;
                                                clicked => { root.start-uninstall(); }
                                            }
                                        }
                                    }
                                }

                                // Card 6: Dettagli Tecnici & Runtime
                                Rectangle {
                                    height: 48px;
                                    border-radius: Theme.radius-md;
                                    background: #0a0d13;
                                    border-width: 1px;
                                    border-color: Theme.border-subtle;

                                    HorizontalLayout {
                                        padding-left: 16px;
                                        padding-right: 16px;
                                        alignment: space-between;

                                        HorizontalLayout {
                                            spacing: 8px;
                                            alignment: center;
                                            Text { text: "Client WoW:"; color: Theme.text-muted; font-size: 12px; vertical-alignment: center; }
                                            Text { text: root.wow-flavor; color: Theme.text-secondary; font-size: 12px; font-weight: 500; vertical-alignment: center; }
                                        }

                                        HorizontalLayout {
                                            spacing: 8px;
                                            alignment: center;
                                            Text { text: "Audio engine:"; color: Theme.text-muted; font-size: 12px; vertical-alignment: center; }
                                            Text { text: "OGG Vorbis 48 kHz"; color: Theme.text-secondary; font-size: 12px; font-weight: 500; vertical-alignment: center; }
                                        }

                                        HorizontalLayout {
                                            spacing: 8px;
                                            alignment: center;
                                            Text { text: "GUI stack:"; color: Theme.text-muted; font-size: 12px; vertical-alignment: center; }
                                            Text { text: "Slint 1.18 (Skia)"; color: Theme.text-secondary; font-size: 12px; font-weight: 500; vertical-alignment: center; }
                                        }
                                    }
                                }
                            }
                        }
                    }
                }
            }
        }

        // Bottom-Right Corner Resize Grip (only visible when not maximized)
        if (!root.is-maximized) : Rectangle {
            x: parent.width - 20px;
            y: parent.height - 20px;
            width: 20px;
            height: 20px;
            background: transparent;

            resize-touch := TouchArea {
                mouse-cursor: nwse-resize;
                pointer-event(event) => {
                    if (event.kind == PointerEventKind.down && event.button == PointerEventButton.left) {
                        root.resize-window();
                    }
                }
            }

            Image {
                width: 14px;
                height: 14px;
                x: 3px;
                y: 3px;
                source: @image-url("assets/icons/grip.svg");
                colorize: resize-touch.has-hover ? Theme.brand-light : #475569;
                image-fit: contain;
                animate colorize { duration: Theme.transition-fast; }
            }
        }
    }
}
