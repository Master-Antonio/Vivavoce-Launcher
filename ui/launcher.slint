                                            // Wallpaper 2: Mulgore Plains
                                            Rectangle {
                                                horizontal-stretch: 1;
                                                height: 84px;
                                                border-radius: Theme.radius-md;
                                                background: root.selected-wallpaper == 2 ? #1c2333 : (wp2-touch.has-hover ? #19202f : #141822);
                                                border-width: root.selected-wallpaper == 2 ? 2px : 1px;
                                                border-color: root.selected-wallpaper == 2 ? Theme.brand-primary : (wp2-touch.has-hover ? #3d4d6b : #283347);
                                                clip: true;
                                                animate border-color { duration: Theme.transition-fast; }
                                                animate background { duration: Theme.transition-fast; }

                                                wp2-touch := TouchArea {
                                                    mouse-cursor: pointer;
                                                    clicked => { root.selected-wallpaper = 2; }
                                                }

                                                // Palette gradient swatch leggera (Dark Amber / Golden Mulgore)
                                                Rectangle {
                                                    width: 100%;
                                                    height: 100%;
                                                    background: @linear-gradient(135deg, #4d2b0e 0%, #361f0a 60%, #150d06 100%);
                                                    opacity: root.selected-wallpaper == 2 ? 0.95 : 0.65;
                                                }

                                                Rectangle {
                                                    width: 100%;
                                                    height: 100%;
                                                    background: @linear-gradient(180deg, transparent 0%, #0b0e14d0 100%);
                                                }

                                                VerticalLayout {
                                                    padding-left: 12px;
