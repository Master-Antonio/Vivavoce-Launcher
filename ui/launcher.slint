                                                                    alignment: center;
                                                                    Rectangle {
                                                                        width: 6px;
                                                                        height: 6px;
                                                                        border-radius: 3px;
                                                                        background: root.selected-wallpaper == 0 ? #ffffff : #6d7380;
                                                                    }
                                                                }
                                                                VerticalLayout {
                                                                    alignment: center;
                                                                    Text {
                                                                        text: root.selected-wallpaper == 0 ? "Attivo" : "Seleziona";
                                                                        color: root.selected-wallpaper == 0 ? #ffffff : #949ba4;
                                                                        font-size: Theme.font-size-xs;
                                                                        font-weight: 700;
                                                                        vertical-alignment: center;
                                                                    }
                                                                }
                                                            }
                                                        }
                                                    }

                                                    VerticalLayout {
                                                        spacing: 1px;
                                                        Text {
                                                            text: "Campfire Night";
