import { Theme } from "theme.slint";
import { TitleBar } from "components/titlebar.slint";
import { ProgressBar } from "components/progress_bar.slint";
import { StatusBadge } from "components/status_badge.slint";
import { BugCard, DialogueEntry } from "components/bug_card.slint";
import { PackageCard, PackageInfo } from "components/package_card.slint";
import { PrimaryButton, SecondaryButton, DangerButton } from "components/buttons.slint";
import { ScrollView } from "std-widgets.slint";

export { DialogueEntry, PackageInfo }

export component MainWindow inherits Window {
    title: "VivaVoce — WoW Voiceover Launcher";
    width: 960px;
    height: 640px;
    no-frame: true;
    background: transparent;

    // === REACTIVE PROPERTIES EXPOSED TO RUST ===
    in-out property <float> progress: 0.0;
    in-out property <string> status-text: "Pronto";
    in-out property <string> sub_status_text: "";
    in-out property <bool> is-updating: false;
    in-out property <string> wow-path: "";
    in-out property <string> wow-flavor: "_forever_";
    in-out property <bool> is-installed: false;
    in-out property <bool> has-update: false;
    in-out property <string> installed-version: "";
    in-out property <string> remote-version: "1.0.0";
    in-out property <int> active-tab: 0; // 0: Dashboard, 1: Pacchetti, 2: Bug Report, 3: Impostazioni

    // Data models
    in-out property <[DialogueEntry]> recent-dialogues: [];
    in-out property <[PackageInfo]> packages: [];

    // === CALLBACKS EXPOSED TO RUST ===
    callback start-update();
    callback start-repair();
    callback start-uninstall();
    callback submit-bug-report(string /* type */, string /* details */, string /* sound_file */);
    callback select-wow-folder();
    callback launch-game();
    callback close-window();
    callback minimize-window();
    callback open-url(string);
    callback open-addons-folder();
    callback drag-window();

    // Main App Shell (Doppelrand with Outer Glowing Frame)
    Rectangle {
        width: 100%;
        height: 100%;
        border-radius: Theme.radius-lg;
        background: Theme.main-window-gradient;
        border-width: 1px;
        border-color: Theme.border-normal;
        clip: true;

        VerticalLayout {
            // Top Frameless TitleBar
            TitleBar {
                minimize-clicked => { root.minimize-window(); }
                close-clicked => { root.close-window(); }
                drag-window => { root.drag-window(); }
            }

            // Main Application Body: Left Sidebar + Right Content Area
            HorizontalLayout {
                // === LEFT SIDEBAR NAVIGATION ===
                sidebar := Rectangle {
                    width: 210px;
                    background: Theme.bg-sidebar;

                    // Subtle right separator line
                    Rectangle {
                        x: parent.width - 1px;
                        width: 1px;
                        height: parent.height;
                        background: Theme.border-subtle;
                    }

                    VerticalLayout {
                        padding-left: 12px;
                        padding-right: 12px;
                        padding-top: 14px;
                        padding-bottom: 14px;
                        alignment: space-between;

                        // Top Sidebar Brand Card
                        VerticalLayout {
                            spacing: 14px;

                            Rectangle {
                                height: 56px;
                                border-radius: Theme.radius-md;
                                background: Theme.bg-panel;
                                border-width: 1px;
                                border-color: Theme.border-subtle;

                                HorizontalLayout {
                                    padding-left: 10px;
                                    padding-right: 10px;
                                    alignment: start;
                                    spacing: 10px;

                                    Rectangle {
                                        width: 34px;
                                        height: 34px;
                                        y: (parent.height - self.height) / 2;
                                        border-radius: Theme.radius-sm;
                                        background: @linear-gradient(135deg, #2b200e 0%, #17151e 100%);
                                        border-width: 1px;
                                        border-color: Theme.border-gold-normal;

                                        Text {
                                            text: "🎙️";
                                            font-size: 16px;
                                            horizontal-alignment: center;
                                            vertical-alignment: center;
                                        }
                                    }

                                    VerticalLayout {
                                        alignment: center;
                                        spacing: 2px;

                                        Text {
                                            text: "VIVAVOCE";
                                            color: Theme.gold-bright;
                                            font-size: 13px;
                                            font-weight: 800;
                                            letter-spacing: 0.8px;
                                        }

                                        Text {
                                            text: "Voiceover Italiano";
                                            color: Theme.text-secondary;
                                            font-size: 10px;
                                            font-weight: 500;
                                        }
                                    }
                                }
                            }

                            // Navigation Items
                            VerticalLayout {
                                spacing: 5px;

                                // Tab 0: Dashboard
                                tab0 := Rectangle {
                                    height: 40px;
                                    x: t0-touch.pressed ? 1.5px : 0px;
                                    border-radius: Theme.radius-sm;
                                    background: root.active-tab == 0 ? #1c2436 : (t0-touch.has-hover ? #131a26 : transparent);
                                    border-width: 1px;
                                    border-color: root.active-tab == 0 ? Theme.border-gold-subtle : transparent;

                                    animate x { duration: Theme.transition-instant; easing: ease-out; }
                                    animate background { duration: Theme.transition-fast; easing: ease-out; }
                                    animate border-color { duration: Theme.transition-fast; easing: ease-out; }

                                    // Active gold bar marker
                                    if (root.active-tab == 0) : Rectangle {
                                        x: 0;
                                        y: 6px;
                                        width: 3px;
                                        height: parent.height - 12px;
                                        border-radius: 1.5px;
                                        background: Theme.gold-bright;
                                    }

                                    t0-touch := TouchArea {
                                        mouse-cursor: pointer;
                                        clicked => { root.active-tab = 0; }
                                    }

                                    HorizontalLayout {
                                        padding-left: 14px;
                                        padding-right: 12px;
                                        spacing: 10px;

                                        Text {
                                            text: "🛡️";
                                            font-size: 14px;
                                            vertical-alignment: center;
                                        }
                                        Text {
                                            text: "Dashboard";
                                            color: root.active-tab == 0 ? Theme.gold-bright : (t0-touch.has-hover ? Theme.text-primary : Theme.text-secondary);
                                            font-size: 13px;
                                            font-weight: root.active-tab == 0 ? 700 : 500;
                                            vertical-alignment: center;
                                        }
                                    }
                                }

                                // Tab 1: Pacchetti & Dettagli
                                tab1 := Rectangle {
                                    height: 40px;
                                    x: t1-touch.pressed ? 1.5px : 0px;
                                    border-radius: Theme.radius-sm;
                                    background: root.active-tab == 1 ? #1c2436 : (t1-touch.has-hover ? #131a26 : transparent);
                                    border-width: 1px;
                                    border-color: root.active-tab == 1 ? Theme.border-gold-subtle : transparent;

                                    animate x { duration: Theme.transition-instant; easing: ease-out; }
                                    animate background { duration: Theme.transition-fast; easing: ease-out; }
                                    animate border-color { duration: Theme.transition-fast; easing: ease-out; }

                                    if (root.active-tab == 1) : Rectangle {
                                        x: 0;
                                        y: 6px;
                                        width: 3px;
                                        height: parent.height - 12px;
                                        border-radius: 1.5px;
                                        background: Theme.gold-bright;
                                    }

                                    t1-touch := TouchArea {
                                        mouse-cursor: pointer;
                                        clicked => { root.active-tab = 1; }
                                    }

                                    HorizontalLayout {
                                        padding-left: 14px;
                                        padding-right: 12px;
                                        spacing: 10px;

                                        Text {
                                            text: "📦";
                                            font-size: 14px;
                                            vertical-alignment: center;
                                        }
                                        Text {
                                            text: "Pacchetti & Dettagli";
                                            color: root.active-tab == 1 ? Theme.gold-bright : (t1-touch.has-hover ? Theme.text-primary : Theme.text-secondary);
                                            font-size: 13px;
                                            font-weight: root.active-tab == 1 ? 700 : 500;
                                            vertical-alignment: center;
                                        }
                                    }
                                }

                                // Tab 2: Segnala Bug
                                tab2 := Rectangle {
                                    height: 40px;
                                    x: t2-touch.pressed ? 1.5px : 0px;
                                    border-radius: Theme.radius-sm;
                                    background: root.active-tab == 2 ? #1c2436 : (t2-touch.has-hover ? #131a26 : transparent);
                                    border-width: 1px;
                                    border-color: root.active-tab == 2 ? Theme.border-gold-subtle : transparent;

                                    animate x { duration: Theme.transition-instant; easing: ease-out; }
                                    animate background { duration: Theme.transition-fast; easing: ease-out; }
                                    animate border-color { duration: Theme.transition-fast; easing: ease-out; }

                                    if (root.active-tab == 2) : Rectangle {
                                        x: 0;
                                        y: 6px;
                                        width: 3px;
                                        height: parent.height - 12px;
                                        border-radius: 1.5px;
                                        background: Theme.gold-bright;
                                    }

                                    t2-touch := TouchArea {
                                        mouse-cursor: pointer;
                                        clicked => { root.active-tab = 2; }
                                    }

                                    HorizontalLayout {
                                        padding-left: 14px;
                                        padding-right: 12px;
                                        spacing: 10px;

                                        Text {
                                            text: "🐛";
                                            font-size: 14px;
                                            vertical-alignment: center;
                                        }
                                        Text {
                                            text: "Segnala Bug";
                                            color: root.active-tab == 2 ? Theme.gold-bright : (t2-touch.has-hover ? Theme.text-primary : Theme.text-secondary);
                                            font-size: 13px;
                                            font-weight: root.active-tab == 2 ? 700 : 500;
                                            vertical-alignment: center;
                                        }
                                    }
                                }

                                // Tab 3: Impostazioni
                                tab3 := Rectangle {
                                    height: 40px;
                                    x: t3-touch.pressed ? 1.5px : 0px;
                                    border-radius: Theme.radius-sm;
                                    background: root.active-tab == 3 ? #1c2436 : (t3-touch.has-hover ? #131a26 : transparent);
                                    border-width: 1px;
                                    border-color: root.active-tab == 3 ? Theme.border-gold-subtle : transparent;

                                    animate x { duration: Theme.transition-instant; easing: ease-out; }
                                    animate background { duration: Theme.transition-fast; easing: ease-out; }
                                    animate border-color { duration: Theme.transition-fast; easing: ease-out; }

                                    if (root.active-tab == 3) : Rectangle {
                                        x: 0;
                                        y: 6px;
                                        width: 3px;
                                        height: parent.height - 12px;
                                        border-radius: 1.5px;
                                        background: Theme.gold-bright;
                                    }

                                    t3-touch := TouchArea {
                                        mouse-cursor: pointer;
                                        clicked => { root.active-tab = 3; }
                                    }

                                    HorizontalLayout {
                                        padding-left: 14px;
                                        padding-right: 12px;
                                        spacing: 10px;

                                        Text {
                                            text: "⚙️";
                                            font-size: 14px;
                                            vertical-alignment: center;
                                        }
                                        Text {
                                            text: "Impostazioni";
                                            color: root.active-tab == 3 ? Theme.gold-bright : (t3-touch.has-hover ? Theme.text-primary : Theme.text-secondary);
                                            font-size: 13px;
                                            font-weight: root.active-tab == 3 ? 700 : 500;
                                            vertical-alignment: center;
                                        }
                                    }
                                }
                            }
                        }

                        // Bottom Sidebar Info & Community Links
                        VerticalLayout {
                            spacing: 8px;

                            // WoW Flavor Badge
                            Rectangle {
                                height: 30px;
                                border-radius: Theme.radius-sm;
                                background: #10141d;
                                border-width: 1px;
                                border-color: Theme.border-subtle;

                                HorizontalLayout {
                                    padding-left: 10px;
                                    padding-right: 10px;
                                    alignment: space-between;

                                    Text {
                                        text: "Client:";
                                        color: Theme.text-muted;
                                        font-size: 11px;
                                        vertical-alignment: center;
                                    }

                                    Text {
                                        text: root.wow-flavor == "_forever_" ? "1.12.1 Forever" : root.wow-flavor;
                                        color: Theme.gold-light;
                                        font-size: 11px;
                                        font-weight: 600;
                                        vertical-alignment: center;
                                    }
                                }
                            }

                            // Community Buttons Row
                            HorizontalLayout {
                                spacing: 6px;

                                // Discord Link
                                Rectangle {
                                    height: 30px;
                                    y: d-touch.pressed ? 1px : 0px;
                                    border-radius: Theme.radius-xs;
                                    background: d-touch.has-hover ? #1f2738 : #121622;
                                    border-width: 1px;
                                    border-color: d-touch.has-hover ? Theme.border-gold-subtle : Theme.border-subtle;

                                    animate y { duration: Theme.transition-instant; easing: ease-out; }
                                    animate background { duration: Theme.transition-fast; easing: ease-out; }
                                    animate border-color { duration: Theme.transition-fast; easing: ease-out; }

                                    d-touch := TouchArea {
                                        mouse-cursor: pointer;
                                        clicked => { root.open-url("https://discord.gg/vivavoce"); }
                                    }

                                    HorizontalLayout {
                                        alignment: center;
                                        spacing: 4px;
                                        Text {
                                            text: "💬 Discord";
                                            color: d-touch.has-hover ? Theme.gold-light : Theme.text-secondary;
                                            font-size: 11px;
                                            font-weight: 600;
                                            vertical-alignment: center;
                                        }
                                    }
                                }

                                // GitHub Link
                                Rectangle {
                                    height: 30px;
                                    y: g-touch.pressed ? 1px : 0px;
                                    border-radius: Theme.radius-xs;
                                    background: g-touch.has-hover ? #1f2738 : #121622;
                                    border-width: 1px;
                                    border-color: g-touch.has-hover ? Theme.border-gold-subtle : Theme.border-subtle;

                                    animate y { duration: Theme.transition-instant; easing: ease-out; }
                                    animate background { duration: Theme.transition-fast; easing: ease-out; }
                                    animate border-color { duration: Theme.transition-fast; easing: ease-out; }

                                    g-touch := TouchArea {
                                        mouse-cursor: pointer;
                                        clicked => { root.open-url("https://github.com/VivaVoceProject/VivaVoce"); }
                                    }

                                    HorizontalLayout {
                                        alignment: center;
                                        spacing: 4px;
                                        Text {
                                            text: "⭐ GitHub";
                                            color: g-touch.has-hover ? Theme.gold-light : Theme.text-secondary;
                                            font-size: 11px;
                                            font-weight: 600;
                                            vertical-alignment: center;
                                        }
                                    }
                                }
                            }
                        }
                    }
                }

                // === RIGHT MAIN CONTENT VIEW ===
                content-view := Rectangle {
                    background: transparent;

                    VerticalLayout {
                        padding-left: 22px;
                        padding-right: 22px;
                        padding-top: 14px;
                        padding-bottom: 16px;

                        // ==========================================
                        // TAB 0: DASHBOARD
                        // ==========================================
                        if (root.active-tab == 0) : VerticalLayout {
                            spacing: 12px;
                            alignment: start;

                            // Top Header Block with Status Badge
                            HorizontalLayout {
                                alignment: space-between;

                                VerticalLayout {
                                    spacing: 3px;
                                    Text {
                                        text: "World of Warcraft — Voiceover Italiano";
                                        color: Theme.text-primary;
                                        font-size: 20px;
                                        font-weight: 800;
                                    }
                                    Text {
                                        text: "Rivivi l'epica di Azeroth con dialoghi e missioni interamente recitati in italiano.";
                                        color: Theme.text-secondary;
                                        font-size: 12px;
                                    }
                                }

                                // Live Status Badge (Top Right)
                                StatusBadge {
                                    is-installed: root.is-installed;
                                    has-update: root.has-update;
                                    is-verifying: root.is-updating;
                                    installed-version: root.installed-version;
                                }
                            }

                            // Hero Stats Card: 3 Balanced Metric Columns (Height: 90px)
                            Rectangle {
                                height: 90px;
                                border-radius: Theme.radius-md;
                                background: Theme.panel-gradient;
                                border-width: 1px;
                                border-color: Theme.border-normal;

                                HorizontalLayout {
                                    padding: 12px;
                                    alignment: space-around;

                                    // Stat 1: 27.420 battute
                                    VerticalLayout {
                                        alignment: center;
                                        spacing: 3px;
                                        HorizontalLayout {
                                            alignment: center;
                                            spacing: 6px;
                                            Text { text: "⚔️"; font-size: 14px; vertical-alignment: center; }
                                            Text {
                                                text: "27.420";
                                                color: Theme.gold-bright;
                                                font-size: 22px;
                                                font-weight: 800;
                                                vertical-alignment: center;
                                            }
                                        }
                                        Text {
                                            text: "Battute Vocali Recitate";
                                            color: Theme.text-secondary;
                                            font-size: 11px;
                                            font-weight: 500;
                                            horizontal-alignment: center;
                                        }
                                    }

                                    // Divider Line
                                    Rectangle { width: 1px; height: 50px; background: Theme.border-subtle; y: (parent.height - self.height) / 2; }

                                    // Stat 2: Missioni & Libri
                                    VerticalLayout {
                                        alignment: center;
                                        spacing: 3px;
                                        HorizontalLayout {
                                            alignment: center;
                                            spacing: 6px;
                                            Text { text: "📜"; font-size: 14px; vertical-alignment: center; }
                                            Text {
                                                text: "2.500+";
                                                color: Theme.gold-bright;
                                                font-size: 22px;
                                                font-weight: 800;
                                                vertical-alignment: center;
                                            }
                                        }
                                        Text {
                                            text: "Missioni & Libri Doppiati";
                                            color: Theme.text-secondary;
                                            font-size: 11px;
                                            font-weight: 500;
                                            horizontal-alignment: center;
                                        }
                                    }

                                    // Divider Line
                                    Rectangle { width: 1px; height: 50px; background: Theme.border-subtle; y: (parent.height - self.height) / 2; }

                                    // Stat 3: Integrità Blake3
                                    VerticalLayout {
                                        alignment: center;
                                        spacing: 3px;
                                        HorizontalLayout {
                                            alignment: center;
                                            spacing: 6px;
                                            Text { text: "🛡️"; font-size: 14px; vertical-alignment: center; }
                                            Text {
                                                text: "6/6 Moduli";
                                                color: Theme.gold-bright;
                                                font-size: 22px;
                                                font-weight: 800;
                                                vertical-alignment: center;
                                            }
                                        }
                                        Text {
                                            text: "Integrità Blake3 OK";
                                            color: Theme.text-secondary;
                                            font-size: 11px;
                                            font-weight: 500;
                                            horizontal-alignment: center;
                                        }
                                    }
                                }
                            }

                            // WoW Directory Card: Structured Game Client Bar (Height: 64px)
                            Rectangle {
                                height: 64px;
                                border-radius: Theme.radius-md;
                                background: Theme.bg-card;
                                border-width: 1px;
                                border-color: Theme.border-subtle;

                                HorizontalLayout {
                                    padding-left: 14px;
                                    padding-right: 14px;
                                    alignment: space-between;

                                    VerticalLayout {
                                        alignment: center;
                                        spacing: 3px;

                                        HorizontalLayout {
                                            spacing: 6px;
                                            alignment: start;
                                            Text {
                                                text: "📁 Installazione WoW:";
                                                color: Theme.gold-light;
                                                font-size: 11px;
                                                font-weight: 700;
                                                vertical-alignment: center;
                                            }
                                            Rectangle {
                                                height: 16px;
                                                border-radius: Theme.radius-xs;
                                                background: #c89b3c1a;
                                                border-width: 1px;
                                                border-color: #c89b3c33;
                                                HorizontalLayout {
                                                    padding-left: 5px;
                                                    padding-right: 5px;
                                                    Text {
                                                        text: root.wow-flavor == "_forever_" ? "Forever 1.12.1" : root.wow-flavor;
                                                        color: Theme.gold-bright;
                                                        font-size: 9px;
                                                        font-weight: 700;
                                                        vertical-alignment: center;
                                                    }
                                                }
                                            }
                                        }

                                        Text {
                                            text: root.wow-path != "" ? root.wow-path : "Nessun percorso rilevato automaticamente. Clicca su Sfoglia per impostarlo.";
                                            color: root.wow-path != "" ? Theme.text-primary : Theme.text-muted;
                                            font-size: 11px;
                                            overflow: elide;
                                            max-width: 440px;
                                        }
                                    }

                                    HorizontalLayout {
                                        alignment: center;
                                        spacing: 8px;

                                        SecondaryButton {
                                            text: "Sfoglia...";
                                            icon: "🔍";
                                            custom-height: 34px;
                                            clicked => { root.select-wow-folder(); }
                                        }

                                        SecondaryButton {
                                            text: "AddOns";
                                            icon: "📂";
                                            custom-height: 34px;
                                            clicked => { root.open-addons-folder(); }
                                        }
                                    }
                                }
                            }

                            // Hero Command Center Card: Primary CTA + Diagnostic Features Grid (Height: 236px)
                            Rectangle {
                                height: 236px;
                                border-radius: Theme.radius-md;
                                background: Theme.panel-gradient;
                                border-width: 1px;
                                border-color: Theme.border-normal;

                                VerticalLayout {
                                    padding: 18px;
                                    spacing: 14px;
                                    alignment: space-between;

                                    // Top CTA Bar or Progress Bar
                                    if (root.is-updating) : VerticalLayout {
                                        spacing: 8px;
                                        ProgressBar {
                                            progress: root.progress;
                                            title: root.status-text;
                                            details: root.sub_status_text;
                                            is-active: true;
                                        }
                                    }

                                    if (!root.is-updating) : HorizontalLayout {
                                        spacing: 12px;
                                        alignment: center;

                                        // Giant Primary CTA Button
                                        PrimaryButton {
                                            width: 280px;
                                            custom-height: 50px;
                                            text: !root.is-installed ? "INSTALLA VIVAVOCE" : (root.has-update ? ("AGGIORNA A v" + root.remote-version) : "AVVIA WORLD OF WARCRAFT");
                                            icon: !root.is-installed ? "⬇️" : (root.has-update ? "✨" : "⚔️");
                                            enabled: true;

                                            clicked => {
                                                if (!root.is-installed || root.has-update) {
                                                    root.start-update();
                                                } else {
                                                    root.launch-game();
                                                }
                                            }
                                        }

                                        // Secondary Repair Button
                                        if (root.is-installed) : SecondaryButton {
                                            width: 180px;
                                            custom-height: 50px;
                                            text: "Verifica e Ripara";
                                            icon: "🔧";
                                            clicked => { root.start-repair(); }
                                        }
                                    }

                                    // Subtle horizontal separator
                                    Rectangle { height: 1px; background: Theme.border-subtle; }

                                    // Feature Highlights Grid: Eliminates Dead Empty Space with Craft
                                    HorizontalLayout {
                                        spacing: 10px;
                                        alignment: space-around;

                                        // Feature 1
                                        Rectangle {
                                            background: #0d1119;
                                            border-radius: Theme.radius-sm;
                                            border-width: 1px;
                                            border-color: Theme.border-subtle;
                                            HorizontalLayout {
                                                padding: 10px;
                                                spacing: 8px;
                                                Text { text: "🎙️"; font-size: 16px; vertical-alignment: center; }
                                                VerticalLayout {
                                                    alignment: center;
                                                    spacing: 2px;
                                                    Text { text: "100% Italiano"; color: Theme.gold-light; font-size: 11px; font-weight: 700; }
                                                    Text { text: "Doppiaggio & quest lore"; color: Theme.text-muted; font-size: 10px; }
                                                }
                                            }
                                        }

                                        // Feature 2
                                        Rectangle {
                                            background: #0d1119;
                                            border-radius: Theme.radius-sm;
                                            border-width: 1px;
                                            border-color: Theme.border-subtle;
                                            HorizontalLayout {
                                                padding: 10px;
                                                spacing: 8px;
                                                Text { text: "⚡"; font-size: 16px; vertical-alignment: center; }
                                                VerticalLayout {
                                                    alignment: center;
                                                    spacing: 2px;
                                                    Text { text: "Zero Lag FPS"; color: Theme.gold-light; font-size: 11px; font-weight: 700; }
                                                    Text { text: "Stream OGG Vorbis 48kHz"; color: Theme.text-muted; font-size: 10px; }
                                                }
                                            }
                                        }

                                        // Feature 3
                                        Rectangle {
                                            background: #0d1119;
                                            border-radius: Theme.radius-sm;
                                            border-width: 1px;
                                            border-color: Theme.border-subtle;
                                            HorizontalLayout {
                                                padding: 10px;
                                                spacing: 8px;
                                                Text { text: "🔒"; font-size: 16px; vertical-alignment: center; }
                                                VerticalLayout {
                                                    alignment: center;
                                                    spacing: 2px;
                                                    Text { text: "Sicuro & Isolato"; color: Theme.gold-light; font-size: 11px; font-weight: 700; }
                                                    Text { text: "Nessun file client alterato"; color: Theme.text-muted; font-size: 10px; }
                                                }
                                            }
                                        }
                                    }

                                    // Disclaimer Footer
                                    Text {
                                        text: "VivaVoce integra l'audio OGG compresso con gli AddOn VoiceOver ufficiali senza alterare i file di gioco Blizzard.";
                                        color: Theme.text-muted;
                                        font-size: 11px;
                                        horizontal-alignment: center;
                                    }
                                }
                            }
                        }

                        // ==========================================
                        // TAB 1: PACCHETTI & DETTAGLI (6 Moduli Compact)
                        // ==========================================
                        if (root.active-tab == 1) : VerticalLayout {
                            spacing: 10px;
                            alignment: start;

                            // Tab Header
                            HorizontalLayout {
                                alignment: space-between;

                                VerticalLayout {
                                    spacing: 3px;
                                    Text {
                                        text: "📦 Moduli VivaVoce & Verifica Blake3";
                                        color: Theme.text-primary;
                                        font-size: 18px;
                                        font-weight: 700;
                                    }
                                    Text {
                                        text: "Stato dei 6 componenti modulari della localizzazione audio italiana.";
                                        color: Theme.text-secondary;
                                        font-size: 12px;
                                    }
                                }

                                HorizontalLayout {
                                    spacing: 8px;
                                    alignment: center;

                                    SecondaryButton {
                                        text: "Verifica Tutti";
                                        icon: "🛡️";
                                        custom-height: 34px;
                                        clicked => { root.start-repair(); }
                                    }

                                    SecondaryButton {
                                        text: "Cartella AddOns";
                                        icon: "📂";
                                        custom-height: 34px;
                                        clicked => { root.open-addons-folder(); }
                                    }
                                }
                            }

                            // Scrollable list of modules (All 6 fit cleanly!)
                            ScrollView {
                                height: 490px;
                                VerticalLayout {
                                    spacing: 6px;
                                    padding-right: 4px;

                                    // Dynamic packages from Rust
                                    for pkg in root.packages : PackageCard {
                                        package-data: pkg;
                                    }

                                    // Default fallback when packages list is empty
                                    if (root.packages.length == 0) : VerticalLayout {
                                        spacing: 6px;

                                        PackageCard {
                                            icon: "⚙️";
                                            package-data: {
                                                id: "vivavoce-core",
                                                name: "VivaVoce Core",
                                                description: "Motore audio principale, gestione code, sottotitoli e opzioni",
                                                filename: "vivavoce-core.tar.zst",
                                                size-str: "865 KB",
                                                installed: root.is-installed,
                                                verified: root.is-installed,
                                                blake3-hash: "b3f8...91a2"
                                            };
                                        }

                                        PackageCard {
                                            icon: "📜";
                                            package-data: {
                                                id: "vivavoce-quests",
                                                name: "VivaVoce Quests",
                                                description: "15.838 battute: dialoghi quest, gossip NPC, accettazione e completamento",
                                                filename: "vivavoce-quests.tar.zst",
                                                size-str: "2.48 GB",
                                                installed: root.is-installed,
                                                verified: root.is-installed,
                                                blake3-hash: "7c2d...4401"
                                            };
                                        }

                                        PackageCard {
                                            icon: "📖";
                                            package-data: {
                                                id: "vivavoce-books",
                                                name: "VivaVoce Books",
                                                description: "5.594 battute: tomi di Azeroth, lettere, diari, pergamene e lapidi",
                                                filename: "vivavoce-books.tar.zst",
                                                size-str: "1.12 GB",
                                                installed: root.is-installed,
                                                verified: root.is-installed,
                                                blake3-hash: "33aa...ff99"
                                            };
                                        }

                                        PackageCard {
                                            icon: "🗣️";
                                            package-data: {
                                                id: "vivavoce-codex",
                                                name: "VivaVoce Codex",
                                                description: "1.606 battute: supporto a CodexIT e missioni lore classiche",
                                                filename: "vivavoce-codex.tar.zst",
                                                size-str: "385 MB",
                                                installed: root.is-installed,
                                                verified: root.is-installed,
                                                blake3-hash: "19e0...8821"
                                            };
                                        }

                                        PackageCard {
                                            icon: "🗺️";
                                            package-data: {
                                                id: "vivavoce-zones",
                                                name: "VivaVoce Zones",
                                                description: "Annunci e tracce d'atmosfera delle zone del mondo",
                                                filename: "vivavoce-zones.tar.zst",
                                                size-str: "120 MB",
                                                installed: root.is-installed,
                                                verified: root.is-installed,
                                                blake3-hash: "4fa1...bb12"
                                            };
                                        }

                                        PackageCard {
                                            icon: "🐛";
                                            package-data: {
                                                id: "vivavoce-collector",
                                                name: "VivaVoce Collector",
                                                description: "Registratore SavedVariables per report di bug e pronunce in-game",
                                                filename: "vivavoce-collector.tar.zst",
                                                size-str: "15 KB",
                                                installed: root.is-installed,
                                                verified: root.is-installed,
                                                blake3-hash: "6c9d...ff51"
                                            };
                                        }
                                    }
                                }
                            }
                        }

                        // ==========================================
                        // TAB 2: SEGNALA BUG
                        // ==========================================
                        if (root.active-tab == 2) : VerticalLayout {
                            spacing: 12px;
                            alignment: start;

                            BugCard {
                                recent-dialogues: root.recent-dialogues;

                                submit-report(cat, desc, sound) => {
                                    root.submit-bug-report(cat, desc, sound);
                                }

                                open-github(cat, desc, sound) => {
                                    root.open-url("https://github.com/VivaVoceProject/VivaVoce/issues/new");
                                }
                            }
                        }

                        // ==========================================
                        // TAB 3: IMPOSTAZIONI
                        // ==========================================
                        if (root.active-tab == 3) : VerticalLayout {
                            spacing: 14px;
                            alignment: start;

                            // Settings Header
                            VerticalLayout {
                                spacing: 3px;
                                Text {
                                    text: "⚙️ Impostazioni del Launcher";
                                    color: Theme.text-primary;
                                    font-size: 18px;
                                    font-weight: 700;
                                }
                                Text {
                                    text: "Configurazione cartella di gioco, manutenzione e disinstallazione pulita.";
                                    color: Theme.text-secondary;
                                    font-size: 12px;
                                }
                            }

                            // Card 1: Percorso World of Warcraft (Height: 110px)
                            Rectangle {
                                height: 110px;
                                border-radius: Theme.radius-md;
                                background: Theme.bg-panel;
                                border-width: 1px;
                                border-color: Theme.border-normal;

                                VerticalLayout {
                                    padding: 16px;
                                    spacing: 10px;
                                    alignment: center;

                                    Text {
                                        text: "CARTELLA WORLD OF WARCRAFT";
                                        color: Theme.gold-light;
                                        font-size: 11px;
                                        font-weight: 700;
                                        letter-spacing: 0.8px;
                                    }

                                    HorizontalLayout {
                                        spacing: 10px;

                                        Rectangle {
                                            height: 38px;
                                            background: Theme.bg-input;
                                            border-radius: Theme.radius-sm;
                                            border-width: 1px;
                                            border-color: Theme.border-normal;

                                            HorizontalLayout {
                                                padding-left: 12px;
                                                padding-right: 12px;
                                                Text {
                                                    text: root.wow-path != "" ? root.wow-path : "Nessun percorso selezionato";
                                                    color: root.wow-path != "" ? Theme.text-primary : Theme.text-muted;
                                                    font-size: 12px;
                                                    vertical-alignment: center;
                                                    overflow: elide;
                                                }
                                            }
                                        }

                                        SecondaryButton {
                                            width: 120px;
                                            text: "Cambia...";
                                            icon: "📁";
                                            custom-height: 38px;
                                            clicked => { root.select-wow-folder(); }
                                        }
                                    }

                                    Text {
                                        text: "Il launcher verifica automaticamente la presenza della cartella Interface/AddOns/ e dei file manifest.";
                                        color: Theme.text-muted;
                                        font-size: 11px;
                                    }
                                }
                            }

                            // Card 2: Manutenzione & Disinstallazione (Fixed Height & Aligned Widths, NO GAPS!)
                            Rectangle {
                                height: 154px;
                                border-radius: Theme.radius-md;
                                background: Theme.bg-panel;
                                border-width: 1px;
                                border-color: Theme.border-normal;

                                VerticalLayout {
                                    padding: 16px;
                                    spacing: 10px;
                                    alignment: start;

                                    Text {
                                        text: "MANUTENZIONE & RIMOZIONE ADDON";
                                        color: Theme.gold-light;
                                        font-size: 11px;
                                        font-weight: 700;
                                        letter-spacing: 0.8px;
                                    }

                                    // Row 1: Ripara
                                    HorizontalLayout {
                                        alignment: space-between;

                                        VerticalLayout {
                                            spacing: 2px;
                                            alignment: center;

                                            Text {
                                                text: "Ripara File AddOn";
                                                color: Theme.text-primary;
                                                font-size: 13px;
                                                font-weight: 600;
                                            }
                                            Text {
                                                text: "Ricalcola gli hash Blake3 e riscarica solo i file mancanti o corrotti.";
                                                color: Theme.text-secondary;
                                                font-size: 11px;
                                            }
                                        }

                                        SecondaryButton {
                                            width: 175px;
                                            text: "Esegui Riparazione";
                                            icon: "🔧";
                                            custom-height: 36px;
                                            clicked => { root.start-repair(); }
                                        }
                                    }

                                    Rectangle { height: 1px; background: Theme.border-subtle; }

                                    // Row 2: Disinstalla (Matching 175px Width!)
                                    HorizontalLayout {
                                        alignment: space-between;

                                        VerticalLayout {
                                            spacing: 2px;
                                            alignment: center;

                                            Text {
                                                text: "Disinstalla VivaVoce";
                                                color: #fca5a5;
                                                font-size: 13px;
                                                font-weight: 600;
                                            }
                                            Text {
                                                text: "Rimuove in modo pulito tutti i 6 pacchetti audio dalla cartella AddOns di WoW.";
                                                color: Theme.text-secondary;
                                                font-size: 11px;
                                            }
                                        }

                                        DangerButton {
                                            width: 175px;
                                            text: "Disinstalla AddOn";
                                            icon: "🗑️";
                                            custom-height: 36px;
                                            clicked => { root.start-uninstall(); }
                                        }
                                    }
                                }
                            }

                            // Card 3: Crediti e Info Progetto (Height: 68px)
                            Rectangle {
                                height: 68px;
                                border-radius: Theme.radius-md;
                                background: Theme.bg-panel;
                                border-width: 1px;
                                border-color: Theme.border-subtle;

                                HorizontalLayout {
                                    padding-left: 16px;
                                    padding-right: 16px;
                                    alignment: space-between;

                                    VerticalLayout {
                                        spacing: 3px;
                                        alignment: center;

                                        Text {
                                            text: "VivaVoce Voiceover Project — Progetto No-Profit della Community";
                                            color: Theme.gold-light;
                                            font-size: 12px;
                                            font-weight: 700;
                                        }

                                        Text {
                                            text: "Launcher nativo Rust sviluppato con Slint GUI. Licenza MIT / Open Source.";
                                            color: Theme.text-muted;
                                            font-size: 11px;
                                        }
                                    }

                                    SecondaryButton {
                                        width: 175px;
                                        text: "GitHub Repository";
                                        icon: "⭐";
                                        custom-height: 34px;
                                        clicked => { root.open-url("https://github.com/VivaVoceProject/VivaVoce"); }
                                    }
                                }
                            }
                        }
                    }
                }
            }
        }
    }
}
