// VivaVoce Launcher - World of Warcraft Theme & Design Tokens
// Design Rules: Quiet dark slate surfaces, authentic Warcraft warm brass accent,
// unified 4px-grid spacing scale, standard corner radii, WCAG compliant contrast.

export global Theme {
    // === BACKGROUND PALETTE ===
    out property <color> bg-main: #0c0f15;
    out property <color> bg-sidebar: #090c12;
    out property <color> bg-panel: #11151f;
    out property <color> bg-card: #0e121a;
    out property <color> bg-card-hover: #141a26;
    out property <color> bg-card-selected: #182030;
    out property <color> bg-inset: #080a10;
    out property <color> bg-input: #090c13;

    // === WOW RUNIC & GOLD ACCENTS ===
    out property <color> gold-primary: #c89b3c;
    out property <color> gold-light: #e5c07b;
    out property <color> gold-bright: #ffd875;
    out property <color> gold-dark: #785a28;
    out property <color> gold-muted: #9e7a33;

    // === GRADIENTS / BRUSHES (CALM & DARK - NO NEON/AI GRADIENTS) ===
    out property <brush> main-window-gradient: @linear-gradient(180deg, #10141e 0%, #080a0f 100%);
    out property <brush> panel-gradient: @linear-gradient(180deg, #121622 0%, #0d1018 100%);
    out property <brush> card-gradient: @linear-gradient(180deg, #10141e 0%, #0a0d14 100%);
    out property <brush> progress-fill-gradient: @linear-gradient(90deg, #b38628 0%, #c89b3c 100%);

    // === BUTTON COLORS (SOLID FILLS - NO AI GRADIENTS) ===
    out property <color> btn-primary-bg: #c89b3c;
    out property <color> btn-primary-hover: #d8aa47;
    out property <color> btn-primary-pressed: #b38628;
    out property <color> btn-primary-text: #141008;

    out property <color> btn-secondary-bg: #131722;
    out property <color> btn-secondary-hover: #1c2233;
    out property <color> btn-secondary-pressed: #0d1018;
    out property <color> btn-secondary-border: #232c3d;
    out property <color> btn-secondary-border-hover: #35425c;

    out property <color> btn-danger-bg: #1c0e12;
    out property <color> btn-danger-hover: #291419;
    out property <color> btn-danger-pressed: #150a0d;
    out property <color> btn-danger-border: #ef444433;
    out property <color> btn-danger-border-hover: #ef444466;
    out property <color> btn-danger-text: #f87171;

    // === PROGRESS FILL ===
    out property <color> progress-fill: #c89b3c;
    out property <color> progress-track: #090c13;

    // === BORDERS & SEPARATORS (Hairlines at subtle opacity) ===
    out property <color> border-subtle: #19202c;
    out property <color> border-normal: #232c3d;
    out property <color> border-bright: #323e54;
    out property <color> border-gold-subtle: #c89b3c33;
    out property <color> border-gold-normal: #c89b3c80;

    // === TYPOGRAPHY (WoW Parchment & Slate) ===
    out property <color> text-primary: #f3eee3;      // Warm parchment white
    out property <color> text-secondary: #949db0;    // Cool slate gray
    out property <color> text-muted: #565d70;        // Subdued placeholder
    out property <color> text-gold: #e5c07b;         // WoW quest text gold
    out property <color> text-dark: #141008;         // Dark charcoal for gold button text

    // === STATUS INDICATORS ===
    out property <color> status-success: #34d399;
    out property <color> status-success-bg: #10b98115;
    out property <color> status-success-border: #10b98133;

    out property <color> status-warning: #fbbf24;
    out property <color> status-warning-bg: #f59e0b15;
    out property <color> status-warning-border: #f59e0b33;

    out property <color> status-danger: #f87171;
    out property <color> status-danger-bg: #ef444415;
    out property <color> status-danger-border: #ef444433;

    out property <color> status-info: #38bdf8;
    out property <color> status-info-bg: #38bdf815;
    out property <color> status-info-border: #38bdf833;

    // === RADII SCALE ===
    out property <length> radius-xs: 4px;
    out property <length> radius-sm: 6px;
    out property <length> radius-md: 8px;
    out property <length> radius-lg: 12px;
    out property <length> radius-pill: 999px;

    // === ANIMATION TIMINGS (Snappy interface speed standards < 200ms) ===
    out property <duration> transition-instant: 80ms;
    out property <duration> transition-fast: 120ms;
    out property <duration> transition-normal: 160ms;
}
